    {
      "id": "filter-project",
      "type": "filter-select",
      "name": "项目",
      "x": 1468,
      "y": 24,
      "width": 160,
      "height": 58,
      "zIndex": 50,
      "locked": false,
      "visible": true,
      "config": {
        "label": "项目",
        "variableKey": "projectName",
        "placeholder": "全部",
        "labelColor": "#ffffff",
        "inputBackground": "rgba(88, 180, 255, 0.20)",
        "inputBorderColor": "rgba(39, 216, 255, 0.18)",
        "inputTextColor": "#ffffff",
        "optionSourceMode": "data",
        "dataOptionLabelField": "label",
        "dataOptionValueField": "value",
        "dataOptionMax": 500,
        "optionBackground": "#0b2652",
        "optionTextColor": "#ffffff",
        "_sourceColumns": [
          {
            "name": "label",
            "displayName": "label",
            "baseType": "type/Text"
          },
          {
            "name": "value",
            "displayName": "value",
            "baseType": "type/Text"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "SELECT DISTINCT project_name::text AS label, project_name::text AS value FROM (SELECT a.*,o.order_code,o.curing_user_name,c.customer_name,p.alias_name AS position_name,CASE o.order_type WHEN 1 THEN '换花' WHEN 2 THEN '加花' WHEN 3 THEN '减花' WHEN 4 THEN '调花' WHEN 6 THEN '坏账' WHEN 7 THEN '售花' WHEN 8 THEN '赠花' WHEN 10 THEN '辅料' WHEN 11 THEN '加盆架' WHEN 12 THEN '减盆架' ELSE '未知' END AS type_name FROM public.prs_v2_ads_lease_detail a JOIN public.prs_v2_dwd_flower_order o ON o.order_id=a.order_id AND o.tenant_id IS NOT DISTINCT FROM a.tenant_id LEFT JOIN public.prs_v2_dwd_customer c ON c.customer_id=a.customer_id AND c.tenant_id IS NOT DISTINCT FROM a.tenant_id LEFT JOIN public.prs_v2_dwd_position p ON p.position_id=a.position_id AND p.tenant_id IS NOT DISTINCT FROM a.tenant_id WHERE a.is_effective AND o.is_effective) options WHERE project_name IS NOT NULL ORDER BY label",
          "queryTimeoutSeconds": 30,
          "maxRows": 500,
          "parameterBindings": []
        },
        "sourceType": "sql"
      }
    },
    {
      "id": "filter-customer",
