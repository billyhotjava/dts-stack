          "query": "SELECT DISTINCT customer_name::text AS label, customer_name::text AS value FROM (SELECT a.*,o.order_code,o.curing_user_name,c.customer_name,p.alias_name AS position_name,CASE o.order_type WHEN 1 THEN '换花' WHEN 2 THEN '加花' WHEN 3 THEN '减花' WHEN 4 THEN '调花' WHEN 6 THEN '坏账' WHEN 7 THEN '售花' WHEN 8 THEN '赠花' WHEN 10 THEN '辅料' WHEN 11 THEN '加盆架' WHEN 12 THEN '减盆架' ELSE '未知' END AS type_name FROM public.prs_v2_ads_lease_detail a JOIN public.prs_v2_dwd_flower_order o ON o.order_id=a.order_id AND o.tenant_id IS NOT DISTINCT FROM a.tenant_id LEFT JOIN public.prs_v2_dwd_customer c ON c.customer_id=a.customer_id AND c.tenant_id IS NOT DISTINCT FROM a.tenant_id LEFT JOIN public.prs_v2_dwd_position p ON p.position_id=a.position_id AND p.tenant_id IS NOT DISTINCT FROM a.tenant_id WHERE a.is_effective AND o.is_effective) options WHERE customer_name IS NOT NULL ORDER BY label",
