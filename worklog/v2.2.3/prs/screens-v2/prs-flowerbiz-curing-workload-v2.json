          {
            "name": "数量缺失记录",
            "displayName": "数量缺失记录",
            "baseType": "type/BigInteger"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "WITH b AS (SELECT a.*,p.project_name FROM public.prs_v2_dwd_curing a LEFT JOIN public.prs_v2_dwd_project p ON a.project_id=p.project_id AND a.tenant_id IS NOT DISTINCT FROM p.tenant_id) SELECT COUNT(DISTINCT (tenant_id,curing_user_id)) FILTER (WHERE curing_user_id IS NOT NULL) AS \"养护人数\", COUNT(*) AS \"养护记录数\", COUNT(DISTINCT (tenant_id,project_id)) FILTER (WHERE project_id IS NOT NULL) AS \"养护项目数\", COUNT(DISTINCT curing_time::date) AS \"养护日期数\", SUM(position_quantity) AS \"摆位巡护次数\", COUNT(*) FILTER (WHERE position_quantity IS NULL) AS \"数量缺失记录\" FROM b WHERE curing_time >= {{dateFrom}}::date AND curing_time < ({{dateTo}}::date + INTERVAL '1 day') [[AND curing_user_name = {{curingUser}}]] [[AND project_name = {{projectName}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
