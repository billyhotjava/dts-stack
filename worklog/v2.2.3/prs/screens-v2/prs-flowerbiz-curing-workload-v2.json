        "inputBorderColor": "rgba(39, 216, 255, 0.18)",
        "inputTextColor": "#ffffff",
        "optionSourceMode": "data",
        "dataOptionLabelField": "label",
        "dataOptionValueField": "value",
        "dataOptionMax": 500,
        "optionBackground": "#0b2652",
        "optionTextColor": "#ffffff",
        "_sourceColumns": [
          {
            "name": "label",
            "displayName": "label",
            "baseType": "type/Text"
          },
          {
            "name": "value",
            "displayName": "value",
            "baseType": "type/Text"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "SELECT DISTINCT curing_user_name::text AS label, curing_user_name::text AS value FROM (SELECT a.*,p.project_name FROM public.prs_v2_dwd_curing a LEFT JOIN public.prs_v2_dwd_project p ON a.project_id=p.project_id AND a.tenant_id IS NOT DISTINCT FROM p.tenant_id) options WHERE curing_user_name IS NOT NULL ORDER BY label",
          "queryTimeoutSeconds": 30,
          "maxRows": 500,
          "parameterBindings": []
        },
        "sourceType": "sql"
      }
    },
