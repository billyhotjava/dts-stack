{
  "schemaVersion": "1.0",
  "id": "prs-v2-change-board",
  "name": "花卉租赁变更与租期调整 V2.2.3",
  "description": "适配 DTS v2.2.3；内部。依据花卉 V2 模型及已登记 ODS 日志；空金额保留为空，不将未知值视为零。",
  "classification": "INTERNAL",
  "width": 1920,
  "height": 1080,
  "autoHeight": false,
  "backgroundColor": "#0b2f5f",
  "theme": "dark-command",
  "globalVariables": [
    {
      "key": "dateFrom",
      "label": "开始日期",
      "type": "date",
      "defaultValue": "2022-01-01"
    },
    {
      "key": "dateTo",
      "label": "结束日期",
      "type": "date",
      "defaultValue": "2026-12-31"
    },
    {
      "key": "projectName",
      "label": "项目",
      "type": "string",
      "defaultValue": ""
    },
    {
      "key": "changeType",
      "label": "变更类型",
      "type": "string",
      "defaultValue": ""
    }
  ],
  "components": [
    {
      "id": "bg-base",
