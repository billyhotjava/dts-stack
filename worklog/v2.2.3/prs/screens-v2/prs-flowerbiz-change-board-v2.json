      "name": "PRS · Flowerbiz Command Center",
      "x": 24,
      "y": 26,
      "width": 420,
      "height": 20,
      "zIndex": 60,
      "locked": false,
      "visible": true,
      "config": {
        "text": "PRS · 花卉租赁业务分析",
        "fontSize": 12,
        "fontWeight": "500",
        "color": "#d9eeff",
        "textAlign": "flex-start"
      }
    },
    {
      "id": "screen-title",
      "type": "title",
      "name": "PRS 变更与租期调整看板",
      "x": 560,
      "y": 18,
      "width": 800,
      "height": 44,
      "zIndex": 60,
      "locked": false,
      "visible": true,
      "config": {
        "text": "PRS 变更与租期调整看板",
        "fontSize": 30,
