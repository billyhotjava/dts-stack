        "labelColor": "#ffffff",
        "inputBackground": "rgba(88, 180, 255, 0.20)",
        "inputBorderColor": "rgba(39, 216, 255, 0.18)",
        "inputTextColor": "#ffffff",
        "optionSourceMode": "data",
        "dataOptionLabelField": "label",
        "dataOptionValueField": "value",
        "dataOptionMax": 500,
        "optionBackground": "#0b2652",
        "optionTextColor": "#ffffff",
        "_sourceColumns": [
          {
            "name": "label",
            "displayName": "label",
            "baseType": "type/Text"
          },
          {
            "name": "value",
            "displayName": "value",
            "baseType": "type/Text"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "SELECT DISTINCT type_name::text AS label, type_name::text AS value FROM (SELECT a.*,o.order_code,c.customer_name,CASE a.change_type WHEN 1 THEN '销售金额变更' WHEN 2 THEN '库房物品变更' WHEN 3 THEN '成本变更' WHEN 4 THEN '起租减租变更' ELSE '未知' END AS type_name,(a.after_total_amount-a.before_total_amount) AS amount_delta,EXTRACT(EPOCH FROM (a.confirmed_time-a.apply_time))/86400 AS confirm_days FROM public.prs_v2_ads_change_detail a LEFT JOIN public.prs_v2_dwd_flower_order o ON a.order_id=o.order_id AND a.tenant_id IS NOT DISTINCT FROM o.tenant_id LEFT JOIN public.prs_v2_dwd_customer c ON c.customer_id=a.customer_id AND c.tenant_id IS NOT DISTINCT FROM a.tenant_id WHERE a.change_status IN (1,2)) options WHERE type_name IS NOT NULL ORDER BY label",
          "queryTimeoutSeconds": 30,
          "maxRows": 500,
          "parameterBindings": []
        },
        "sourceType": "sql"
      }
    },
    {
      "id": "kpi-1",
      "type": "number-card",
      "name": "变更单数",
      "x": 44,
      "y": 112,
      "width": 280,
      "height": 104,
      "zIndex": 25,
      "locked": false,
      "visible": true,
      "config": {
        "title": "变更单数",
        "value": null,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 16,
        "valueFontSize": 34,
        "titleColor": "#e2ffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "valueField": "变更单数",
        "_sourceColumns": [
          {
            "name": "变更单数",
            "displayName": "变更单数",
            "baseType": "type/BigInteger"
          },
          {
            "name": "物品变更",
            "displayName": "物品变更",
            "baseType": "type/BigInteger"
          },
          {
            "name": "金额变更",
            "displayName": "金额变更",
            "baseType": "type/BigInteger"
          },
          {
            "name": "成本变更",
            "displayName": "成本变更",
            "baseType": "type/BigInteger"
          },
          {
            "name": "已确认金额差额",
            "displayName": "已确认金额差额",
            "baseType": "type/Decimal"
          },
          {
            "name": "平均确认天数",
            "displayName": "平均确认天数",
            "baseType": "type/Decimal"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "WITH b AS (SELECT a.*,o.order_code,c.customer_name,CASE a.change_type WHEN 1 THEN '销售金额变更' WHEN 2 THEN '库房物品变更' WHEN 3 THEN '成本变更' WHEN 4 THEN '起租减租变更' ELSE '未知' END AS type_name,(a.after_total_amount-a.before_total_amount) AS amount_delta,EXTRACT(EPOCH FROM (a.confirmed_time-a.apply_time))/86400 AS confirm_days FROM public.prs_v2_ads_change_detail a LEFT JOIN public.prs_v2_dwd_flower_order o ON a.order_id=o.order_id AND a.tenant_id IS NOT DISTINCT FROM o.tenant_id LEFT JOIN public.prs_v2_dwd_customer c ON c.customer_id=a.customer_id AND c.tenant_id IS NOT DISTINCT FROM a.tenant_id WHERE a.change_status IN (1,2)) SELECT COUNT(*) AS \"变更单数\", COUNT(*) FILTER (WHERE change_type=2) AS \"物品变更\", COUNT(*) FILTER (WHERE change_type=1) AS \"金额变更\", COUNT(*) FILTER (WHERE change_type=3) AS \"成本变更\", ROUND(SUM(CASE WHEN change_status=2 AND change_type IN (1,3) THEN amount_delta END)::numeric,2) AS \"已确认金额差额\", ROUND(AVG(confirm_days) FILTER (WHERE confirm_days>=0)::numeric,2) AS \"平均确认天数\" FROM b WHERE apply_time >= {{dateFrom}}::date AND apply_time < ({{dateTo}}::date + INTERVAL '1 day') [[AND project_name = {{projectName}}]] [[AND type_name = {{changeType}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "projectName",
              "variableKey": "projectName"
            },
            {
              "name": "changeType",
              "variableKey": "changeType"
            }
          ]
        },
        "sourceType": "sql"
      }
    },
