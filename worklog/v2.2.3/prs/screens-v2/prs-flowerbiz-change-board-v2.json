        "textAlign": "center"
      },
      "actions": [
        {
          "type": "jump-url",
          "label": "返回经营总览",
          "panelTitle": "{{name}}",
          "panelBodyTemplate": "{{name}}",
          "jumpUrlTemplate": "/bi/screens/15/preview?mode=published&var_dateFrom={{runtime.dateFrom}}&var_dateTo={{runtime.dateTo}}&var_projectName={{runtime.projectName}}",
          "jumpOpenMode": "self"
        }
      ]
    },
    {
      "id": "filter-date-range",
      "type": "filter-date-range",
      "name": "统计周期",
      "x": 1130,
      "y": 24,
      "width": 320,
      "height": 58,
      "zIndex": 50,
      "locked": false,
      "visible": true,
      "config": {
        "label": "统计周期",
        "startKey": "dateFrom",
        "endKey": "dateTo",
        "labelColor": "#ffffff",
        "inputBackground": "rgba(88, 180, 255, 0.20)",
        "inputBorderColor": "rgba(39, 216, 255, 0.18)",
        "inputTextColor": "#ffffff",
        "startVariableKey": "dateFrom",
        "endVariableKey": "dateTo"
      }
    },
    {
      "id": "filter-project",
      "type": "filter-select",
      "name": "项目",
      "x": 1468,
      "y": 24,
      "width": 160,
      "height": 58,
      "zIndex": 50,
      "locked": false,
      "visible": true,
      "config": {
        "label": "项目",
        "variableKey": "projectName",
        "placeholder": "全部",
        "labelColor": "#ffffff",
        "inputBackground": "rgba(88, 180, 255, 0.20)",
        "inputBorderColor": "rgba(39, 216, 255, 0.18)",
        "inputTextColor": "#ffffff",
        "optionSourceMode": "data",
        "dataOptionLabelField": "label",
        "dataOptionValueField": "value",
        "dataOptionMax": 500,
        "optionBackground": "#0b2652",
        "optionTextColor": "#ffffff",
        "_sourceColumns": [
          {
            "name": "label",
            "displayName": "label",
            "baseType": "type/Text"
          },
          {
            "name": "value",
            "displayName": "value",
            "baseType": "type/Text"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "SELECT DISTINCT project_name::text AS label, project_name::text AS value FROM (SELECT a.*,o.order_code,c.customer_name,CASE a.change_type WHEN 1 THEN '销售金额变更' WHEN 2 THEN '库房物品变更' WHEN 3 THEN '成本变更' WHEN 4 THEN '起租减租变更' ELSE '未知' END AS type_name,(a.after_total_amount-a.before_total_amount) AS amount_delta,EXTRACT(EPOCH FROM (a.confirmed_time-a.apply_time))/86400 AS confirm_days FROM public.prs_v2_ads_change_detail a LEFT JOIN public.prs_v2_dwd_flower_order o ON a.order_id=o.order_id AND a.tenant_id IS NOT DISTINCT FROM o.tenant_id LEFT JOIN public.prs_v2_dwd_customer c ON c.customer_id=a.customer_id AND c.tenant_id IS NOT DISTINCT FROM a.tenant_id WHERE a.change_status IN (1,2)) options WHERE project_name IS NOT NULL ORDER BY label",
          "queryTimeoutSeconds": 30,
          "maxRows": 500,
          "parameterBindings": []
        },
        "sourceType": "sql"
      }
    },
    {
      "id": "filter-change",
      "type": "filter-select",
      "name": "变更类型",
      "x": 1640,
      "y": 24,
      "width": 140,
      "height": 58,
      "zIndex": 50,
      "locked": false,
      "visible": true,
      "config": {
        "label": "变更类型",
