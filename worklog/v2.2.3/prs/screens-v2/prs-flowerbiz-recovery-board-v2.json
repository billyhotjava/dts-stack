{
  "schemaVersion": "1.0",
  "id": "prs-v2-recovery-board",
  "name": "花卉租赁回收撤摆与去向 V2.2.3",
  "description": "适配 DTS v2.2.3；内部。依据花卉 V2 模型及已登记 ODS 日志；空金额保留为空，不将未知值视为零。",
  "classification": "INTERNAL",
  "width": 1920,
  "height": 1080,
  "autoHeight": false,
  "backgroundColor": "#0b2f5f",
  "theme": "dark-command",
  "globalVariables": [
    {
      "key": "dateFrom",
      "label": "开始日期",
      "type": "date",
      "defaultValue": "2022-01-01"
    },
    {
      "key": "dateTo",
      "label": "结束日期",
      "type": "date",
      "defaultValue": "2026-12-31"
    },
    {
      "key": "projectName",
      "label": "项目",
      "type": "string",
      "defaultValue": ""
    },
    {
      "key": "recoveryType",
      "label": "回收类型",
      "type": "string",
      "defaultValue": ""
    }
  ],
  "components": [
    {
      "id": "bg-base",
      "type": "shape",
      "name": "背景底色",
      "x": 0,
      "y": 0,
      "width": 1920,
      "height": 1080,
      "zIndex": -20,
      "locked": true,
      "visible": true,
      "config": {
        "shapeType": "rect",
        "fillColor": "#0b2f5f",
        "borderColor": "#0b2f5f",
        "borderWidth": 0,
        "radius": 0
      }
    },
    {
      "id": "bg-grid",
      "type": "richtext",
      "name": "背景网格",
      "x": 0,
      "y": 0,
      "width": 1920,
      "height": 1080,
      "zIndex": -19,
      "locked": true,
      "visible": true,
      "config": {
        "content": "<div style=\"width:100%;height:100%;position:relative;overflow:hidden;background:linear-gradient(180deg,rgba(12,68,126,.96),rgba(4,22,54,.98));\"><div style=\"position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.10) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.10) 1px, transparent 1px);background-size:28px 28px;opacity:.42\"></div><div style=\"position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(39,216,255,.22),transparent 58%);\"></div></div>",
        "padding": 0,
        "overflow": "hidden"
      }
    },
    {
      "id": "header-clock",
      "type": "datetime",
      "name": "当前时间",
      "x": 1710,
      "y": 24,
      "width": 180,
      "height": 22,
      "zIndex": 60,
      "locked": false,
      "visible": true,
      "config": {
        "format": "YYYY-MM-DD HH:mm:ss",
        "fontSize": 12,
        "color": "#e2ffff"
      }
    },
    {
      "id": "domain-label",
      "type": "title",
      "name": "PRS · Flowerbiz Command Center",
      "x": 24,
      "y": 26,
      "width": 420,
      "height": 20,
      "zIndex": 60,
      "locked": false,
      "visible": true,
      "config": {
        "text": "PRS · 花卉租赁业务分析",
        "fontSize": 12,
        "fontWeight": "500",
        "color": "#d9eeff",
        "textAlign": "flex-start"
      }
    },
    {
      "id": "screen-title",
      "type": "title",
      "name": "PRS 回收撤摆与去向看板",
      "x": 560,
      "y": 18,
      "width": 800,
      "height": 44,
      "zIndex": 60,
      "locked": false,
      "visible": true,
      "config": {
        "text": "PRS 回收撤摆与去向看板",
        "fontSize": 30,
        "fontWeight": "800",
        "color": "#ffffff",
        "textAlign": "center"
      },
      "actions": [
        {
          "type": "jump-url",
          "label": "返回经营总览",
          "panelTitle": "{{name}}",
          "panelBodyTemplate": "{{name}}",
          "jumpUrlTemplate": "/bi/screens/15/preview?mode=published&var_dateFrom={{runtime.dateFrom}}&var_dateTo={{runtime.dateTo}}&var_projectName={{runtime.projectName}}",
          "jumpOpenMode": "self"
        }
      ]
    },
    {
      "id": "filter-date-range",
      "type": "filter-date-range",
      "name": "统计周期",
      "x": 1130,
      "y": 24,
      "width": 320,
      "height": 58,
      "zIndex": 50,
      "locked": false,
      "visible": true,
      "config": {
        "label": "统计周期",
        "startKey": "dateFrom",
        "endKey": "dateTo",
        "labelColor": "#ffffff",
        "inputBackground": "rgba(88, 180, 255, 0.20)",
        "inputBorderColor": "rgba(39, 216, 255, 0.18)",
        "inputTextColor": "#ffffff",
        "startVariableKey": "dateFrom",
        "endVariableKey": "dateTo"
      }
    },
    {
      "id": "filter-project",
      "type": "filter-select",
      "name": "项目",
      "x": 1468,
      "y": 24,
      "width": 160,
      "height": 58,
      "zIndex": 50,
      "locked": false,
      "visible": true,
      "config": {
        "label": "项目",
        "variableKey": "projectName",
        "placeholder": "全部",
        "labelColor": "#ffffff",
        "inputBackground": "rgba(88, 180, 255, 0.20)",
        "inputBorderColor": "rgba(39, 216, 255, 0.18)",
        "inputTextColor": "#ffffff",
        "optionSourceMode": "data",
        "dataOptionLabelField": "label",
        "dataOptionValueField": "value",
        "dataOptionMax": 500,
        "optionBackground": "#0b2652",
        "optionTextColor": "#ffffff",
        "_sourceColumns": [
          {
            "name": "label",
            "displayName": "label",
            "baseType": "type/Text"
          },
          {
            "name": "value",
            "displayName": "value",
            "baseType": "type/Text"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "SELECT DISTINCT project_name::text AS label, project_name::text AS value FROM (SELECT a.*,o.order_code,c.customer_name,CASE a.recovery_type WHEN 1 THEN '报损' WHEN 2 THEN '回购' WHEN 3 THEN '留用' ELSE '未知' END AS type_name,COALESCE(a.recovery_time,a.plan_recovery_time) AS event_time FROM public.prs_v2_ads_recovery_detail a LEFT JOIN public.prs_v2_dwd_flower_order o ON a.order_id=o.order_id AND a.tenant_id IS NOT DISTINCT FROM o.tenant_id LEFT JOIN public.prs_v2_dwd_customer c ON c.customer_id=a.customer_id AND c.tenant_id IS NOT DISTINCT FROM a.tenant_id) options WHERE project_name IS NOT NULL ORDER BY label",
          "queryTimeoutSeconds": 30,
          "maxRows": 500,
          "parameterBindings": []
        },
        "sourceType": "sql"
      }
    },
    {
      "id": "filter-recovery",
      "type": "filter-select",
      "name": "回收类型",
      "x": 1640,
      "y": 24,
      "width": 140,
      "height": 58,
      "zIndex": 50,
      "locked": false,
      "visible": true,
      "config": {
        "label": "回收类型",
        "variableKey": "recoveryType",
        "placeholder": "全部",
        "labelColor": "#ffffff",
        "inputBackground": "rgba(88, 180, 255, 0.20)",
        "inputBorderColor": "rgba(39, 216, 255, 0.18)",
        "inputTextColor": "#ffffff",
        "optionSourceMode": "data",
        "dataOptionLabelField": "label",
        "dataOptionValueField": "value",
        "dataOptionMax": 500,
        "optionBackground": "#0b2652",
        "optionTextColor": "#ffffff",
        "_sourceColumns": [
          {
            "name": "label",
            "displayName": "label",
            "baseType": "type/Text"
          },
          {
            "name": "value",
            "displayName": "value",
            "baseType": "type/Text"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "SELECT DISTINCT type_name::text AS label, type_name::text AS value FROM (SELECT a.*,o.order_code,c.customer_name,CASE a.recovery_type WHEN 1 THEN '报损' WHEN 2 THEN '回购' WHEN 3 THEN '留用' ELSE '未知' END AS type_name,COALESCE(a.recovery_time,a.plan_recovery_time) AS event_time FROM public.prs_v2_ads_recovery_detail a LEFT JOIN public.prs_v2_dwd_flower_order o ON a.order_id=o.order_id AND a.tenant_id IS NOT DISTINCT FROM o.tenant_id LEFT JOIN public.prs_v2_dwd_customer c ON c.customer_id=a.customer_id AND c.tenant_id IS NOT DISTINCT FROM a.tenant_id) options WHERE type_name IS NOT NULL ORDER BY label",
          "queryTimeoutSeconds": 30,
          "maxRows": 500,
          "parameterBindings": []
        },
        "sourceType": "sql"
      }
    },
    {
      "id": "kpi-1",
      "type": "number-card",
      "name": "回收明细数",
      "x": 44,
      "y": 112,
      "width": 280,
      "height": 104,
      "zIndex": 25,
      "locked": false,
      "visible": true,
      "config": {
        "title": "回收明细数",
        "value": null,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 16,
        "valueFontSize": 34,
        "titleColor": "#e2ffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "valueField": "回收明细数",
        "_sourceColumns": [
          {
            "name": "回收明细数",
            "displayName": "回收明细数",
            "baseType": "type/BigInteger"
          },
          {
            "name": "实际回收数量",
            "displayName": "实际回收数量",
            "baseType": "type/BigInteger"
          },
          {
            "name": "计划回收数量",
            "displayName": "计划回收数量",
            "baseType": "type/BigInteger"
          },
          {
            "name": "报损条数",
            "displayName": "报损条数",
            "baseType": "type/BigInteger"
