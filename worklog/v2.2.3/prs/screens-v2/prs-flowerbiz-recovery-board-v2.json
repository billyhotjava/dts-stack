            "displayName": "回购条数",
            "baseType": "type/BigInteger"
          },
          {
            "name": "留用条数",
            "displayName": "留用条数",
            "baseType": "type/BigInteger"
          }
        ]
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": 1,
          "query": "WITH b AS (SELECT a.*,o.order_code,c.customer_name,CASE a.recovery_type WHEN 1 THEN '报损' WHEN 2 THEN '回购' WHEN 3 THEN '留用' ELSE '未知' END AS type_name,COALESCE(a.recovery_time,a.plan_recovery_time) AS event_time FROM public.prs_v2_ads_recovery_detail a LEFT JOIN public.prs_v2_dwd_flower_order o ON a.order_id=o.order_id AND a.tenant_id IS NOT DISTINCT FROM o.tenant_id LEFT JOIN public.prs_v2_dwd_customer c ON c.customer_id=a.customer_id AND c.tenant_id IS NOT DISTINCT FROM a.tenant_id) SELECT COUNT(*) AS \"回收明细数\", SUM(actual_quantity) AS \"实际回收数量\", SUM(planned_quantity) AS \"计划回收数量\", COUNT(*) FILTER (WHERE recovery_type=1) AS \"报损条数\", COUNT(*) FILTER (WHERE recovery_type=2) AS \"回购条数\", COUNT(*) FILTER (WHERE recovery_type=3) AS \"留用条数\" FROM b WHERE event_time >= {{dateFrom}}::date AND event_time < ({{dateTo}}::date + INTERVAL '1 day') [[AND project_name = {{projectName}}]] [[AND type_name = {{recoveryType}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "projectName",
              "variableKey": "projectName"
            },
            {
              "name": "recoveryType",
              "variableKey": "recoveryType"
            }
          ]
        },
        "sourceType": "sql"
      }
    },
