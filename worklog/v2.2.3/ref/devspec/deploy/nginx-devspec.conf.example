# DTS devspec 静态文档站点（新增；未修改任何既有 server 配置）
# 内容目录：/var/www/dts-ref/{devspec,intro}
# 访问：https://dev.yuzhicloud.com/devspec/login.html
# 备用：http://39.106.43.56:8099/devspec/login.html（需安全组放行 TCP 8099）
# 证书：certbot (Let's Encrypt) dev.yuzhicloud.com，自动续期

server {
    listen 80;
    listen [::]:80;
    server_name dev.yuzhicloud.com;

    location /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name dev.yuzhicloud.com;

    ssl_certificate /etc/letsencrypt/live/dev.yuzhicloud.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.yuzhicloud.com/privkey.pem;

    auth_basic "DTS devspec";
    auth_basic_user_file /etc/nginx/.htpasswd-devspec;

    root /var/www/dts-ref;
    index devspec/login.html;

    location = / { return 302 /devspec/login.html; }
    location /devspec/ { try_files $uri $uri/ =404; }
    location /intro/   { try_files $uri $uri/ =404; }
}

server {
    listen 8099;
    listen [::]:8099;
    server_name _;

    auth_basic "DTS devspec";
    auth_basic_user_file /etc/nginx/.htpasswd-devspec;

    root /var/www/dts-ref;
    index devspec/login.html;

    location = / { return 302 /devspec/login.html; }
    location /devspec/ { try_files $uri $uri/ =404; }
    location /intro/   { try_files $uri $uri/ =404; }
}
