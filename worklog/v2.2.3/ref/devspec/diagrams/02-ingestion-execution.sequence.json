  "cards": [
    {
      "dot": "cyan",
      "title": "执行约定",
      "items": [
        "阶段一事务内建 preparing 记录，阶段二在 afterCommit 新事务",
        "Idempotency-Key 生成 idem-task-{taskId}-{sha256}",
        "目标表由 Provisioner 供给，模型绑定走 ModelTargetGuard"
      ]
    },
    {
      "dot": "amber",
      "title": "失败与恢复",
      "items": [
        "失败分类后写 failureCategory/failureAdvice 并安排退避重试",
        "取消先置 cancel_requested 再停 Airflow",
        "Airflow 关闭时只记录 running，不提交作业"
      ]
    }
  ]
