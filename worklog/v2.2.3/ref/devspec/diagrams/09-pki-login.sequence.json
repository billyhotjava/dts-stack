    { "id": "challenge", "type": "backend", "label": "挑战服务", "sublabel": "Challenge" },
    { "id": "verify", "type": "backend", "label": "验签服务", "sublabel": "Verification" },
    { "id": "ticket", "type": "backend", "label": "会话票据", "sublabel": "Ticket" },
