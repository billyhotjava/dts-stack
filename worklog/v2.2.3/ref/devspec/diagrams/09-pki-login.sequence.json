  "cards": [
    {
      "dot": "cyan",
      "title": "安全约定",
      "items": [
        "挑战一次性消费，peek 只读",
        "PKCS7 验签可带证书或走外部 PKI 服务",
        "门户会话绑定短时签名票据，不信任请求体用户名"
      ]
    },
    {
      "dot": "amber",
      "title": "已确认边界",
      "items": [
        "PKI 未启用时管理侧返回 404 提示",
        "证书吊销/OCSP 是否外部承担未验证",
        "/api/mdm/** 放行 + 网关令牌校验（见文档）"
      ]
    }
