  "segments": [
    { "from": 246, "to": 510, "label": "挑战、验签与会话" }
  ],
  "messages": [
    { "id": "m-chal", "from": "client", "to": "platform", "y": 168, "label": "GET /api/keycloak/auth/pki-challenge" },
    { "id": "m-proxy", "from": "platform", "to": "admin", "y": 196, "label": "AdminAuthGateway.pkiChallenge" },
    { "id": "m-issue", "from": "admin", "to": "challenge", "y": 224, "label": "issue(aud, ip, ua, ttl)" },
    { "id": "m-chal-back", "from": "challenge", "to": "admin", "y": 256, "label": "Challenge（nonce/ttl）", "variant": "return" },
    { "id": "m-chal-ret", "from": "admin", "to": "platform", "y": 284, "label": "challenge 返回", "variant": "return" },
    { "id": "m-login", "from": "client", "to": "platform", "y": 312, "label": "POST /pki-login（origin/p7 签名）", "variant": "security" },
    { "id": "m-login-proxy", "from": "platform", "to": "admin", "y": 340, "label": "AdminAuthGateway.pkiLogin" },
    { "id": "m-verify", "from": "admin", "to": "verify", "y": 368, "label": "verifyPkcs7(origin, p7, cert)" },
    { "id": "m-verify-back", "from": "verify", "to": "admin", "y": 396, "label": "VerifyResult（identity）", "variant": "return" },
    { "id": "m-ticket", "from": "admin", "to": "platform", "y": 424, "label": "username + 签名票据", "variant": "return" },
    { "id": "m-session", "from": "platform", "to": "session", "y": 452, "label": "resolve(ticket) 建立门户会话" },
    { "id": "m-ok", "from": "platform", "to": "client", "y": 480, "label": "登录成功", "variant": "return" }
