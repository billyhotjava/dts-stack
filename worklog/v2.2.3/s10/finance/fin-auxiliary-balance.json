        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    subject_code || ' ' || subject_name AS label,\n    SUM(balance::NUMERIC) AS value\nFROM ods_finance_aux_balance\nWHERE 1=1\n  AND (:dept_filter IS NULL OR dept_name = :dept_filter)\n  AND (:search_text IS NULL OR subject_name LIKE '%' || :search_text || '%' OR subject_code LIKE '%' || :search_text || '%' OR contract_name LIKE '%' || :search_text || '%')\nGROUP BY subject_code, subject_name\nORDER BY value DESC\nLIMIT 10",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
