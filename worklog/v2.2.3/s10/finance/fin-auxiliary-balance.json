    {
      "id": "fin-aux-kpi-total-balance",
      "type": "number-card",
      "name": "余额合计",
      "x": 58,
      "y": 120,
      "width": 430,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "余额合计",
        "value": 0,
        "suffix": " 万",
        "precision": 2,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#475569",
        "valueColor": "#0f172a",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    SUM(balance::NUMERIC) AS total_balance,\n    COUNT(DISTINCT subject_code) AS subject_count,\n    COUNT(DISTINCT CASE WHEN contract_name IS NOT NULL AND contract_name != '\u2014' THEN contract_name END) AS contract_count,\n    COUNT(DISTINCT dept_name) AS dept_count\nFROM ods_finance_aux_balance\nWHERE 1=1\n  AND (:dept_filter IS NULL OR dept_name = :dept_filter)\n  AND (:search_text IS NULL OR subject_name LIKE '%' || :search_text || '%' OR subject_code LIKE '%' || :search_text || '%' OR contract_name LIKE '%' || :search_text || '%')",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {"name": "dept_filter", "variableKey": "filterDept"},
            {"name": "search_text", "variableKey": "searchText"}
          ]
        }
      }
    },
