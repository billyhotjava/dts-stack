        "headerBackground": "#dbe9f6",
        "bodyColor": "#334155",
        "bodyBackground": "#ffffff",
        "oddRowBackground": "#ffffff",
        "evenRowBackground": "#f5f9fd",
        "borderColor": "rgba(148, 163, 184, 0.24)",
        "enableSort": true,
