        "orientation": "horizontal"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    CASE\n        WHEN subject_code LIKE '1122%' THEN '其他应收-借款'\n        WHEN subject_code LIKE '2211%' THEN '应付职工薪酬'\n        ELSE '其他'\n    END AS label,\n    SUM(ABS(balance)) AS value\nFROM aux_balance_personal\nWHERE 1=1\n  AND (:employee_filter IS NULL OR employee_name = :employee_filter)\n  AND (:dept_filter IS NULL OR employee_dept = :dept_filter)\n  AND (:search_text IS NULL\n       OR subject_name LIKE '%' || :search_text || '%'\n       OR subject_code LIKE '%' || :search_text || '%'\n       OR employee_name LIKE '%' || :search_text || '%')\nGROUP BY label\nORDER BY value DESC",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            { "name": "employee_filter", "variableKey": "filterEmployee" },
            { "name": "dept_filter", "variableKey": "filterDept" },
            { "name": "search_text", "variableKey": "searchText" }
