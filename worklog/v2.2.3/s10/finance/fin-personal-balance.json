    {
      "id": "fin-pb-kpi-net",
      "type": "number-card",
      "name": "净余额",
      "x": 58,
      "y": 120,
      "width": 340,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "净余额",
        "value": 0,
        "suffix": " 万",
        "precision": 2,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#475569",
        "valueColor": "#0f172a",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    SUM(balance) / 10000.0 AS net_balance\nFROM aux_balance_personal\nWHERE 1=1\n  AND (:employee_filter IS NULL OR employee_name = :employee_filter)\n  AND (:dept_filter IS NULL OR employee_dept = :dept_filter)\n  AND (:search_text IS NULL\n       OR subject_name LIKE '%' || :search_text || '%'\n       OR subject_code LIKE '%' || :search_text || '%'\n       OR employee_name LIKE '%' || :search_text || '%')",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            { "name": "employee_filter", "variableKey": "filterEmployee" },
            { "name": "dept_filter", "variableKey": "filterDept" },
            { "name": "search_text", "variableKey": "searchText" }
          ]
        }
      }
    },
    {
      "id": "fin-pb-kpi-debit",
      "type": "number-card",
      "name": "借方合计",
      "x": 420,
      "y": 120,
      "width": 340,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "借方合计",
        "value": 0,
        "suffix": " 万",
        "precision": 2,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#475569",
        "valueColor": "#0f172a",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    SUM(CASE WHEN balance > 0 THEN balance ELSE 0 END) / 10000.0 AS debit_total\nFROM aux_balance_personal\nWHERE 1=1\n  AND (:employee_filter IS NULL OR employee_name = :employee_filter)\n  AND (:dept_filter IS NULL OR employee_dept = :dept_filter)\n  AND (:search_text IS NULL\n       OR subject_name LIKE '%' || :search_text || '%'\n       OR subject_code LIKE '%' || :search_text || '%'\n       OR employee_name LIKE '%' || :search_text || '%')",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            { "name": "employee_filter", "variableKey": "filterEmployee" },
            { "name": "dept_filter", "variableKey": "filterDept" },
            { "name": "search_text", "variableKey": "searchText" }
          ]
        }
      }
    },
    {
