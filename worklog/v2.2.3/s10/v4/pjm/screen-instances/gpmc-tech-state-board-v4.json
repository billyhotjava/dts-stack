      "config": {
        "title": "技术状态变更单签署完成率",
        "value": 0,
        "suffix": "%",
        "precision": 2,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#ffffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "metricNote": {
          "code": "pjm_tech_signature_rate",
          "displayName": "技术状态变更单签署完成率",
          "domain": "技术状态",
          "category": "签署率",
          "unit": "%",
          "direction": "UP",
          "definition": "变更单中已完成签署的占比",
          "formula": "已完成签署数 ÷ (已完成签署数 + 未完成签署 I+II+III) × 100%",
          "scope": "全量,截止结束时间",
          "sourceTable": "技术状态信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": {
            "warning": 80.0,
            "critical": 70.0,
            "rule": "<"
          },
          "excelRef": "二次指标 #12 pjm_tech_signature_rate"
        },
        "metricCode": "pjm_tech_signature_rate"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT CASE WHEN SUM(s.total_change_cnt)=0 THEN 0 ELSE ROUND(SUM(s.order_signed_cnt)::numeric/NULLIF(SUM(s.total_change_cnt),0)::numeric*100,2) END AS v FROM biz_dws_tech_state_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no = {{projectNo}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
