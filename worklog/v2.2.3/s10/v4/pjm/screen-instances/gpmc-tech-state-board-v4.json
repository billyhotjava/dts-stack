    {
      "id": "gpmc-tech-kpi-total",
      "type": "number-card",
      "name": "变更单总数",
      "x": 44,
      "y": 126,
      "width": 350,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "技术状态变更单总数",
        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#ffffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "metricNote": {
          "code": "pjm_tech_total_changes",
          "displayName": "技术状态变更单总数",
          "domain": "技术状态",
          "category": "基础",
          "unit": "个",
          "direction": "NEUTRAL",
          "definition": "周期内新增的全部 I/II/III 类技术状态更改单总数",
          "formula": "新增 I 类更改 + 新增 II 类更改 + 新增 III 类更改",
          "scope": "受顶部时间筛选器控制",
          "sourceTable": "技术状态信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": null,
          "excelRef": "原始指标 #49+#50+#51"
        },
        "metricCode": "pjm_tech_total_changes"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COALESCE(SUM(s.total_change_cnt),0) AS v FROM biz_dws_tech_state_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no = {{projectNo}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
