        "metricNote": {
          "code": "pjm_tech_unsigned_total",
          "displayName": "技术状态变更单未完成签署(I, II, III类)",
          "domain": "技术状态",
          "category": "签署",
          "unit": "个",
          "direction": "DOWN",
          "definition": "尚未完成签署的全部技术状态变更单数",
          "formula": "完成签署='否' 的变更单计数 = I 类未签 + II 类未签 + III 类未签",
          "scope": "全量,截止结束时间",
          "sourceTable": "技术状态信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": null,
          "excelRef": "原始指标 #63"
        },
        "metricCode": "pjm_tech_unsigned_total"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COALESCE(SUM(s.order_unsigned_cat_i)+SUM(s.order_unsigned_cat_ii)+SUM(s.order_unsigned_cat_iii),0) AS v FROM biz_dws_tech_state_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no = {{projectNo}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
    {
      "id": "gpmc-tech-kpi-sign-rate",
      "type": "number-card",
      "name": "签署率",
      "x": 784,
      "y": 126,
      "width": 350,
      "height": 118,
      "zIndex": 12,
      "locked": false,
