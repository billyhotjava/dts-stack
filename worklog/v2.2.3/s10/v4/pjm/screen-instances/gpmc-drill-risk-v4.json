      "id": "drill-risk-kpi-1",
      "type": "number-card",
      "name": "风险总数",
      "x": 20,
      "y": 70,
      "width": 456,
      "height": 90,
      "zIndex": 10,
      "locked": false,
      "visible": true,
      "config": {
        "title": "风险总数",
        "value": "89",
        "unit": "",
        "precision": 0,
        "titleColor": "#ffffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "borderRadius": 12,
        "fontSize": 36,
        "metricNote": {
          "code": "pjm_risk_total",
          "displayName": "风险总数",
          "domain": "风险",
          "category": "基础",
          "unit": "个",
          "direction": "DOWN",
          "definition": "周期内提出的风险总数(高+中+低)",
          "formula": "风险提出时间在[开始日期,结束日期]内的风险计数",
          "scope": "受顶部时间筛选器控制",
          "sourceTable": "风险信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": null,
          "excelRef": "(衍生)新增风险计数"
        },
        "metricCode": "pjm_risk_total"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT SUM(total_risk_cnt) AS \"风险总数\", SUM(high_cnt) AS \"高风险\", SUM(mid_cnt) AS \"中风险\", SUM(low_cnt) AS \"低风险\", SUM(released_cnt) AS \"已释放\", SUM(open_cnt) AS \"未释放\" FROM biz_dws_risk_monthly_v2 WHERE period_month >= to_char({{dateFrom}}::date, 'YYYY-MM') AND period_month <= to_char({{dateTo}}::date, 'YYYY-MM') [[AND dept = {{deptId}}]] [[AND project_no = {{projectNo}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
