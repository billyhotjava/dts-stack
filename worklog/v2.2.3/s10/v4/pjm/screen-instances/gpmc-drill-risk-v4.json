    {
      "id": "drill-risk-detail-table",
      "type": "table",
      "name": "风险清单",
      "x": 20,
      "y": 175,
      "width": 1145,
      "height": 420,
      "zIndex": 15,
      "locked": false,
      "visible": true,
      "config": {
        "title": "风险清单",
        "header": [
          "项目编号",
          "风险名称",
          "分系统",
          "责任科室",
          "风险等级",
          "风险类别",
          "风险状态",
          "应对措施",
          "提交日期",
          "释放日期",
          "滞留天数"
        ],
        "data": [],
        "fontSize": 16,
        "headerAlign": "center",
        "headerColor": "#d9eeff",
        "headerBackground": "#0f2a55",
        "bodyColor": "#8cb9df",
        "bodyBackground": "rgba(9, 36, 90, 0.86)",
        "oddRowBackground": "rgba(9, 36, 90, 0.86)",
        "evenRowBackground": "rgba(9, 36, 90, 0.82)",
        "borderColor": "rgba(69, 164, 255, 0.38)",
        "enableSort": true,
        "enablePagination": true,
        "pageSize": 8,
        "freezeHeader": true,
        "columnNotes": {
          "滞留天数": {
            "code": "pjm_qual_aging_days",
            "displayName": "滞留天数",
            "domain": "质量",
            "category": "节点属性",
            "unit": "天",
            "direction": "DOWN",
            "definition": "质量问题从发生到当前(或归零完成)的累计天数",
            "formula": "未归零: 当前日期 − 问题发生日期; 已归零: 归零完成日期 − 问题发生日期",
            "scope": "针对单个质量问题/风险/变更",
            "sourceTable": "质量信息汇总表 / 风险信息汇总表 / 技术状态信息汇总表",
            "frequency": "每日 01:00 刷新",
            "thresholds": {
              "warning": 30.0,
              "critical": 60.0,
              "rule": ">"
            },
            "excelRef": "(派生)aging_days"
          },
          "风险等级": {
            "kind": "field",
            "displayName": "风险等级",
            "definition": "风险按业务影响程度的分级。",
            "enumValues": [
              {
                "code": "高",
                "label": "高风险",
                "description": "影响项目目标的重大风险,需重点关注与即时响应"
              },
              {
                "code": "中",
                "label": "中风险",
                "description": "影响范围有限的中等风险,定期跟进"
              },
              {
                "code": "低",
                "label": "低风险",
                "description": "潜在风险,持续观察"
              }
            ],
            "sourceTable": "风险信息汇总表 / 进度信息汇总表(节点风险)",
            "note": null
          },
          "风险类别": {
            "kind": "field",
            "displayName": "风险类别",
            "definition": "风险按业务领域的分类。",
            "enumValues": [
              {
                "code": "技术",
                "label": "技术风险",
                "description": "技术方案/技术难题/技术指标相关"
              },
              {
                "code": "进度",
                "label": "进度风险",
                "description": "节点延期/计划偏差相关"
              },
              {
                "code": "成本",
                "label": "成本风险",
                "description": "预算超支/成本上升相关"
              },
              {
                "code": "设计",
                "label": "设计风险",
                "description": "设计变更/方案返工相关"
              },
              {
                "code": "质量",
                "label": "质量风险",
                "description": "产品/工艺质量相关"
              },
              {
                "code": "其他",
                "label": "其他风险",
                "description": "未归入以上分类的风险"
              }
            ],
            "sourceTable": "风险信息汇总表",
            "note": null
          },
          "风险状态": {
            "kind": "field",
            "displayName": "风险状态",
            "definition": "风险的当前生命周期状态。",
            "enumValues": [
              {
                "code": "已释放",
                "label": "已释放",
                "description": "风险已闭环,不再影响项目"
              },
              {
                "code": "未释放",
                "label": "未释放",
                "description": "风险仍在跟踪中(默认状态)"
              }
            ],
            "sourceTable": "风险信息汇总表",
            "note": "数据规范化: 仅'已释放'是显式标识,其余值统一归为'未释放'"
          }
        }
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT project_no AS \"项目编号\", risk_name AS \"风险名称\", subsystem AS \"分系统\", dept AS \"责任科室\", risk_level AS \"风险等级\", risk_category AS \"风险类别\", risk_status AS \"风险状态\", response_measure AS \"应对措施\", risk_submit_date AS \"提交日期\", final_release_date AS \"释放日期\", pending_days AS \"滞留天数\" FROM biz_dwd_risk_info_v2 WHERE submit_month >= to_char({{dateFrom}}::date, 'YYYY-MM') AND submit_month <= to_char({{dateTo}}::date, 'YYYY-MM') [[AND dept = {{deptId}}]] [[AND project_no = {{projectNo}}]] [[AND risk_level = {{riskLevel}}]] ORDER BY pending_days DESC NULLS LAST",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            },
            {
              "name": "riskLevel",
              "variableKey": "riskLevel"
            }
          ]
        }
      }
    },
