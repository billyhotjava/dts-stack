    {
      "id": "gpmc-execution-completion-trend",
      "type": "line-chart",
      "name": "完成时间变化数",
      "x": 668,
      "y": 288,
      "width": 560,
      "height": 460,
      "zIndex": 15,
      "locked": false,
      "visible": true,
      "config": {
        "title": "",
        "xAxis": {
          "type": "category",
          "name": "月份"
        },
        "yAxis": {
          "type": "value",
          "name": "节点数"
        },
        "legend": {
          "show": true
        },
        "colors": [
          "#2ee6a6",
          "#ffc645",
          "#45a4ff",
          "#ff5d73",
          "#a978ff"
        ],
        "categoryKey": "月份",
        "series": [
          {
            "name": "按时完成",
            "dataKey": "按时完成",
            "color": "#2ee6a6"
          },
          {
            "name": "超期完成",
            "dataKey": "超期完成",
            "color": "#ffc645"
          },
          {
            "name": "正常待完成",
            "dataKey": "正常待完成",
            "color": "#45a4ff"
          },
          {
            "name": "超期未完成",
            "dataKey": "超期未完成",
            "color": "#ff5d73"
          },
          {
            "name": "高风险未完成",
            "dataKey": "高风险未完成",
            "color": "#a978ff"
          }
        ],
        "titleFontSize": 0,
        "chartPaddingTop": 36,
        "axisLabelColor": "#ffffff",
        "metricNote": {
          "displayName": "完成时间变化数",
          "definition": "按「月份」分组,对比各组各系列指标",
          "scope": "X 轴=月份; 受顶部时间筛选控制",
          "sourceTable": "进度信息汇总表",
          "frequency": "每日 01:00 刷新",
          "seriesNotes": [
            {
              "name": "按时完成",
              "code": "pjm_prog_on_time_cnt",
              "displayName": "按时完成节点数",
              "formula": "完成情况='按时完成' 的节点计数",
              "unit": "个"
            },
            {
              "name": "超期完成",
              "code": "pjm_prog_overdue_done_cnt",
              "displayName": "超期完成节点数",
              "formula": "完成情况∈('超期已完成已变更','超期已完成未变更') 的节点计数",
              "unit": "个"
            },
            {
              "name": "正常待完成",
              "code": "pjm_prog_pending_normal_cnt",
              "displayName": "正常待完成节点数",
              "formula": "完成情况='正常待完成' 的节点计数",
              "unit": "个"
            },
            {
              "name": "超期未完成",
              "code": "pjm_prog_overdue_cnt",
              "displayName": "超期任务数",
              "formula": "(超期未完成未变更 + 超期未完成已变更) 的节点计数",
              "unit": "个"
            },
            {
              "name": "高风险未完成",
              "code": "pjm_prog_high_risk_incomplete",
              "displayName": "截止目前未完成高风险节点数",
              "formula": "风险等级='高' 且 状态∈('不正常待变更','超期未完成未变更','超期未完成已变更') 的节点计数",
              "unit": "个"
            }
          ]
        }
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT d.plan_month AS \"月份\", SUM(CASE WHEN d.is_on_time THEN 1 ELSE 0 END) AS \"按时完成\", SUM(CASE WHEN d.is_overdue_completed THEN 1 ELSE 0 END) AS \"超期完成\", SUM(CASE WHEN d.is_pending_normal THEN 1 ELSE 0 END) AS \"正常待完成\", SUM(CASE WHEN (d.is_overdue_unchanged OR d.is_overdue_changed) AND NOT d.is_general_node THEN 1 ELSE 0 END) AS \"超期未完成\", SUM(CASE WHEN d.is_incomplete AND d.is_high_risk THEN 1 ELSE 0 END) AS \"高风险未完成\" FROM biz_dwd_project_node_v2 d WHERE d.plan_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND d.plan_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND d.dept = {{deptId}}]] [[AND d.project_no = {{projectNo}}]] GROUP BY d.plan_month ORDER BY d.plan_month",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
