                "label": "一般节点",
                "description": "常规工作节点,通常不参与超期/不正常率统计"
              }
            ],
            "sourceTable": "进度信息汇总表",
            "note": "重要程度: 里程碑 > 重大 > 重要 > 一般"
          },
          "完成情况": {
            "kind": "field",
            "displayName": "完成情况",
            "definition": "节点在统计时点的完成状态。'已变更'表示已走过变更流程并获批。",
            "enumValues": [
              {
                "code": "正常待完成",
                "label": "正常待完成",
                "description": "节点未到计划时间,状态正常,还能正常完成"
              },
              {
                "code": "按时完成",
                "label": "按时完成",
                "description": "节点已在计划时间内完成"
              },
              {
                "code": "超期已完成已变更",
                "label": "超期已完成已变更",
                "description": "超过计划时间但已完成,且已走过变更流程"
              },
              {
                "code": "超期已完成未变更",
                "label": "超期已完成未变更",
                "description": "超过计划时间但已完成,未走变更流程"
              },
              {
                "code": "不正常待变更",
                "label": "不正常待变更",
                "description": "已到计划时间但未完成,需走变更流程(异常状态)"
              },
              {
                "code": "超期未完成未变更",
                "label": "超期未完成未变更",
                "description": "已超过计划时间且未完成,未走变更流程(严重异常)"
              },
              {
                "code": "超期未完成已变更",
                "label": "超期未完成已变更",
                "description": "已超过计划时间且未完成,已走过变更流程"
              }
            ],
            "sourceTable": "进度信息汇总表",
            "note": "排序权重: 正常待完成=1 < 按时完成=2 < 超期完成=3-4 < 不正常/超期未完成=5-7"
          }
        },
        "headerBackground": "#0f2a55"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT d.project_no AS \"项目编号\", COALESCE(d.subsystem,'') || CASE WHEN d.node_task IS NOT NULL AND d.node_task<>'' THEN ' / ' || d.node_task ELSE '' END AS \"分系统/分任务\", COALESCE(d.node_task,'') || CASE WHEN d.deliverable IS NOT NULL THEN ' · ' || d.deliverable ELSE '' END AS \"节点任务及目标\", to_char(d.plan_date,'YYYY-MM-DD') AS \"计划完成时间\", d.node_type AS \"节点类型\", d.owner AS \"负责人\", d.dept AS \"责任科室\", d.completion_status AS \"完成情况\", to_char(d.actual_date,'YYYY-MM-DD') AS \"实际完成时间\" FROM biz_dwd_project_node_v2 d WHERE d.plan_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND d.plan_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND d.dept = {{deptId}}]] [[AND d.project_no = {{projectNo}}]] ORDER BY d.plan_date ASC LIMIT 500",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
