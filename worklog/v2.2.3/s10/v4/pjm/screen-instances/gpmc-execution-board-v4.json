            "definition": "节点在项目中的重要等级,影响考核权重与异常判定。",
            "enumValues": [
              {
                "code": "里程碑节点",
                "label": "里程碑节点",
                "description": "项目对外承诺的关键交付点,权重最高,单独考核完成率"
              },
              {
                "code": "重大节点",
                "label": "重大节点",
                "description": "影响项目交付的关键节点"
              },
              {
