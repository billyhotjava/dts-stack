          "domain": "进度",
          "category": "风险",
          "unit": "个",
          "direction": "DOWN",
          "definition": "目前未完成的节点中风险等级为'高'的数量",
          "formula": "风险等级='高' 且 状态∈('不正常待变更','超期未完成未变更','超期未完成已变更') 的节点计数",
          "scope": "受顶部时间筛选器控制",
          "sourceTable": "进度信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": null,
          "excelRef": "原始指标 #18"
        },
        "metricCode": "pjm_prog_high_risk_incomplete"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COALESCE(SUM(CASE WHEN d.is_incomplete AND d.is_high_risk THEN 1 ELSE 0 END),0) AS \"高风险未完成\" FROM biz_dwd_project_node_v2 d WHERE d.plan_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND d.plan_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND d.dept = {{deptId}}]] [[AND d.project_no = {{projectNo}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
