        "description": "事实明细表：展示统计周期内风险事实、等级、类别、状态、应对措施和滞留天数。",
        "tableRole": "事实明细表",
        "headerFontSize": 14,
        "rowHoverBackground": "rgba(74, 158, 255, 0.22)",
        "autoPageSize": true,
        "minColumnWidth": 126,
        "freezeFirstColumn": true
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT project_no AS \"项目号\", COALESCE(budget_no,'-') AS \"预算编号\", COALESCE(subtopic,'-') AS \"所属子课题\", COALESCE(research_lab,'-') AS \"研究室\", budget_amount AS \"预算金额\", prepaid_amount AS \"预付账款\", book_cost_amount AS \"账面成本\", payable_amount AS \"应付账款\", executed_amount AS \"已执行\", remaining_amount AS \"剩余\", COALESCE(execution_rate_line,0) AS \"执行率%\", CASE WHEN is_overrun THEN '超支' ELSE '正常' END AS \"状态\" FROM biz_dwd_budget_v2 WHERE 1=1 [[AND research_lab = {{deptId}}]] [[AND project_no = {{projectNo}}]] [[AND subtopic = {{subtopic}}]] ORDER BY overrun_amount DESC, budget_amount DESC NULLS LAST",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            },
            {
              "name": "subtopic",
              "variableKey": "subtopic"
            }
          ]
        }
