        "titleColor": "#ffffff",
        "valueColor": "#2ee6a6",
        "backgroundColor": "transparent",
        "borderRadius": 12,
        "fontSize": 36,
        "metricNote": {
          "code": "pjm_budg_health_score",
          "displayName": "预算健康度评分",
          "domain": "预算",
          "category": "健康度",
          "unit": "分",
          "direction": "UP",
          "definition": "综合超支控制与资金支付健康的预算评分(0-100)",
          "formula": "预算控制(无超支)×0.7 + 资金支付健康(应付占比低)×0.3",
          "scope": "当前快照口径,不受时间筛选;受研究室/项目筛选控制",
          "sourceTable": "预算执行台账表",
          "frequency": "随入湖批次刷新(时点快照)",
          "thresholds": {
            "warning": 70.0,
            "critical": 50.0,
            "rule": "<"
          },
          "excelRef": "(预算台账)派生:健康分"
        },
        "metricCode": "pjm_budg_health_score"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT ROUND( (100-LEAST(100, CASE WHEN COALESCE(SUM(budget_amount),0)=0 THEN 0 ELSE SUM(overrun_amount)::numeric/NULLIF(SUM(budget_amount),0)::numeric*100 END))*0.7 + (100-LEAST(100, CASE WHEN COALESCE(SUM(executed_amount),0)=0 THEN 0 ELSE SUM(payable_amount)::numeric/NULLIF(SUM(executed_amount),0)::numeric*100 END))*0.3 ,2) AS \"预算健康度\" FROM biz_dwd_budget_v2 WHERE 1=1 [[AND research_lab = {{deptId}}]] [[AND project_no = {{projectNo}}]] [[AND subtopic = {{subtopic}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            },
            {
              "name": "subtopic",
              "variableKey": "subtopic"
            }
          ]
        }
      }
    },
