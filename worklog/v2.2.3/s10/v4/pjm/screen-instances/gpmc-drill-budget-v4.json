      "type": "table",
      "name": "预算执行汇总摘要",
      "x": 1238,
      "y": 244,
      "width": 644,
      "height": 342,
      "zIndex": 18,
      "locked": false,
      "visible": true,
      "config": {
        "title": "风险分类与释放摘要",
        "header": [
          "指标",
          "数值",
          "说明"
        ],
        "data": [],
        "fontSize": 14,
        "headerAlign": "center",
        "headerColor": "#ffffff",
        "headerBackground": "#092657",
        "bodyColor": "#ffffff",
        "bodyBackground": "rgba(4, 24, 68, 0.78)",
        "oddRowBackground": "rgba(7, 33, 84, 0.88)",
        "evenRowBackground": "rgba(12, 55, 118, 0.78)",
        "borderColor": "rgba(97, 181, 255, 0.30)",
        "enableSort": true,
        "enablePagination": true,
        "pageSize": 8,
        "freezeHeader": true,
        "columnNotes": {},
        "description": "指标摘要表：按风险月度汇总展示总量、等级分布、已释放和未释放规模。",
        "tableRole": "指标摘要表",
        "headerFontSize": 14,
        "rowHoverBackground": "rgba(74, 158, 255, 0.22)",
        "autoPageSize": true,
        "minColumnWidth": 116,
        "freezeFirstColumn": true
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "WITH agg AS (SELECT COALESCE(SUM(budget_amount),0)::numeric AS budget, COALESCE(SUM(executed_amount),0)::numeric AS executed, COALESCE(SUM(prepaid_amount),0)::numeric AS prepaid, COALESCE(SUM(book_cost_amount),0)::numeric AS book_cost, COALESCE(SUM(payable_amount),0)::numeric AS payable, COALESCE(SUM(remaining_amount),0)::numeric AS remaining, COALESCE(SUM(overrun_amount),0)::numeric AS overrun, COALESCE(SUM(CASE WHEN is_overrun THEN 1 ELSE 0 END),0)::numeric AS overrun_cnt FROM biz_dwd_budget_v2 WHERE 1=1 [[AND research_lab = {{deptId}}]] [[AND project_no = {{projectNo}}]] [[AND subtopic = {{subtopic}}]]) SELECT v.metric AS \"指标\", v.value AS \"数值\", v.note AS \"说明\" FROM agg CROSS JOIN LATERAL (VALUES ('预算总额', agg.budget, '调整后批复预算总额'), ('已执行', agg.executed, '预付+账面+应付(三本账合计)'), ('预付账款', agg.prepaid, '已付未验收未报销无发票'), ('账面成本', agg.book_cost, '已验收有发票的已确认支出'), ('应付账款', agg.payable, '有发票暂未付款'), ('预算剩余', agg.remaining, '预算总额−已执行'), ('超支金额', agg.overrun, '单条max(0,已执行−预算)之和'), ('超支条目数', agg.overrun_cnt, '已执行>预算的条目数')) AS v(metric,value,note)",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            },
            {
              "name": "subtopic",
              "variableKey": "subtopic"
            }
          ]
        }
      }
    },
