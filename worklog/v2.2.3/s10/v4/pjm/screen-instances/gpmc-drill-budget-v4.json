            "direction": "DOWN",
            "definition": "单条预算已执行超出预算部分的合计",
            "formula": "Σ max(0, 单条已执行 − 单条预算)",
            "scope": "当前快照口径,不受时间筛选;受研究室/项目筛选控制",
            "sourceTable": "预算执行台账表",
            "frequency": "随入湖批次刷新(时点快照)",
            "thresholds": {
