          "code": "pjm_budg_execution_rate",
          "displayName": "预算执行率",
          "domain": "预算",
          "category": "率",
          "unit": "%",
          "direction": "NEUTRAL",
          "definition": "已执行占预算的比率,≥100% 即超支",
          "formula": "已执行 ÷ 预算总额 × 100%",
          "scope": "当前快照口径,不受时间筛选;受研究室/项目筛选控制",
          "sourceTable": "预算执行台账表",
          "frequency": "随入湖批次刷新(时点快照)",
          "thresholds": {
            "warning": 90.0,
            "critical": 100.0,
            "rule": ">"
          },
          "excelRef": "(预算台账)派生:执行率"
        },
        "metricCode": "pjm_budg_execution_rate"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT CASE WHEN COALESCE(SUM(d.budget_amount),0)=0 THEN 0 ELSE ROUND(SUM(d.executed_amount)::numeric/NULLIF(SUM(d.budget_amount),0)::numeric*100,2) END AS v FROM biz_dwd_budget_v2 d WHERE 1=1 [[AND d.research_lab = {{deptId}}]] [[AND d.project_no = {{projectNo}}]] [[AND d.subtopic = {{subtopic}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            },
            {
              "name": "subtopic",
              "variableKey": "subtopic"
            }
          ]
        }
      }
