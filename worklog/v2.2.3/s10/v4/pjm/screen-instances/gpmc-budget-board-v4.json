          "code": "pjm_budg_total",
          "displayName": "预算总额(调整后)",
          "domain": "预算",
          "category": "基础",
          "unit": "元",
          "direction": "NEUTRAL",
          "definition": "调整后批复预算总额(时点快照)",
          "formula": "Σ 预算金额(调整后)",
          "scope": "当前快照口径,不受时间筛选;受研究室/项目筛选控制",
          "sourceTable": "预算执行台账表",
          "frequency": "随入湖批次刷新(时点快照)",
          "thresholds": null,
          "excelRef": "(预算台账)预算金额(调整后)"
        },
        "metricCode": "pjm_budg_total"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COALESCE(SUM(d.budget_amount),0) AS v FROM biz_dwd_budget_v2 d WHERE 1=1 [[AND d.research_lab = {{deptId}}]] [[AND d.project_no = {{projectNo}}]] [[AND d.subtopic = {{subtopic}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            },
            {
              "name": "subtopic",
              "variableKey": "subtopic"
            }
          ]
        }
      }
