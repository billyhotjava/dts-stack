        "precision": 2,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#ffffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "metricNote": {
          "code": "pjm_qual_zero_rate",
          "displayName": "质量问题归零率",
          "domain": "质量",
          "category": "归零率",
          "unit": "%",
          "direction": "UP",
          "definition": "周期内新增质量问题中已完成归零的占比",
          "formula": "已完成归零数 ÷ 新增质量问题数 × 100%",
          "scope": "受顶部时间筛选器控制",
          "sourceTable": "质量信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": {
            "warning": 60.0,
            "critical": 50.0,
            "rule": "<"
          },
          "excelRef": "二次指标 #7 pjm_qual_zero_rate"
        },
        "metricCode": "pjm_qual_zero_rate"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT CASE WHEN SUM(s.new_issue_cnt)=0 THEN 0 ELSE ROUND(SUM(s.zero_completed_cnt)::numeric/NULLIF(SUM(s.new_issue_cnt),0)::numeric*100,2) END AS v FROM biz_dws_quality_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no = {{projectNo}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
    {
      "id": "gpmc-quality-kpi-top1",
      "type": "number-card",
      "name": "TOP1质量问题数",
      "x": 1436,
      "y": 126,
      "width": 440,
      "height": 118,
