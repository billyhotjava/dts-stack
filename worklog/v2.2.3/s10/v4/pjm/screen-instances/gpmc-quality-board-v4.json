        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#ffffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "metricNote": {
          "code": "pjm_qual_new_issues",
          "displayName": "新增质量问题数",
          "domain": "质量",
          "category": "基础",
          "unit": "个",
          "direction": "DOWN",
          "definition": "周期内新发生的质量问题总数",
          "formula": "质量问题发生时间在[开始日期,结束日期]内的问题计数",
          "scope": "受顶部时间筛选器控制",
          "sourceTable": "质量信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": null,
          "excelRef": "原始指标 #34"
        },
        "metricCode": "pjm_qual_new_issues"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COALESCE(SUM(s.new_issue_cnt),0) AS v FROM biz_dws_quality_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no = {{projectNo}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
