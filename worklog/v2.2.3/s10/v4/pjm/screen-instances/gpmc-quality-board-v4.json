        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#ffffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "metricNote": {
          "code": "pjm_qual_top1_count",
          "displayName": "TOP1 质量问题分类数量",
          "domain": "质量",
          "category": "分类",
          "unit": "个",
          "direction": "DOWN",
          "definition": "现存质量问题中数量最多的一个分类的问题数",
          "formula": "MAX(各原因分类的现存问题数),含设计/工艺/管理/元器件/操作/外协外购/软件/其他",
          "scope": "全量未归零质量问题",
          "sourceTable": "质量信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": null,
          "excelRef": "原始指标 #41-#48"
        },
        "metricCode": "pjm_qual_top1_count"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COALESCE(MAX(cnt),0) AS v FROM (SELECT s.project_no, SUM(s.new_issue_cnt) AS cnt FROM biz_dws_quality_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no = {{projectNo}}]] GROUP BY s.project_no) t",
