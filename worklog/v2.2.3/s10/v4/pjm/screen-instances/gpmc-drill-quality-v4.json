    {
      "id": "drill-quality-kpi-1",
      "type": "number-card",
      "name": "归零率",
      "x": 20,
      "y": 70,
      "width": 456,
      "height": 90,
      "zIndex": 10,
      "locked": false,
      "visible": true,
      "config": {
        "title": "质量问题归零率",
        "value": "68.3",
        "unit": "%",
        "precision": 1,
        "titleColor": "#ffffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "borderRadius": 12,
        "fontSize": 36,
        "metricNote": {
          "code": "pjm_qual_zero_rate",
          "displayName": "质量问题归零率",
          "domain": "质量",
          "category": "归零率",
          "unit": "%",
          "direction": "UP",
          "definition": "周期内新增质量问题中已完成归零的占比",
          "formula": "已完成归零数 ÷ 新增质量问题数 × 100%",
          "scope": "受顶部时间筛选器控制",
          "sourceTable": "质量信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": {
            "warning": 60,
            "critical": 50,
            "rule": "<"
          },
          "excelRef": "二次指标 #7 pjm_qual_zero_rate"
        },
        "metricCode": "pjm_qual_zero_rate"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "WITH agg AS (SELECT SUM(new_issue_cnt) AS new_issue_cnt, SUM(zero_completed_cnt) AS zero_completed_cnt, SUM(open_issue_cnt) AS open_issue_cnt, SUM(no_zero_plan_cnt) AS no_zero_plan_cnt FROM biz_dws_quality_monthly_v2 WHERE period_month >= to_char({{dateFrom}}::date, 'YYYY-MM') AND period_month <= to_char({{dateTo}}::date, 'YYYY-MM') [[AND dept = {{deptId}}]] [[AND project_no = {{projectNo}}]]) SELECT CASE WHEN new_issue_cnt=0 THEN 0 ELSE ROUND(zero_completed_cnt::numeric/new_issue_cnt::numeric*100,2) END AS \"归零率\", CASE WHEN new_issue_cnt=0 THEN 0 ELSE ROUND(open_issue_cnt::numeric/new_issue_cnt::numeric*100,2) END AS \"现存率\", CASE WHEN new_issue_cnt=0 THEN 0 ELSE ROUND((new_issue_cnt-no_zero_plan_cnt)::numeric/new_issue_cnt::numeric*100,2) END AS \"计划提交率\", ROUND((CASE WHEN new_issue_cnt=0 THEN 0 ELSE zero_completed_cnt::numeric/new_issue_cnt::numeric*100 END)*0.5 + (CASE WHEN new_issue_cnt=0 THEN 0 ELSE (new_issue_cnt-no_zero_plan_cnt)::numeric/new_issue_cnt::numeric*100 END)*0.3 + (100 - CASE WHEN new_issue_cnt=0 THEN 0 ELSE open_issue_cnt::numeric/new_issue_cnt::numeric*100 END)*0.2, 2) AS \"质量健康度\" FROM agg",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
    {
      "id": "drill-quality-kpi-2",
