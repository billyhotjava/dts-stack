            "note": "数据规范化: '处理中'/'进行中'/'未闭环'等统一归为'未完成归零'"
          }
        },
        "description": "事实明细表：展示统计周期内质量问题的项目、分类、归零状态、当前进展和滞留天数。",
        "tableRole": "事实明细表",
        "headerFontSize": 14,
        "rowHoverBackground": "rgba(74, 158, 255, 0.22)",
        "autoPageSize": true,
        "minColumnWidth": 126,
