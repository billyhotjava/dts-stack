        "minColumnWidth": 116,
        "freezeFirstColumn": true
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "WITH agg AS (SELECT COALESCE(SUM(new_issue_cnt),0)::numeric AS new_issue_cnt, COALESCE(SUM(open_issue_cnt),0)::numeric AS open_issue_cnt, COALESCE(SUM(zero_completed_cnt),0)::numeric AS zero_completed_cnt, COALESCE(SUM(no_zero_plan_cnt),0)::numeric AS no_zero_plan_cnt, COALESCE(SUM(tech_zero_cnt),0)::numeric AS tech_zero_cnt, COALESCE(SUM(mgmt_zero_cnt),0)::numeric AS mgmt_zero_cnt, COALESCE(SUM(both_zero_cnt),0)::numeric AS both_zero_cnt FROM biz_dws_quality_monthly_v2 WHERE period_month >= to_char({{dateFrom}}::date, 'YYYY-MM') AND period_month <= to_char({{dateTo}}::date, 'YYYY-MM') [[AND dept = {{deptId}}]] [[AND project_no = {{projectNo}}]]) SELECT v.metric AS \"指标\", v.value AS \"数值\", v.note AS \"说明\" FROM agg CROSS JOIN LATERAL (VALUES ('新增质量问题', agg.new_issue_cnt, '统计周期内新增质量问题数量'), ('现存质量问题', agg.open_issue_cnt, '截至统计周期仍未归零的问题数量'), ('已归零数', agg.zero_completed_cnt, '统计周期内完成归零闭环的问题数量'), ('未提交归零计划', agg.no_zero_plan_cnt, '尚未形成归零计划的问题数量'), ('技术归零', agg.tech_zero_cnt, '按技术归零方式闭环的问题数量'), ('管理归零', agg.mgmt_zero_cnt, '按管理归零方式闭环的问题数量'), ('双归零', agg.both_zero_cnt, '同时完成技术与管理归零的问题数量')) AS v(metric,value,note)",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
