    {
      "id": "drill-quality-detail-table",
      "type": "table",
      "name": "质量问题全量清单",
      "x": 38,
      "y": 244,
      "width": 1144,
      "height": 342,
      "zIndex": 18,
      "locked": false,
      "visible": true,
      "config": {
        "title": "质量问题全量清单",
        "header": [
          "项目编号",
          "分系统",
          "问题名称",
          "责任科室",
          "问题分类",
          "归零计划",
