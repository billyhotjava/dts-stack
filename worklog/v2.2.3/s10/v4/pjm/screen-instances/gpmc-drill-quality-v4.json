        ],
        "data": [],
        "fontSize": 14,
        "headerAlign": "center",
        "headerColor": "#ffffff",
        "headerBackground": "#092657",
        "bodyColor": "#ffffff",
        "bodyBackground": "rgba(4, 24, 68, 0.78)",
        "oddRowBackground": "rgba(7, 33, 84, 0.88)",
        "evenRowBackground": "rgba(12, 55, 118, 0.78)",
        "borderColor": "rgba(97, 181, 255, 0.30)",
        "enableSort": true,
        "enablePagination": true,
        "pageSize": 8,
        "freezeHeader": true,
        "columnNotes": {
          "滞留天数": {
            "code": "pjm_qual_aging_days",
            "displayName": "滞留天数",
            "domain": "质量",
            "category": "节点属性",
            "unit": "天",
            "direction": "DOWN",
            "definition": "质量问题从发生到当前(或归零完成)的累计天数",
            "formula": "未归零: 当前日期 − 问题发生日期; 已归零: 归零完成日期 − 问题发生日期",
            "scope": "针对单个质量问题/风险/变更",
            "sourceTable": "质量信息汇总表 / 风险信息汇总表 / 技术状态信息汇总表",
            "frequency": "每日 01:00 刷新",
            "thresholds": {
              "warning": 30,
              "critical": 60,
              "rule": ">"
            },
            "excelRef": "(派生)aging_days"
          },
          "问题分类": {
            "kind": "field",
            "displayName": "质量问题分类",
            "definition": "质量问题按发生原因的分类。",
            "enumValues": [
              {
                "code": "设计",
                "label": "设计",
                "description": "设计阶段引入的问题"
              },
              {
