          "风险等级": {
            "kind": "field",
            "displayName": "风险等级",
            "definition": "风险按业务影响程度的分级。",
            "enumValues": [
              {
                "code": "高",
                "label": "高风险",
                "description": "影响项目目标的重大风险,需重点关注与即时响应"
              },
              {
                "code": "中",
