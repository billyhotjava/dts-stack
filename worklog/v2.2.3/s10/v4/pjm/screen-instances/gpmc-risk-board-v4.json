          "code": "pjm_risk_release_rate",
          "displayName": "风险释放率",
          "domain": "风险",
          "category": "释放率",
          "unit": "%",
          "direction": "UP",
          "definition": "周期内已释放风险占总风险的比率",
          "formula": "已释放风险数 ÷ 风险总数 × 100%",
          "scope": "受顶部时间筛选器控制",
          "sourceTable": "风险信息汇总表",
          "frequency": "每日 01:00 刷新",
          "thresholds": {
            "warning": 60.0,
            "critical": 50.0,
            "rule": "<"
          },
          "excelRef": "(衍生)释放率"
        },
        "metricCode": "pjm_risk_release_rate"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT CASE WHEN SUM(s.total_risk_cnt)=0 THEN 0 ELSE ROUND(SUM(s.released_cnt)::numeric/NULLIF(SUM(s.total_risk_cnt),0)::numeric*100,2) END AS v FROM biz_dws_risk_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no = {{projectNo}}]]",
