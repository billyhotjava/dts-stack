        "headerBackground": "#0f2a55"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT d.project_no AS \"项目编号\", COALESCE(d.subsystem,'') AS \"分系统/分任务\", d.risk_name AS \"风险名称\", COALESCE(d.risk_level,'-') AS \"风险等级\", COALESCE(d.risk_category,'-') AS \"风险分类\", COALESCE(d.risk_status,'-') AS \"风险状态\", to_char(d.risk_submit_date,'YYYY-MM-DD') AS \"提出时间\", to_char(d.final_release_date,'YYYY-MM-DD') AS \"计划释放时间\", COALESCE(d.response_owner,'-') AS \"负责人\", COALESCE(d.dept,'-') AS \"责任科室\", to_char(d.risk_release_date,'YYYY-MM-DD') AS \"实际释放时间\", d.pending_days AS \"滞留天数\" FROM biz_dwd_risk_info_v2 d WHERE to_char(d.risk_submit_date,'YYYY-MM') >= to_char({{dateFrom}}::date,'YYYY-MM') AND to_char(d.risk_submit_date,'YYYY-MM') <= to_char({{dateTo}}::date,'YYYY-MM') [[AND d.dept = {{deptId}}]] [[AND d.project_no = {{projectNo}}]] [[AND d.risk_level = {{riskLevel}}]] ORDER BY d.risk_rank DESC, d.risk_submit_date DESC LIMIT 500",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
