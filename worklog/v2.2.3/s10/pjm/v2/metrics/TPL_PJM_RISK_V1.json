{
  "code": "TPL_PJM_RISK_V1",
  "name": "PJM 风险管理指标模板",
  "description": "项目风险管理域指标模板，覆盖风险总数、等级分布、未释放数和释放率，基于风险信息汇总表(ods_risk_info)",
  "domain": "pjm",
  "builtin": true,
  "enabled": true,
  "displayOrder": 4,
  "recommendedSnapshot": true,
  "seedTables": [
    "ods_risk_info"
  ],
  "requiredSourceFields": [
    "project_no",
    "subsystem",
    "dept",
    "risk_name",
    "risk_level",
    "risk_category",
    "risk_status",
    "risk_submit_time",
    "risk_release_date",
    "final_release_time"
  ],
  "indicatorBlueprints": [
    {
      "code": "pjm_risk_total",
      "name": "风险总数",
      "category": "风险-基础",
      "definition": "风险提出时间在统计区间内的风险记录总数",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "risk_submit_time BETWEEN :startDate AND :endDate",
      "sourceTable": "ods_risk_info",
      "dimensionFields": [
        "project_no",
        "subsystem",
        "dept",
        "risk_category",
        "risk_level"
      ],
      "dateColumn": "risk_submit_time",
      "timeGrain": "MONTH",
      "unit": "个",
      "precisionScale": 0,
      "direction": "DOWN",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_risk_high_count",
      "name": "高风险数",
      "category": "风险-基础",
      "definition": "风险等级='高'的风险数量",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "risk_submit_time BETWEEN :startDate AND :endDate AND risk_level = '高'",
      "sourceTable": "ods_risk_info",
      "dimensionFields": [
        "project_no",
        "dept"
      ],
      "dateColumn": "risk_submit_time",
      "timeGrain": "MONTH",
      "unit": "个",
      "precisionScale": 0,
      "direction": "DOWN",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_risk_mid_count",
      "name": "中风险数",
      "category": "风险-基础",
      "definition": "风险等级='中'的风险数量",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "risk_submit_time BETWEEN :startDate AND :endDate AND risk_level = '中'",
      "sourceTable": "ods_risk_info",
      "dimensionFields": [
        "project_no",
        "dept"
      ],
      "dateColumn": "risk_submit_time",
      "timeGrain": "MONTH",
      "unit": "个",
      "precisionScale": 0,
      "direction": "DOWN",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_risk_open_count",
      "name": "未释放风险数",
      "category": "风险-基础",
      "definition": "风险状态 != '已释放' 的风险数量",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "risk_submit_time BETWEEN :startDate AND :endDate AND risk_status != '已释放'",
      "sourceTable": "ods_risk_info",
      "dimensionFields": [
        "project_no",
        "dept",
        "risk_level"
      ],
      "dateColumn": "risk_submit_time",
      "timeGrain": "MONTH",
      "unit": "个",
      "precisionScale": 0,
      "direction": "DOWN",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_risk_release_rate",
      "name": "风险释放率",
      "category": "风险-率",
      "definition": "已释放风险数 / 风险总数 × 100%",
      "aggregationType": "RATIO",
      "numeratorExpression": "COUNT(*) FILTER (WHERE risk_submit_time BETWEEN :startDate AND :endDate AND risk_status = '已释放')",
      "denominatorExpression": "NULLIF(COUNT(*) FILTER (WHERE risk_submit_time BETWEEN :startDate AND :endDate), 0)",
      "staticFilter": null,
      "sourceTable": "ods_risk_info",
      "dimensionFields": [
        "project_no",
        "dept"
      ],
      "dateColumn": "risk_submit_time",
      "timeGrain": "MONTH",
      "unit": "%",
      "precisionScale": 2,
      "direction": "UP",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS",
      "thresholdMin": 70.0
    },
    {
      "code": "pjm_risk_health_score",
      "name": "风险健康度评分",
      "category": "风险-综合",
      "definition": "(100-高风险占比×100)×0.4 + 风险释放率×0.4 + (100-未释放占比×100)×0.2",
      "aggregationType": "SCORE",
      "numeratorExpression": null,
      "denominatorExpression": null,
      "staticFilter": null,
      "sourceTable": "ods_risk_info",
      "dimensionFields": [
        "project_no"
      ],
      "dateColumn": "risk_submit_time",
      "timeGrain": "MONTH",
      "unit": "分",
      "precisionScale": 1,
      "direction": "UP",
      "isDerived": true,
      "sourceLayer": "ODS",
      "targetLayer": "ADS",
      "thresholdMin": 70.0,
      "dependencyIndicators": [
        "pjm_risk_release_rate",
        "pjm_risk_high_count",
        "pjm_risk_open_count"
      ]
    }
  ]
}
