    {
      "id": "gpmc-execution-kpi-completion",
      "type": "number-card",
      "name": "整体完成率",
      "x": 58,
      "y": 126,
      "width": 260,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "整体完成率",
        "value": 72.4,
        "suffix": "%",
        "precision": 1,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#475569",
        "valueColor": "#1a5276",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT CASE WHEN (SUM(s.due_cnt)+SUM(s.outside_completed_cnt))=0 THEN 0 ELSE ROUND(SUM(s.completed_total_cnt)::numeric/(SUM(s.due_cnt)+SUM(s.outside_completed_cnt))::numeric*100,2) END AS \"完成率\", CASE WHEN (SUM(s.incomplete_milestone_cnt)+SUM(s.milestone_on_time_cnt)+SUM(s.milestone_overdue_completed_cnt))=0 THEN 0 ELSE ROUND((SUM(s.milestone_on_time_cnt)+SUM(s.milestone_overdue_completed_cnt))::numeric/(SUM(s.incomplete_milestone_cnt)+SUM(s.milestone_on_time_cnt)+SUM(s.milestone_overdue_completed_cnt))::numeric*100,2) END AS \"里程碑完成率\", SUM(s.incomplete_cnt) AS \"未完成总数\", SUM(s.incomplete_high_risk_cnt) AS \"未完成高风险\" FROM biz_dws_progress_monthly_v2 s WHERE s.plan_month >= to_char({{dateFrom}}::date, 'YYYY-MM') AND s.plan_month <= to_char({{dateTo}}::date, 'YYYY-MM') [[AND s.project_no ILIKE '%' || {{projectNo}} || '%']]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
    {
      "id": "gpmc-execution-kpi-milestone",
      "type": "number-card",
      "name": "里程碑达成率",
      "x": 332,
      "y": 126,
      "width": 260,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "里程碑达成率",
        "value": 68,
        "suffix": "%",
        "precision": 0,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#475569",
        "valueColor": "#d4850a",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT CASE WHEN (SUM(s.due_cnt)+SUM(s.outside_completed_cnt))=0 THEN 0 ELSE ROUND(SUM(s.completed_total_cnt)::numeric/(SUM(s.due_cnt)+SUM(s.outside_completed_cnt))::numeric*100,2) END AS \"完成率\", CASE WHEN (SUM(s.incomplete_milestone_cnt)+SUM(s.milestone_on_time_cnt)+SUM(s.milestone_overdue_completed_cnt))=0 THEN 0 ELSE ROUND((SUM(s.milestone_on_time_cnt)+SUM(s.milestone_overdue_completed_cnt))::numeric/(SUM(s.incomplete_milestone_cnt)+SUM(s.milestone_on_time_cnt)+SUM(s.milestone_overdue_completed_cnt))::numeric*100,2) END AS \"里程碑完成率\", SUM(s.incomplete_cnt) AS \"未完成总数\", SUM(s.incomplete_high_risk_cnt) AS \"未完成高风险\" FROM biz_dws_progress_monthly_v2 s WHERE s.plan_month >= to_char({{dateFrom}}::date, 'YYYY-MM') AND s.plan_month <= to_char({{dateTo}}::date, 'YYYY-MM') [[AND s.project_no ILIKE '%' || {{projectNo}} || '%']]",
          "queryTimeoutSeconds": 30,
