{
  "code": "TPL_PJM_QUALITY_V1",
  "name": "PJM 质量管理指标模板",
  "description": "项目质量管理域指标模板，涵盖归零率、问题分类分布、计划提交率及质量健康度评分，基于质量信息汇总表(ods_quality_issue)",
  "domain": "pjm",
  "builtin": true,
  "enabled": true,
  "displayOrder": 2,
  "recommendedSnapshot": true,
  "seedTables": [
    "ods_quality_issue"
  ],
  "requiredSourceFields": [
    "project_no",
    "subsystem",
    "dept",
    "issue_date",
    "status",
    "issue_category",
    "zero_plan",
    "zero_complete_date"
  ],
  "indicatorBlueprints": [
    {
      "code": "pjm_qual_new_issues",
      "name": "新增质量问题数",
      "category": "质量-基础",
      "definition": "质量问题发生时间在统计区间内的问题总数",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "issue_date BETWEEN :startDate AND :endDate",
      "sourceTable": "ods_quality_issue",
      "dimensionFields": [
        "project_no",
        "subsystem",
        "dept",
        "issue_category"
      ],
      "dateColumn": "issue_date",
      "timeGrain": "WEEK",
      "unit": "个",
      "precisionScale": 0,
      "direction": "DOWN",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_qual_existing_issues",
      "name": "现存质量问题数",
      "category": "质量-基础",
      "definition": "状态为未完成归零的质量问题总数",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "status = '未完成归零'",
      "sourceTable": "ods_quality_issue",
      "dimensionFields": [
        "project_no",
        "subsystem",
        "dept",
        "issue_category"
      ],
      "dateColumn": null,
      "timeGrain": "WEEK",
      "unit": "个",
      "precisionScale": 0,
      "direction": "DOWN",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_qual_zeroed_count",
      "name": "已完成归零数",
      "category": "质量-基础",
      "definition": "已完成技术归零+已完成管理归零+已完成技术和管理归零",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "issue_date BETWEEN :startDate AND :endDate AND status IN ('已完成技术归零','已完成管理归零','已完成技术和管理归零')",
      "sourceTable": "ods_quality_issue",
      "dimensionFields": [
        "project_no",
        "subsystem",
        "dept"
      ],
      "dateColumn": "issue_date",
      "timeGrain": "WEEK",
      "unit": "个",
      "precisionScale": 0,
      "direction": "UP",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_qual_zero_rate",
      "name": "质量问题归零率",
      "category": "质量-率",
      "definition": "已完成归零数 / 新增质量问题数 × 100%",
      "aggregationType": "RATIO",
      "numeratorExpression": "COUNT(*) FILTER (WHERE issue_date BETWEEN :startDate AND :endDate AND status IN ('已完成技术归零','已完成管理归零','已完成技术和管理归零'))",
      "denominatorExpression": "NULLIF(COUNT(*) FILTER (WHERE issue_date BETWEEN :startDate AND :endDate), 0)",
      "staticFilter": null,
      "sourceTable": "ods_quality_issue",
      "dimensionFields": [
        "project_no",
        "dept"
      ],
      "dateColumn": "issue_date",
      "timeGrain": "WEEK",
      "unit": "%",
      "precisionScale": 2,
      "direction": "UP",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS",
      "thresholdMin": 60.0
    },
    {
      "code": "pjm_qual_plan_submit_rate",
      "name": "归零计划提交率",
      "category": "质量-率",
      "definition": "(新增问题数-未提交归零计划) / 新增问题数 × 100%",
      "aggregationType": "RATIO",
      "numeratorExpression": "COUNT(*) FILTER (WHERE issue_date BETWEEN :startDate AND :endDate AND zero_plan != '无')",
      "denominatorExpression": "NULLIF(COUNT(*) FILTER (WHERE issue_date BETWEEN :startDate AND :endDate), 0)",
      "staticFilter": null,
      "sourceTable": "ods_quality_issue",
      "dimensionFields": [
        "project_no",
        "dept"
      ],
      "dateColumn": "issue_date",
      "timeGrain": "WEEK",
      "unit": "%",
      "precisionScale": 2,
      "direction": "UP",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS",
      "thresholdMin": 80.0
    },
    {
      "code": "pjm_qual_health_score",
      "name": "质量健康度评分",
      "category": "质量-综合",
      "definition": "归零率×0.5 + 归零计划提交率×0.3 + (100-现存率)×0.2",
      "aggregationType": "SCORE",
      "numeratorExpression": null,
      "denominatorExpression": null,
      "staticFilter": null,
      "sourceTable": "ods_quality_issue",
      "dimensionFields": [
        "project_no"
      ],
      "dateColumn": "issue_date",
      "timeGrain": "WEEK",
      "unit": "分",
      "precisionScale": 1,
      "direction": "UP",
      "isDerived": true,
      "sourceLayer": "ODS",
      "targetLayer": "ADS",
      "thresholdMin": 70.0,
      "dependencyIndicators": [
        "pjm_qual_zero_rate",
        "pjm_qual_plan_submit_rate",
        "pjm_qual_remaining_ratio"
      ]
    }
  ]
}