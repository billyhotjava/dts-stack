{
  "code": "TPL_PJM_TECHSTATE_V1",
  "name": "PJM 技术状态管理指标模板",
  "description": "项目技术状态管理域指标模板，涵盖I/II/III类更改数量、签署完成率、整改落实率及技术状态健康度评分，基于技术状态信息汇总表(ods_tech_state)",
  "domain": "pjm",
  "builtin": true,
  "enabled": true,
  "displayOrder": 3,
  "recommendedSnapshot": true,
  "seedTables": [
    "ods_tech_state"
  ],
  "requiredSourceFields": [
    "project_no",
    "subsystem",
    "dept",
    "change_submit_time",
    "change_category",
    "completion_signature",
    "file_signature_status",
    "reform_status"
  ],
  "indicatorBlueprints": [
    {
      "code": "pjm_tech_new_changes_I",
      "name": "新增I类更改数",
      "category": "技术状态-基础",
      "definition": "更改提出时间在统计区间内且更改类别为I的更改总数",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "change_submit_time BETWEEN :startDate AND :endDate AND change_category = 'I'",
      "sourceTable": "ods_tech_state",
      "dimensionFields": [
        "project_no",
        "subsystem",
        "dept",
        "change_category"
      ],
      "dateColumn": "change_submit_time",
      "timeGrain": "WEEK",
      "unit": "个",
      "precisionScale": 0,
      "direction": "DOWN",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_tech_new_changes_II",
      "name": "新增II类更改数",
      "category": "技术状态-基础",
      "definition": "更改提出时间在统计区间内且更改类别为II的更改总数",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "change_submit_time BETWEEN :startDate AND :endDate AND change_category = 'II'",
      "sourceTable": "ods_tech_state",
