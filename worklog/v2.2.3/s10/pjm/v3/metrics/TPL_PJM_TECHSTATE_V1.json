      "targetLayer": "ADS"
    },
    {
      "code": "pjm_tech_new_changes_III",
      "name": "新增III类更改数",
      "category": "技术状态-基础",
      "definition": "更改提出时间在统计区间内且更改类别为III的更改总数",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "change_submit_time BETWEEN :startDate AND :endDate AND change_category = 'III'",
      "sourceTable": "ods_tech_state",
