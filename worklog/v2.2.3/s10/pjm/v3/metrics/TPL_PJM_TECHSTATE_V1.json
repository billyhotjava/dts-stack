    {
      "code": "pjm_tech_signed_count",
      "name": "已完成签署变更单数",
      "category": "技术状态-基础",
      "definition": "completion_signature = 是 的更改总数（截止结束时间）",
      "aggregationType": "COUNT",
      "numeratorExpression": "COUNT(*)",
      "denominatorExpression": "1",
      "staticFilter": "completion_signature = '是'",
      "sourceTable": "ods_tech_state",
      "dimensionFields": [
        "project_no",
        "subsystem",
        "dept",
        "change_category"
      ],
      "dateColumn": null,
      "timeGrain": "WEEK",
      "unit": "个",
      "precisionScale": 0,
      "direction": "UP",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS"
    },
    {
      "code": "pjm_tech_signature_rate",
      "name": "变更单签署完成率",
      "category": "技术状态-率",
      "definition": "已完成签署 / (已完成签署+未完成签署I+II+III) × 100%",
      "aggregationType": "RATIO",
      "numeratorExpression": "COUNT(*) FILTER (WHERE completion_signature = '是')",
      "denominatorExpression": "NULLIF(COUNT(*), 0)",
      "staticFilter": null,
      "sourceTable": "ods_tech_state",
      "dimensionFields": [
        "project_no",
        "dept"
      ],
      "dateColumn": "change_submit_time",
      "timeGrain": "WEEK",
      "unit": "%",
      "precisionScale": 2,
      "direction": "UP",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS",
      "thresholdMin": 80.0
    },
    {
      "code": "pjm_tech_reform_rate",
      "name": "整改落实完成率（I,II类）",
      "category": "技术状态-率",
      "definition": "已落实整改(I,II类) / (已落实+未落实) × 100%",
      "aggregationType": "RATIO",
      "numeratorExpression": "COUNT(*) FILTER (WHERE change_category IN ('I','II') AND reform_status = '已落实整改')",
      "denominatorExpression": "NULLIF(COUNT(*) FILTER (WHERE change_category IN ('I','II') AND reform_status IN ('已落实整改','未落实整改')), 0)",
      "staticFilter": null,
      "sourceTable": "ods_tech_state",
      "dimensionFields": [
        "project_no",
        "dept"
      ],
      "dateColumn": "change_submit_time",
      "timeGrain": "WEEK",
      "unit": "%",
      "precisionScale": 2,
      "direction": "UP",
      "isDerived": false,
      "sourceLayer": "ODS",
      "targetLayer": "ADS",
      "thresholdMin": 80.0
    },
    {
      "code": "pjm_tech_health_score",
      "name": "技术状态健康度评分",
      "category": "技术状态-综合",
      "definition": "签署完成率×0.4 + 整改落实率×0.4 + (100-未签署比率)×0.2",
      "aggregationType": "SCORE",
      "numeratorExpression": null,
      "denominatorExpression": null,
      "staticFilter": null,
      "sourceTable": "ods_tech_state",
      "dimensionFields": [
        "project_no"
      ],
      "dateColumn": "change_submit_time",
      "timeGrain": "WEEK",
      "unit": "分",
      "precisionScale": 1,
      "direction": "UP",
      "isDerived": true,
      "sourceLayer": "ODS",
      "targetLayer": "ADS",
      "thresholdMin": 70.0,
      "dependencyIndicators": [
        "pjm_tech_signature_rate",
        "pjm_tech_reform_rate",
        "pjm_tech_unsigned_ratio"
      ]
    }
  ]
