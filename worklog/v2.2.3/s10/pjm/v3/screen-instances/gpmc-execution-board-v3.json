    {
      "id": "gpmc-execution-gantt",
      "type": "gantt-chart",
      "name": "项目进度甘特图",
      "x": 56,
      "y": 288,
      "width": 860,
      "height": 460,
      "zIndex": 15,
      "locked": false,
      "visible": true,
      "config": {
        "title": "项目进度甘特图（重大项目·按计划完成日期正序）",
        "renderMode": "board-hierarchical",
        "drillMode": "modal",
        "sideTextColor": "#081c3f"
      },
      "actions": [],
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT d.node_id, d.node_task, d.node_type, d.owner, d.dept, d.project_no AS major_project_id, d.project_no AS major_project_name, d.project_no || '|' || COALESCE(d.subsystem,'(无分系统)') AS subproject_id, COALESCE(d.subsystem,'(无分系统)') AS subproject_name, to_char(COALESCE(d.actual_start_date, d.plan_start_date), 'YYYY-MM-DD') AS start_date, to_char(d.plan_start_date, 'YYYY-MM-DD') AS baseline_start_date, to_char(d.plan_date, 'YYYY-MM-DD') AS baseline_end_date, to_char(d.actual_date, 'YYYY-MM-DD') AS actual_end, d.is_completed, d.is_overdue_completed, d.is_incomplete, COALESCE(d.delay_days, 0) AS delay_days, d.risk_level, d.completion_status FROM biz_dwd_project_node_v2 d WHERE d.node_type IN ('重大节点','里程碑节点') AND d.plan_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND d.plan_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND d.dept = {{deptId}}]] [[AND d.project_no ILIKE '%' || {{projectNo}} || '%']] ORDER BY d.plan_date ASC LIMIT 200",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
