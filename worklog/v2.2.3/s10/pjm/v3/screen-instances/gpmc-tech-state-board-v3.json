    {
      "id": "gpmc-tech-kpi-total",
      "type": "number-card",
      "name": "变更单总数",
      "x": 44,
      "y": 126,
      "width": 350,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "变更单总数",
        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#8cb9df",
        "valueColor": "#d9eeff",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COALESCE(SUM(s.total_change_cnt),0) AS v FROM biz_dws_tech_state_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no ILIKE '%' || {{projectNo}} || '%']]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
    {
      "id": "gpmc-tech-kpi-unsigned",
      "type": "number-card",
      "name": "未签署数",
      "x": 414,
      "y": 126,
      "width": 350,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "未签署数",
        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#8cb9df",
        "valueColor": "#d9eeff",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COALESCE(SUM(s.order_unsigned_cat_i)+SUM(s.order_unsigned_cat_ii)+SUM(s.order_unsigned_cat_iii),0) AS v FROM biz_dws_tech_state_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no ILIKE '%' || {{projectNo}} || '%']]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    },
    {
      "id": "gpmc-tech-kpi-sign-rate",
      "type": "number-card",
      "name": "签署率",
      "x": 784,
      "y": 126,
      "width": 350,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "签署率",
        "value": 0,
        "suffix": "%",
        "precision": 2,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#8cb9df",
        "valueColor": "#d9eeff",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT CASE WHEN SUM(s.total_change_cnt)=0 THEN 0 ELSE ROUND(SUM(s.order_signed_cnt)::numeric/NULLIF(SUM(s.total_change_cnt),0)::numeric*100,2) END AS v FROM biz_dws_tech_state_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no ILIKE '%' || {{projectNo}} || '%']]",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
