    {
      "id": "gpmc-quality-kpi-close-rate",
      "type": "number-card",
      "name": "质量问题闭环率",
      "x": 972,
      "y": 126,
      "width": 440,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "质量问题闭环率",
        "value": 0,
        "suffix": "%",
        "precision": 2,
        "titleFontSize": 17,
        "valueFontSize": 34,
        "titleColor": "#8cb9df",
        "valueColor": "#d9eeff",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT CASE WHEN SUM(s.new_issue_cnt)=0 THEN 0 ELSE ROUND(SUM(s.zero_completed_cnt)::numeric/NULLIF(SUM(s.new_issue_cnt),0)::numeric*100,2) END AS v FROM biz_dws_quality_monthly_v2 s WHERE s.period_month >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.period_month <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.dept = {{deptId}}]] [[AND s.project_no ILIKE '%' || {{projectNo}} || '%']]",
