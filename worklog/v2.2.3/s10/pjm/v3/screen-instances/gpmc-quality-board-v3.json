    {
      "id": "gpmc-quality-kpi-total",
      "type": "number-card",
      "name": "质量问题总数",
      "x": 44,
      "y": 126,
      "width": 440,
      "height": 118,
      "zIndex": 12,
      "locked": false,
      "visible": true,
      "config": {
        "title": "质量问题总数",
