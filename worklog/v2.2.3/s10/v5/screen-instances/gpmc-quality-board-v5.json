        "chartPaddingTop": 0,
        "bodyColor": "#334155",
        "freezeHeader": true,
        "headerBGC": "#f8fafc",
        "oddRowBGC": "#ffffff",
        "evenRowBGC": "#f8fafc",
        "color": "#334155"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT d.project_no AS \"项目编号\", COALESCE(d.subsystem,'') || CASE WHEN d.issue_name IS NOT NULL AND d.issue_name<>'' THEN ' · ' || d.issue_name ELSE '' END AS \"节点任务/分系统\", COALESCE(d.issue_category,'-') AS \"问题分类\", COALESCE(d.filled_by,'-') AS \"问题发现人\", d.dept AS \"责任部门\", '-' AS \"质量等级\", to_char(d.issue_date,'YYYY-MM-DD') AS \"质量问题发生时间\", COALESCE(d.status,'-') AS \"整改状态\", to_char(d.zero_complete_date,'YYYY-MM-DD') AS \"整改完成时间\" FROM biz_dwd_quality_issue_v2 d WHERE to_char(d.issue_date,'YYYY-MM') >= to_char({{dateFrom}}::date,'YYYY-MM') AND to_char(d.issue_date,'YYYY-MM') <= to_char({{dateTo}}::date,'YYYY-MM') [[AND d.dept = {{deptId}}]] [[AND d.project_no = {{projectNo}}]] ORDER BY d.issue_date DESC LIMIT 500",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
    }
  ],
  "autoHeight": false
}