      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT d.project_no AS \"项目编号\", COALESCE(d.tech_state_name,'-') AS \"变更单号\", COALESCE(d.change_item,'-') AS \"变更内容\", COALESCE(d.owner,'-') AS \"责任人\", d.dept AS \"责任科室\", to_char(d.change_submit_time,'YYYY-MM-DD') AS \"发起时间\", CASE WHEN d.is_signature_completed THEN '已签署' ELSE '未签署' END AS \"签署状态\", to_char(d.signature_closure_date,'YYYY-MM-DD') AS \"签署完成时间\", COALESCE(d.reform_status,'-') AS \"整改状态\", to_char(d.reform_date,'YYYY-MM-DD') AS \"整改完成时间\" FROM biz_dwd_tech_state_v2 d WHERE to_char(d.change_submit_time,'YYYY-MM') >= to_char({{dateFrom}}::date,'YYYY-MM') AND to_char(d.change_submit_time,'YYYY-MM') <= to_char({{dateTo}}::date,'YYYY-MM') [[AND d.dept = {{deptId}}]] [[AND d.project_no = {{projectNo}}]] ORDER BY d.change_submit_time DESC LIMIT 500",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "deptId",
              "variableKey": "deptId"
            },
            {
              "name": "projectNo",
              "variableKey": "projectNo"
            }
          ]
        }
      }
