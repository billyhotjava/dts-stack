            "width": 100
          },
          {
            "key": "overloaded",
            "title": "超负荷",
            "width": 100
          },
          {
            "key": "idle",
            "title": "空闲",
            "width": 100
          }
        ],
        "headerBg": "#dbe9f6",
        "bodyBg": "rgba(255, 255, 255, 0.98)",
        "evenRowBg": "rgba(241, 245, 249, 0.98)",
        "borderRadius": 12,
        "fontSize": 13,
        "showPagination": false
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    major_project_id,\n    major_project_name,\n    subproject_id,\n    subproject_name,\n    week_start_date,\n    plan_iso_week,\n    total_nodes,\n    completed_nodes,\n    overdue_open_nodes,\n    high_risk_nodes,\n    milestone_nodes,\n    milestone_completed_nodes,\n    avg_health_score,\n    avg_delay_days,\n    max_delay_days,\n    completion_rate,\n    milestone_completion_rate\nFROM biz_dws_week_subproject_summary\nORDER BY plan_iso_week DESC, major_project_id, subproject_id",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000
        }
      }
