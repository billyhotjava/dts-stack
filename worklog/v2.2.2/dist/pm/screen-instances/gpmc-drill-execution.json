      "zIndex": 10,
      "locked": false,
      "visible": true,
      "config": {
        "title": "整体完成率",
        "value": "72.4",
        "unit": "%",
        "precision": 1,
        "titleColor": "#0f172a",
        "valueColor": "#3b82f6",
        "backgroundColor": "#ffffff",
        "borderRadius": 12,
        "fontSize": 36
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    plan_year,\n    plan_quarter,\n    plan_month,\n    total_cnt,\n    pending_normal_cnt,\n    due_cnt,\n    outside_completed_cnt,\n    incomplete_cnt,\n    on_time_cnt,\n    overdue_completed_cnt,\n    completed_total_cnt,\n    completion_rate,\n    on_time_rate,\n    overdue_completion_rate,\n    abnormal_pending_cnt,\n    overdue_incomplete_unchanged_cnt,\n    overdue_incomplete_changed_cnt\nFROM biz_ads_project_kpi_overview\nORDER BY plan_year, plan_month",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000
        }
      }
    },
    {
      "id": "drill-exec-kpi-2",
      "type": "number-card",
      "name": "里程碑达成率",
