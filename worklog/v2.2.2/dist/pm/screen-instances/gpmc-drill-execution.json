    {
      "id": "drill-exec-detail-table",
      "type": "table",
      "name": "关键任务与节点明细",
      "x": 20,
      "y": 175,
      "width": 1145,
      "height": 420,
      "zIndex": 15,
      "locked": false,
      "visible": true,
      "config": {
        "columns": [
          {
            "key": "name",
            "title": "任务/节点",
            "width": 280
          },
          {
            "key": "project",
            "title": "所属项目",
            "width": 280
          },
          {
            "key": "progress",
            "title": "完成率",
            "width": 200
          },
          {
            "key": "risk",
            "title": "风险等级",
            "width": 200
          }
        ],
        "headerBg": "#dbe9f6",
        "bodyBg": "rgba(255, 255, 255, 0.98)",
        "evenRowBg": "rgba(241, 245, 249, 0.98)",
        "borderRadius": 12,
        "fontSize": 13,
        "showPagination": false
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    snapshot_level,\n    entity_id,\n    parent_id,\n    entity_name,\n    major_project_id,\n    major_project_name,\n    subproject_id,\n    subproject_name,\n    total_nodes,\n    completed_nodes,\n    overdue_open_nodes,\n    high_risk_nodes,\n    avg_health_score,\n    plan_start_date,\n    plan_end_date,\n    actual_end_date,\n    progress_rate,\n    sort_order,\n    node_id,\n    node_task,\n    node_type,\n    risk_level,\n    delay_days\nFROM biz_ads_major_project_tree_snapshot\nORDER BY major_project_id, sort_order",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000
        }
      }
    },
    {
      "id": "drill-exec-side-panel",
      "type": "table",
      "name": "资源负载摘要",
