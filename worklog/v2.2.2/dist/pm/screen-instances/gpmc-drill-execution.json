      "config": {
        "columns": [
          {
            "key": "name",
            "title": "项目",
            "width": 500
          },
          {
            "key": "delay",
            "title": "延期天数",
            "width": 300
          },
          {
            "key": "dept",
            "title": "责任科室",
            "width": 400
          },
          {
            "key": "risk",
            "title": "风险",
            "width": 300
          }
        ],
        "headerBg": "#dbe9f6",
        "bodyBg": "rgba(255, 255, 255, 0.98)",
        "evenRowBg": "rgba(241, 245, 249, 0.98)",
        "borderRadius": 12,
        "fontSize": 13,
        "showPagination": false
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    major_project_id,\n    major_project_name,\n    dept,\n    week_start_date,\n    plan_iso_week,\n    delay_reason_category,\n    delay_reason_label,\n    delayed_node_count,\n    high_risk_node_count,\n    delayed_subproject_count\nFROM biz_ads_delay_reason_trend\nORDER BY plan_iso_week DESC, delayed_node_count DESC",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000
