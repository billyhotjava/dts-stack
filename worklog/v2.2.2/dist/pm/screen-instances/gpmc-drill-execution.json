    {
      "key": "dateFrom",
      "label": "开始日期",
      "type": "date"
    },
    {
      "key": "dateTo",
      "label": "结束日期",
      "type": "date"
    },
    {
      "key": "projectNo",
      "label": "项目编号",
      "type": "string"
    },
    {
      "key": "deptId",
      "label": "事业部/科室",
      "type": "string"
    }
  ],
  "components": [
