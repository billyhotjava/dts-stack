    {
      "id": "drill-risk-detail-table",
      "type": "table",
      "name": "风险清单",
      "x": 20,
      "y": 175,
      "width": 1145,
      "height": 420,
      "zIndex": 15,
      "locked": false,
      "visible": true,
      "config": {
        "columns": [
          {
            "key": "name",
            "title": "风险",
            "width": 280
          },
          {
            "key": "project",
            "title": "项目",
            "width": 220
          },
          {
            "key": "level",
            "title": "等级",
            "width": 140
          },
          {
            "key": "status",
            "title": "状态",
            "width": 160
          },
          {
            "key": "days",
            "title": "滞留天数",
            "width": 140
          }
        ],
        "headerBg": "#dbe9f6",
        "bodyBg": "rgba(255, 255, 255, 0.98)",
        "evenRowBg": "rgba(241, 245, 249, 0.98)",
        "borderRadius": 12,
        "fontSize": 13,
        "showPagination": false
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    risk_id,\n    project_no,\n    risk_name,\n    risk_level,\n    risk_content,\n    impact_scope,\n    closure_status,\n    response_measure,\n    dept,\n    subsystem,\n    owner,\n    filled_by,\n    remark,\n    risk_rank,\n    is_closed,\n    risk_submit_date,\n    last_update_time,\n    submit_year,\n    submit_quarter,\n    submit_month,\n    pending_days,\n    source_table,\n    etl_time\nFROM biz_dwd_risk_info\nORDER BY risk_submit_date DESC NULLS LAST, risk_rank DESC",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000
        }
      }
    },
    {
      "id": "drill-risk-side-panel",
      "type": "table",
      "name": "风险分类摘要",
      "x": 1185,
      "y": 175,
      "width": 715,
      "height": 420,
      "zIndex": 15,
      "locked": false,
      "visible": true,
      "config": {
        "columns": [
          {
            "key": "name",
            "title": "分类",
            "width": 350
          },
          {
            "key": "value",
            "title": "数量",
            "width": 300
          }
        ],
        "headerBg": "#dbe9f6",
        "bodyBg": "rgba(255, 255, 255, 0.98)",
        "evenRowBg": "rgba(241, 245, 249, 0.98)",
        "borderRadius": 12,
        "fontSize": 13,
        "showPagination": false
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    period_year,\n    period_quarter,\n    period_month,\n    project_no,\n    dept,\n    total_risk_cnt,\n    high_risk_cnt,\n    mid_risk_cnt,\n    low_risk_cnt,\n    closed_cnt,\n    open_cnt,\n    closure_rate,\n    has_measure_cnt,\n    measure_coverage_rate,\n    avg_pending_days\nFROM biz_dws_risk_period_summary\nORDER BY period_year, period_month, project_no",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000
        }
      }
    },
    {
      "id": "drill-risk-support-table",
      "type": "table",
      "name": "风险措施摘要",
      "x": 20,
      "y": 610,
      "width": 1880,
      "height": 440,
      "zIndex": 15,
      "locked": false,
      "visible": true,
      "config": {
        "columns": [
          {
            "key": "project",
            "title": "项目",
            "width": 400
          },
          {
            "key": "name",
            "title": "风险",
            "width": 450
          },
          {
            "key": "measure",
            "title": "应对措施",
            "width": 500
          },
          {
            "key": "status",
            "title": "状态",
            "width": 300
          }
