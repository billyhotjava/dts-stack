        "headerBg": "#dbe9f6",
        "bodyBg": "rgba(255, 255, 255, 0.98)",
        "evenRowBg": "rgba(241, 245, 249, 0.98)",
        "borderRadius": 12,
        "fontSize": 13,
        "showPagination": false
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    measure_id,\n    risk_id_approx,\n    project_no,\n    risk_name,\n    measure_content,\n    measure_status,\n    responsible_person,\n    closure_deliverable,\n    filled_by,\n    deadline,\n    actual_complete_date,\n    last_update_time,\n    source_table,\n    etl_time\nFROM biz_dwd_risk_measure\nORDER BY deadline DESC NULLS LAST",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000
        }
      }
    }
