        "borderRadius": 12,
        "fontSize": 36
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT\n    period_year,\n    period_month,\n    total_risk_cnt,\n    high_risk_cnt,\n    mid_risk_cnt,\n    low_risk_cnt,\n    closed_cnt,\n    open_cnt,\n    closure_rate,\n    high_risk_project_cnt,\n    has_measure_cnt,\n    measure_coverage_rate,\n    avg_pending_days\nFROM biz_ads_risk_kpi\nORDER BY period_year, period_month",
          "queryTimeoutSeconds": 30,
          "maxRows": 2000
