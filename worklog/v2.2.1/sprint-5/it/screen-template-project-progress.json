{
  "schemaVersion": 2,
  "name": "项目进度分析作战台",
  "description": "基于项目主体域数据的进度分析看板，覆盖35个核心指标：节点完成率、超期分析、风险分布、里程碑跟踪",
  "width": 1920,
  "height": 1080,
  "backgroundColor": "#eef4fb",
  "theme": "glacier",
  "globalVariables": [
    { "key": "planYear", "label": "统计年份", "type": "string", "defaultValue": "2026", "description": "ADS 表 plan_year 筛选" },
    { "key": "planMonth", "label": "统计月份", "type": "string", "defaultValue": "", "description": "ADS 表 plan_month 筛选，空=全年" },
    { "key": "projectNo", "label": "项目编号", "type": "string", "defaultValue": "", "description": "按项目筛选" },
    { "key": "dateFrom", "label": "开始日期", "type": "date", "defaultValue": "2026-01-01", "description": "参数化查询起始日期" },
    { "key": "dateTo", "label": "结束日期", "type": "date", "defaultValue": "2026-03-31", "description": "参数化查询截止日期" }
  ],
  "components": [
    {
      "id": "pp-title",
      "type": "title",
      "name": "主标题",
      "x": 40, "y": 20, "width": 600, "height": 44, "zIndex": 40,
      "locked": false, "visible": true,
      "config": {
        "text": "项目进度分析作战台",
        "fontSize": 32,
        "fontWeight": "700",
        "color": "#0f172a",
        "textAlign": "flex-start"
      }
    },
    {
      "id": "pp-subtitle",
      "type": "title",
      "name": "副标题",
      "x": 40, "y": 60, "width": 800, "height": 28, "zIndex": 40,
      "locked": false, "visible": true,
      "config": {
        "text": "节点完成 · 超期分析 · 风险分布 · 里程碑跟踪",
        "fontSize": 14,
        "fontWeight": "400",
        "color": "#475569",
        "textAlign": "flex-start"
      }
    },
    {
      "id": "pp-filter-year",
      "type": "filter-select",
      "name": "年份筛选",
      "x": 980, "y": 24, "width": 150, "height": 64, "zIndex": 30,
      "locked": false, "visible": true,
      "config": {
        "label": "年份",
        "variableKey": "planYear",
        "options": ["2025", "2026", "2027"],
        "placeholder": "全部",
        "inputBackground": "#ffffff",
        "inputBorderColor": "rgba(148,163,184,0.28)",
        "inputTextColor": "#0f172a",
        "labelColor": "#475569"
      }
    },
    {
      "id": "pp-filter-project",
      "type": "filter-select",
      "name": "项目筛选",
      "x": 1145, "y": 24, "width": 170, "height": 64, "zIndex": 30,
      "locked": false, "visible": true,
      "config": {
        "label": "项目",
        "variableKey": "projectNo",
        "options": [],
        "placeholder": "全部项目",
        "inputBackground": "#ffffff",
        "inputBorderColor": "rgba(148,163,184,0.28)",
        "inputTextColor": "#0f172a",
        "labelColor": "#475569"
      }
    },
    {
      "id": "pp-filter-date",
      "type": "filter-date-range",
      "name": "日期范围",
      "x": 1330, "y": 24, "width": 280, "height": 64, "zIndex": 30,
      "locked": false, "visible": true,
      "config": {
        "label": "统计周期",
        "startKey": "dateFrom",
        "endKey": "dateTo",
        "inputBackground": "#ffffff",
        "inputBorderColor": "rgba(148,163,184,0.28)",
        "inputTextColor": "#0f172a",
        "labelColor": "#475569"
      }
    },
    {
      "id": "pp-datetime",
      "type": "datetime",
      "name": "当前时间",
      "x": 1700, "y": 30, "width": 200, "height": 40, "zIndex": 30,
      "locked": false, "visible": true,
      "config": {
        "format": "YYYY-MM-DD HH:mm:ss",
        "fontSize": 14,
        "color": "#475569"
      }
    },

    {
      "id": "pp-kpi-total",
      "type": "number-card",
      "name": "节点总数",
      "x": 40, "y": 110, "width": 175, "height": 100, "zIndex": 20,
      "locked": false, "visible": true,
      "config": {
        "title": "节点总数",
        "value": 35,
        "prefix": "", "suffix": "", "precision": 0,
        "titleColor": "#475569",
        "valueColor": "#2563eb",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT total_cnt AS value FROM biz_ads_project_kpi_overview WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) ORDER BY plan_month DESC LIMIT 1"
      }
    },
    {
      "id": "pp-kpi-on-time",
      "type": "number-card",
      "name": "按时完成",
      "x": 230, "y": 110, "width": 175, "height": 100, "zIndex": 20,
      "locked": false, "visible": true,
      "config": {
        "title": "按时完成",
        "value": 14,
        "prefix": "", "suffix": "", "precision": 0,
        "titleColor": "#475569",
        "valueColor": "#0f766e",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT on_time_cnt AS value FROM biz_ads_project_kpi_overview WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) ORDER BY plan_month DESC LIMIT 1"
      }
    },
    {
      "id": "pp-kpi-overdue-completed",
      "type": "number-card",
      "name": "超期完成",
      "x": 420, "y": 110, "width": 175, "height": 100, "zIndex": 20,
      "locked": false, "visible": true,
      "config": {
        "title": "超期完成",
        "value": 4,
        "prefix": "", "suffix": "", "precision": 0,
        "titleColor": "#475569",
        "valueColor": "#d97706",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT overdue_completed_cnt AS value FROM biz_ads_project_kpi_overview WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) ORDER BY plan_month DESC LIMIT 1"
      }
    },
    {
      "id": "pp-kpi-incomplete",
      "type": "number-card",
      "name": "未完成",
      "x": 610, "y": 110, "width": 175, "height": 100, "zIndex": 20,
      "locked": false, "visible": true,
      "config": {
        "title": "未完成",
        "value": 12,
        "prefix": "", "suffix": "", "precision": 0,
        "titleColor": "#475569",
        "valueColor": "#dc2626",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT incomplete_cnt AS value FROM biz_ads_project_kpi_overview WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) ORDER BY plan_month DESC LIMIT 1"
      }
    },
    {
      "id": "pp-kpi-completion-rate",
      "type": "number-card",
      "name": "完成率",
      "x": 800, "y": 110, "width": 175, "height": 100, "zIndex": 20,
      "locked": false, "visible": true,
      "config": {
        "title": "节点完成率",
        "value": 67.5,
        "prefix": "", "suffix": "%", "precision": 1,
        "titleColor": "#475569",
        "valueColor": "#2563eb",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT ROUND(completion_rate * 100, 1) AS value FROM biz_ads_project_kpi_overview WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) ORDER BY plan_month DESC LIMIT 1"
      }
    },
    {
      "id": "pp-kpi-high-risk",
      "type": "number-card",
      "name": "高风险未完成",
      "x": 990, "y": 110, "width": 175, "height": 100, "zIndex": 20,
      "locked": false, "visible": true,
      "config": {
        "title": "高风险未完成",
        "value": 5,
        "prefix": "", "suffix": "", "precision": 0,
        "titleColor": "#475569",
        "valueColor": "#dc2626",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT SUM(incomplete_high_risk_cnt) AS value FROM biz_ads_project_incomplete_risk WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}})"
      }
    },
    {
      "id": "pp-kpi-milestone-rate",
      "type": "number-card",
      "name": "里程碑完成率",
      "x": 1180, "y": 110, "width": 175, "height": 100, "zIndex": 20,
      "locked": false, "visible": true,
      "config": {
        "title": "里程碑完成率",
        "value": 60.0,
        "prefix": "", "suffix": "%", "precision": 1,
        "titleColor": "#475569",
        "valueColor": "#7c3aed",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT ROUND(milestone_completion_rate * 100, 1) AS value FROM biz_ads_project_milestone_kpi WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) ORDER BY plan_month DESC LIMIT 1"
      }
    },
    {
      "id": "pp-kpi-abnormal-rate",
      "type": "number-card",
      "name": "不正常率(除一般)",
      "x": 1370, "y": 110, "width": 175, "height": 100, "zIndex": 20,
      "locked": false, "visible": true,
      "config": {
        "title": "不正常率(除一般)",
        "value": 15.0,
        "prefix": "", "suffix": "%", "precision": 1,
        "titleColor": "#475569",
        "valueColor": "#d97706",
        "backgroundColor": "#ffffff"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT ROUND(abnormal_rate * 100, 1) AS value FROM biz_ads_project_non_general_kpi WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) ORDER BY plan_month DESC LIMIT 1"
      }
    },

    {
      "id": "pp-completion-trend",
      "type": "bar-chart",
      "name": "月度完成趋势",
      "x": 40, "y": 230, "width": 580, "height": 300, "zIndex": 15,
      "locked": false, "visible": true,
      "config": {
        "title": "月度节点完成趋势",
        "xAxisData": ["2026-01", "2026-02", "2026-03"],
        "series": [
          { "name": "按时完成", "data": [6, 2, 0] },
          { "name": "超期完成", "data": [0, 3, 0] },
          { "name": "未完成", "data": [0, 2, 5] }
        ],
        "seriesColors": ["#0f766e", "#d97706", "#dc2626"]
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT plan_month AS category, on_time_cnt AS \"按时完成\", overdue_completed_cnt AS \"超期完成\", incomplete_cnt AS \"未完成\" FROM biz_ads_project_kpi_overview WHERE plan_year = {{planYear}} ORDER BY plan_month"
      }
    },
    {
      "id": "pp-risk-pie",
      "type": "pie-chart",
      "name": "风险等级分布",
      "x": 640, "y": 230, "width": 330, "height": 300, "zIndex": 15,
      "locked": false, "visible": true,
      "config": {
        "title": "风险等级分布",
        "data": [
          { "name": "高风险", "value": 5 },
          { "name": "中风险", "value": 7 },
          { "name": "低风险", "value": 3 }
        ],
        "seriesColors": ["#dc2626", "#f59e0b", "#38bdf8"]
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT CASE WHEN risk_level='高' THEN '高风险' WHEN risk_level='中' THEN '中风险' ELSE '低风险' END AS name, SUM(total_cnt) AS value FROM biz_dws_period_risk_summary WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) GROUP BY risk_level ORDER BY CASE risk_level WHEN '高' THEN 1 WHEN '中' THEN 2 ELSE 3 END"
      }
    },
    {
      "id": "pp-node-type-bar",
      "type": "bar-chart",
      "name": "节点类型分布",
      "x": 990, "y": 230, "width": 440, "height": 300, "zIndex": 15,
      "locked": false, "visible": true,
      "config": {
        "title": "各类型节点完成情况",
        "xAxisData": ["一般节点", "重要节点", "重大节点", "里程碑节点"],
        "series": [
          { "name": "已完成", "data": [7, 4, 3, 3] },
          { "name": "未完成", "data": [2, 3, 3, 3] },
          { "name": "待完成", "data": [1, 1, 1, 1] }
        ],
        "seriesColors": ["#0f766e", "#dc2626", "#cbd5e1"]
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT node_type AS category, SUM(completed_cnt) AS \"已完成\", SUM(incomplete_cnt) AS \"未完成\", SUM(pending_normal_cnt) AS \"待完成\" FROM biz_dws_period_node_type_summary WHERE plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) GROUP BY node_type ORDER BY CASE node_type WHEN '一般节点' THEN 1 WHEN '重要节点' THEN 2 WHEN '重大节点' THEN 3 ELSE 4 END"
      }
    },
    {
      "id": "pp-milestone-progress",
      "type": "bar-chart",
      "name": "里程碑推进",
      "x": 1450, "y": 230, "width": 440, "height": 300, "zIndex": 15,
      "locked": false, "visible": true,
      "config": {
        "title": "里程碑节点月度推进",
        "xAxisData": ["2026-01", "2026-02", "2026-03"],
        "series": [
          { "name": "按时完成", "data": [1, 1, 0] },
          { "name": "超期完成", "data": [0, 1, 0] },
          { "name": "未完成", "data": [0, 0, 2] }
        ],
        "seriesColors": ["#2563eb", "#d97706", "#dc2626"]
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT plan_month AS category, milestone_on_time_cnt AS \"按时完成\", milestone_overdue_completed_cnt AS \"超期完成\", milestone_incomplete_cnt AS \"未完成\" FROM biz_ads_project_milestone_kpi WHERE plan_year = {{planYear}} ORDER BY plan_month"
      }
    },

    {
      "id": "pp-incomplete-risk-table",
      "type": "table",
      "name": "未完成节点风险明细",
      "x": 40, "y": 556, "width": 580, "height": 480, "zIndex": 15,
      "locked": false, "visible": true,
      "config": {
        "header": ["月份", "高风险", "中风险", "里程碑", "重大", "重要"],
        "data": [
          ["2026-02", 1, 0, 0, 0, 1],
          ["2026-03", 4, 2, 2, 2, 3]
        ],
        "fontSize": 12,
        "headerColor": "#0f172a",
        "headerBackground": "#dbeafe",
        "bodyColor": "#334155",
        "bodyBackground": "#ffffff",
        "oddRowBackground": "#ffffff",
        "evenRowBackground": "#f8fafc",
        "borderColor": "rgba(148,163,184,0.28)"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT plan_month AS \"月份\", incomplete_high_risk_cnt AS \"高风险\", incomplete_mid_risk_cnt AS \"中风险\", incomplete_milestone_cnt AS \"里程碑\", incomplete_major_cnt AS \"重大\", incomplete_important_cnt AS \"重要\" FROM biz_ads_project_incomplete_risk WHERE plan_year = {{planYear}} ORDER BY plan_month"
      }
    },
    {
      "id": "pp-non-general-table",
      "type": "table",
      "name": "除一般节点超期分析",
      "x": 640, "y": 556, "width": 580, "height": 480, "zIndex": 15,
      "locked": false, "visible": true,
      "config": {
        "header": ["月份", "不正常待变更", "超期未完成(未变更)", "超期未完成(已变更)", "超期已完成(未变更)", "不正常率%", "超期率%"],
        "data": [
          ["2026-02", 0, 1, 1, 1, "10.0", "20.0"],
          ["2026-03", 2, 2, 1, 0, "25.0", "18.8"]
        ],
        "fontSize": 12,
        "headerColor": "#0f172a",
        "headerBackground": "#dbeafe",
        "bodyColor": "#334155",
        "bodyBackground": "#ffffff",
        "oddRowBackground": "#ffffff",
        "evenRowBackground": "#f8fafc",
        "borderColor": "rgba(148,163,184,0.28)"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT plan_month AS \"月份\", abnormal_pending_cnt AS \"不正常待变更\", overdue_incomplete_unchanged_cnt AS \"超期未完成(未变更)\", overdue_incomplete_changed_cnt AS \"超期未完成(已变更)\", overdue_completed_unchanged_cnt AS \"超期已完成(未变更)\", ROUND(abnormal_rate*100,1)||'' AS \"不正常率%\", ROUND(overdue_rate*100,1)||'' AS \"超期率%\" FROM biz_ads_project_non_general_kpi WHERE plan_year = {{planYear}} ORDER BY plan_month"
      }
    },
    {
      "id": "pp-detail-table",
      "type": "table",
      "name": "未完成节点明细",
      "x": 1240, "y": 556, "width": 650, "height": 480, "zIndex": 15,
      "locked": false, "visible": true,
      "config": {
        "header": ["项目", "节点任务", "计划时间", "节点类型", "风险", "完成情况", "责任人"],
        "data": [
          ["PRJ-A", "系统联调", "2026-03-05", "重大节点", "高", "不正常待变更", "王五"],
          ["PRJ-A", "软件适配", "2026-02-28", "重要节点", "高", "超期未完成未变更", "赵六"],
          ["PRJ-D", "验收评审", "2026-03-08", "里程碑节点", "高", "超期未完成未变更", "冯十二"]
        ],
        "fontSize": 12,
        "headerColor": "#0f172a",
        "headerBackground": "#dbeafe",
        "bodyColor": "#334155",
        "bodyBackground": "#ffffff",
        "oddRowBackground": "#ffffff",
        "evenRowBackground": "#f8fafc",
        "borderColor": "rgba(148,163,184,0.28)"
      },
      "dataSource": {
        "type": "sql",
        "query": "SELECT project_no AS \"项目\", node_task AS \"节点任务\", plan_date::text AS \"计划时间\", node_type AS \"节点类型\", COALESCE(risk_level,'—') AS \"风险\", completion_status AS \"完成情况\", owner AS \"责任人\" FROM biz_dwd_project_node WHERE is_incomplete = true AND plan_year = {{planYear}} AND ({{planMonth}} = '' OR plan_month = {{planMonth}}) ORDER BY CASE risk_level WHEN '高' THEN 1 WHEN '中' THEN 2 ELSE 3 END, plan_date"
      }
    }
  ]
}
