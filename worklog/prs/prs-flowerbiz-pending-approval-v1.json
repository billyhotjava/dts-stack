    {
      "id": "kpi-1",
      "type": "number-card",
      "name": "在途单数",
      "x": 44,
      "y": 112,
      "width": 280,
      "height": 104,
      "zIndex": 25,
      "locked": false,
      "visible": true,
      "config": {
        "title": "在途单数",
        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 16,
        "valueFontSize": 34,
        "titleColor": "#e2ffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "valueField": "在途单数"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COUNT(*) AS \"在途单数\", COUNT(*) FILTER (WHERE p.\"是否超期\") AS \"超期单数\", COUNT(*) FILTER (WHERE p.\"状态\"='待结算') AS \"待结算\", COUNT(*) FILTER (WHERE p.\"状态\"='审核中') AS \"审核中\", ROUND(AVG(p.\"已挂起天数\")::numeric,1) AS \"平均挂起天数\", ROUND(SUM(COALESCE(p.\"租金净额\",0)+COALESCE(p.\"销售金额\",0)+COALESCE(p.\"额外费用\",0))::numeric,2) AS \"在途金额\" FROM public.xycyl_ads_flowerbiz_pending p WHERE p.\"业务时间\" >= {{dateFrom}}::date AND p.\"业务时间\" <= {{dateTo}}::date [[AND p.\"项目\" = {{projectName}}]] [[AND p.\"状态\" = {{statusName}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "projectName",
              "variableKey": "projectName"
            },
            {
              "name": "statusName",
              "variableKey": "statusName"
            }
          ]
        }
      }
    },
