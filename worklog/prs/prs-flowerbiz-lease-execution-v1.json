    {
      "id": "kpi-1",
      "type": "number-card",
      "name": "租赁单数",
      "x": 44,
      "y": 112,
      "width": 280,
      "height": 104,
      "zIndex": 25,
      "locked": false,
      "visible": true,
      "config": {
        "title": "租赁单数",
        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 16,
        "valueFontSize": 34,
        "titleColor": "#e2ffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "valueField": "租赁单数"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT SUM(s.\"报花单数\") AS \"租赁单数\", SUM(s.\"加摆单数\") AS \"加摆单数\", SUM(s.\"撤摆单数\") AS \"撤摆单数\", SUM(s.\"换花单数\") AS \"换花单数\", SUM(s.\"调花单数\") AS \"调花单数\", ROUND(SUM(s.\"租金净额全口径\")::numeric,2) AS \"租金净额\" FROM public.xycyl_ads_flowerbiz_lease_summary s WHERE s.\"业务月份\" >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.\"业务月份\" <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.\"项目\" = {{projectName}}]] [[AND s.\"客户\" = {{customerName}}]] AND s.\"业务大类\" = 'lease'",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "projectName",
              "variableKey": "projectName"
            },
            {
              "name": "customerName",
              "variableKey": "customerName"
            }
          ]
        }
      }
    },
