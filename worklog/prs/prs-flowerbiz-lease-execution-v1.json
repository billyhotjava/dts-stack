        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT DISTINCT project_name AS label, project_name AS value FROM public.xycyl_dwd_flowerbiz_main WHERE project_name IS NOT NULL AND project_name <> '' ORDER BY project_name",
