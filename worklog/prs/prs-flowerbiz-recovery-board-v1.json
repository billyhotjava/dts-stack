    {
      "id": "kpi-1",
      "type": "number-card",
      "name": "回收明细数",
      "x": 44,
      "y": 112,
      "width": 280,
      "height": 104,
      "zIndex": 25,
      "locked": false,
      "visible": true,
      "config": {
        "title": "回收明细数",
        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 16,
        "valueFontSize": 34,
        "titleColor": "#e2ffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "valueField": "回收明细数"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COUNT(*) AS \"回收明细数\", SUM(r.\"实际或计划回收数\") AS \"回收数量\", ROUND(SUM(r.\"回收成本金额\")::numeric,2) AS \"回收成本\", COUNT(*) FILTER (WHERE r.\"是否报损\") AS \"报损条数\", COUNT(*) FILTER (WHERE r.\"是否回购\") AS \"回购条数\", COUNT(*) FILTER (WHERE r.\"是否留用\") AS \"留用条数\" FROM public.xycyl_ads_flowerbiz_recovery_detail r WHERE r.\"业务时间\" >= {{dateFrom}}::date AND r.\"业务时间\" <= {{dateTo}}::date [[AND r.\"项目\" = {{projectName}}]] [[AND r.\"回收类型\" = {{recoveryType}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "projectName",
              "variableKey": "projectName"
            },
