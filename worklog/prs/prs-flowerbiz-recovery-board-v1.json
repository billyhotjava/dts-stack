        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT DISTINCT \"回收类型\" AS label, \"回收类型\" AS value FROM public.xycyl_ads_flowerbiz_recovery_detail WHERE \"回收类型\" IS NOT NULL AND \"回收类型\" <> '' ORDER BY \"回收类型\"",
