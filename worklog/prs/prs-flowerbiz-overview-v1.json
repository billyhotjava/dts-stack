          "query": "SELECT s.\"业务月份\", SUM(s.\"报花单数\") AS \"报花单数\", ROUND(SUM(s.\"租金净额全口径\")::numeric,2) AS \"租金净额\", ROUND(SUM(s.\"处理成本全口径\")::numeric,2) AS \"处理成本\" FROM public.xycyl_ads_flowerbiz_lease_summary s WHERE s.\"业务月份\" >= to_char({{dateFrom}}::date,'YYYY-MM') AND s.\"业务月份\" <= to_char({{dateTo}}::date,'YYYY-MM') [[AND s.\"项目\" = {{projectName}}]] [[AND s.\"客户\" = {{customerName}}]] GROUP BY s.\"业务月份\" ORDER BY s.\"业务月份\"",
