    {
      "id": "kpi-1",
      "type": "number-card",
      "name": "报花单数",
      "x": 44,
      "y": 112,
      "width": 280,
      "height": 104,
      "zIndex": 25,
      "locked": false,
      "visible": true,
      "config": {
        "title": "报花单数",
        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 16,
        "valueFontSize": 34,
        "titleColor": "#e2ffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "valueField": "报花单数"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COUNT(*) AS \"报花单数\", COUNT(DISTINCT m.project_id) AS \"项目数\", COUNT(DISTINCT m.customer_name) AS \"客户数\", COUNT(*) FILTER (WHERE m.is_in_progress) AS \"在途单数\", ROUND(SUM(m.rent_amount)::numeric,2) AS \"租金净额\", ROUND(SUM(m.cost_amount)::numeric,2) AS \"处理成本\" FROM public.xycyl_dwd_flowerbiz_main m WHERE m.business_date >= {{dateFrom}}::date AND m.business_date <= {{dateTo}}::date [[AND m.project_name = {{projectName}}]] [[AND m.customer_name = {{customerName}}]] [[AND m.biz_category = {{bizCategory}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
