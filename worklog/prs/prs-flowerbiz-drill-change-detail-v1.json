        "backgroundColor": "transparent",
        "valueField": "变更数"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COUNT(*) AS \"变更数\", ROUND(SUM(c.\"金额差额\")::numeric,2) AS \"金额差额\", ROUND(AVG(c.\"确认耗时天数\")::numeric,2) AS \"平均确认耗时\", COUNT(*) FILTER (WHERE COALESCE(c.\"起租期变化天数\",0) <> 0) AS \"起租变化数\" FROM public.xycyl_ads_flowerbiz_change_log c WHERE c.\"申请时间\" >= {{dateFrom}}::date AND c.\"申请时间\" <= {{dateTo}}::date [[AND c.\"项目\" = {{projectName}}]] [[AND c.\"变更类型\" = {{changeType}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
