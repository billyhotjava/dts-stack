    {
      "id": "kpi-1",
      "type": "number-card",
      "name": "养护人数",
      "x": 44,
      "y": 112,
      "width": 280,
      "height": 104,
      "zIndex": 25,
      "locked": false,
      "visible": true,
      "config": {
        "title": "养护人数",
        "value": 0,
        "suffix": "",
        "precision": 0,
        "titleFontSize": 16,
        "valueFontSize": 34,
        "titleColor": "#e2ffff",
        "valueColor": "#ffffff",
        "backgroundColor": "transparent",
        "valueField": "养护人数"
      },
      "dataSource": {
        "type": "sql",
        "sqlConfig": {
          "databaseId": "{{DATABASE_ID}}",
          "query": "SELECT COUNT(DISTINCT c.\"养护人\") AS \"养护人数\", SUM(c.\"经手单数\") AS \"经手单数\", SUM(c.\"已结束单数\") AS \"已结束单数\", SUM(c.\"在途单数\") AS \"在途单数\", SUM(c.\"租赁单数\") AS \"租赁单数\", SUM(c.\"销售单数\") AS \"销售单数\" FROM public.xycyl_ads_flowerbiz_curing_workload c WHERE c.\"业务月份\" >= to_char({{dateFrom}}::date,'YYYY-MM') AND c.\"业务月份\" <= to_char({{dateTo}}::date,'YYYY-MM') [[AND c.\"养护人\" = {{curingUser}}]] [[AND c.\"业务大类\" = {{bizCategory}}]]",
          "queryTimeoutSeconds": 30,
          "maxRows": 1,
          "parameterBindings": [
            {
              "name": "dateFrom",
              "variableKey": "dateFrom"
            },
            {
              "name": "dateTo",
              "variableKey": "dateTo"
            },
            {
              "name": "bizCategory",
              "variableKey": "bizCategory"
            },
