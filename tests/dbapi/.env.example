# Do not commit .env or secret files. Secret paths must be absolute host paths outside this repository.
DB_HOST=mysql_api_db
DB_PORT=3306
DB_NAME=dts_pjm_test
DB_USER=dts_pjm_reader
DB_PASSWORD_FILE=/absolute/path/to/mysql-password
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=10
DB_WRITE_TIMEOUT=10
DBAPI_API_KEY_FILE=/absolute/path/to/dbapi-api-key
DBAPI_MAX_ROWS=100
DBAPI_MAX_PAGE_SIZE=100
DBAPI_BIND_ADDRESS=127.0.0.1
DBAPI_EXTERNAL_PORT=8081
MYSQL_DOCKER_NETWORK=mysql_api_app_mysql_api_network
