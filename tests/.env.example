# Shared auth/bootstrap defaults
DTS_IT_ADMIN_USER=sysadmin
# DTS_IT_ADMIN_PASS=sa
DTS_IT_PLATFORM_USER=opadmin
# DTS_IT_PLATFORM_PASS=sa

# Optional token fallback when password login is unavailable
# DTS_ADMIN_AUTH_TOKEN=<admin-bearer-token>
# DTS_PLATFORM_AUTH_TOKEN=<platform-bearer-token>

# Mock-first local auth server
DTS_WEB_E2E_USE_TEST_SERVER=1
DTS_WEB_E2E_DEV_SERVER_PORT=19333
# DTS_AUTH_GATEWAY_URL=http://127.0.0.1:19333

# Platform app
# DTS_WEB_E2E_WITH_PLATFORM_DEV_SERVER=1
# DTS_WEB_E2E_PLATFORM_DEV_SERVER_PORT=19334
# DTS_PLATFORM_URL=http://127.0.0.1:19334/expert/
# DTS_BASE_URL=http://127.0.0.1:19334/expert/
# DTS_EXPERT_URL=http://127.0.0.1:19334/expert/

# Analytics app (customer/2.2.1 points to source/dts-analytics-webapp/modern)
# DTS_WEB_E2E_WITH_ANALYTICS_DEV_SERVER=1
# DTS_WEB_E2E_ANALYTICS_DEV_SERVER_PORT=19335
# DTS_ANALYTICS_URL=http://127.0.0.1:19335/analytics/

# Admin app
# DTS_WEB_E2E_WITH_ADMIN_DEV_SERVER=1
# DTS_WEB_E2E_ADMIN_DEV_SERVER_PORT=19336
# DTS_ADMIN_URL=http://127.0.0.1:19336/admin/

# Force password-login flows instead of token bootstrap
# DTS_PLATFORM_REQUIRE_PASSWORD_LOGIN=1
# DTS_ADMIN_REQUIRE_PASSWORD_LOGIN=1

# Artifact directories
# DTS_WEB_E2E_HTML_REPORT_DIR=reports/html
# DTS_WEB_E2E_ARTIFACTS_DIR=reports/artifacts
