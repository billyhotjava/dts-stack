#!/usr/bin/env bash
# =============================================================================
# dts-pack — Package dbt models into a self-contained ZIP for offline deployment
#
# Usage:
#   dts-pack --config <deploy.conf> [--output <dir>] [--name <filename>]
#   dts-pack --manifest <models.tsv> [--output <dir>] [--name <filename>]
#
# The ZIP contains:
#   deploy.conf      — Plan metadata (if --config mode)
#   models.tsv       — Model manifest
#   *.sql            — All referenced SQL files (flattened)
#   extras/          — Extra files (seed SQL, screen templates, etc.)
#
# Environment:
#   DBT_ROOT  — Override dbt project root (default: $PROJECT_ROOT/services/dts-dbt)
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/dts-common.sh"

PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
DBT_ROOT="${DBT_ROOT:-${PROJECT_ROOT}/services/dts-dbt}"

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
  cat <<'EOF'
Usage:
  dts-pack --config <deploy.conf> [OPTIONS]
  dts-pack --manifest <models.tsv> [OPTIONS]

Options:
  --config <path>     Deploy config file (includes manifest path)
  --manifest <path>   TSV manifest (direct mode, no deploy.conf in ZIP)
  --output <dir>      Output directory (default: current directory)
  --name <filename>   ZIP filename (default: auto-generated from config)
  --extras <glob>     Extra files to include (repeatable, relative to config dir)
  --include-seeds     Include seed-*.sql and validate-*.sql from config dir
  --dry-run           Show what would be packaged without creating ZIP

Examples:
  # Package from deploy config
  dts-pack --config services/dts-dbt/deploy/project-progress/deploy.conf \
           --output worklog/v2.2.1/sprint-5/dist/ --include-seeds

  # Package from manifest only
  dts-pack --manifest path/to/models.tsv --output dist/
EOF
  exit "${1:-0}"
}

# ---------------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------------
CONFIG_FILE=""
MANIFEST_PATH=""
OUTPUT_DIR="."
ZIP_NAME=""
EXTRA_PATTERNS=()
INCLUDE_SEEDS=false
DRY_RUN=false

# Config-file sourced variables
PLAN_NAME=""
PLAN_DOMAIN=""

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
[[ $# -eq 0 ]] && usage 1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)        CONFIG_FILE="$2";   shift 2 ;;
    --manifest)      MANIFEST_PATH="$2"; shift 2 ;;
    --output)        OUTPUT_DIR="$2";    shift 2 ;;
    --name)          ZIP_NAME="$2";      shift 2 ;;
    --extras)        EXTRA_PATTERNS+=("$2"); shift 2 ;;
    --include-seeds) INCLUDE_SEEDS=true; shift ;;
    --dry-run)       DRY_RUN=true;       shift ;;
    -h|--help|help)  usage 0 ;;
    *)               die "unknown option '$1'. Use 'dts-pack --help' for usage." ;;
  esac
done

# ---------------------------------------------------------------------------
# Load config / resolve paths
# ---------------------------------------------------------------------------
CONF_DIR=""

if [[ -n "$CONFIG_FILE" ]]; then
  [[ -f "$CONFIG_FILE" ]] || die "config file not found: $CONFIG_FILE"
  CONF_DIR="$(cd "$(dirname "$CONFIG_FILE")" && pwd)"
  CONFIG_FILE="$(cd "$(dirname "$CONFIG_FILE")" && pwd)/$(basename "$CONFIG_FILE")"

  # Source config to get PLAN_NAME, MANIFEST_PATH, etc.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"

  # Resolve MANIFEST_PATH relative to config dir
  if [[ -n "$MANIFEST_PATH" && "$MANIFEST_PATH" != /* ]]; then
    MANIFEST_PATH="${CONF_DIR}/${MANIFEST_PATH}"
  fi
fi

# Resolve MANIFEST_PATH if relative
if [[ -n "$MANIFEST_PATH" && "$MANIFEST_PATH" != /* ]]; then
  MANIFEST_PATH="$(cd "$(dirname "$MANIFEST_PATH")" && pwd)/$(basename "$MANIFEST_PATH")"
fi

[[ -n "$MANIFEST_PATH" ]] || die "--manifest (or MANIFEST_PATH in config) is required"
[[ -f "$MANIFEST_PATH" ]] || die "manifest not found: $MANIFEST_PATH"

# Resolve OUTPUT_DIR
if [[ "$OUTPUT_DIR" != /* ]]; then
  OUTPUT_DIR="$(pwd)/${OUTPUT_DIR}"
fi

# ---------------------------------------------------------------------------
# Generate ZIP filename
# ---------------------------------------------------------------------------
if [[ -z "$ZIP_NAME" ]]; then
  local_name="${PLAN_NAME:-models}"
  # Sanitize: replace non-alphanumeric (except hyphen/underscore) with hyphen
  local_name="$(echo "$local_name" | sed 's/[^a-zA-Z0-9_-]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//')"
  # If name is empty after sanitization (e.g. all Chinese chars), use domain or 'models'
  if [[ -z "$local_name" ]]; then
    local_name="${PLAN_DOMAIN:-models}"
  fi
  ZIP_NAME="${local_name}-$(date +%Y%m%d).zip"
fi

# Ensure .zip extension
[[ "$ZIP_NAME" == *.zip ]] || ZIP_NAME="${ZIP_NAME}.zip"

# ---------------------------------------------------------------------------
# Collect SQL files referenced in TSV
# ---------------------------------------------------------------------------
declare -a SQL_FILES=()
declare -a MISSING_FILES=()

info "Reading manifest: $MANIFEST_PATH"

line_num=0
while IFS=$'\t' read -r name layer sql_path rest; do
  line_num=$((line_num + 1))
  # Skip header
  [[ "$name" == "name" ]] && continue
  # Skip empty lines
  [[ -z "$name" ]] && continue

  if [[ -z "$sql_path" ]]; then
    warn "line $line_num: model '$name' has no sql_path, skipping"
    continue
  fi

  # Resolve SQL file path
  resolved=""
  for candidate in \
    "${DBT_ROOT}/${sql_path}" \
    "${CONF_DIR:+${CONF_DIR}/${sql_path}}" \
    "${sql_path}"; do
    [[ -z "$candidate" ]] && continue
    if [[ -f "$candidate" ]]; then
      resolved="$candidate"
      break
    fi
  done

  if [[ -z "$resolved" ]]; then
    MISSING_FILES+=("$sql_path")
    warn "line $line_num: SQL file not found: $sql_path"
  else
    SQL_FILES+=("$resolved")
  fi
done < "$MANIFEST_PATH"

model_count=${#SQL_FILES[@]}
missing_count=${#MISSING_FILES[@]}

info "Found $model_count SQL files ($missing_count missing)"

if [[ $model_count -eq 0 ]]; then
  die "no SQL files found — nothing to package"
fi

if [[ $missing_count -gt 0 ]]; then
  warn "Missing files will be skipped in the ZIP"
fi

# ---------------------------------------------------------------------------
# Collect extra files
# ---------------------------------------------------------------------------
declare -a EXTRA_FILES=()

if [[ -n "$CONF_DIR" ]]; then
  # Auto-include seeds and validators if requested
  if $INCLUDE_SEEDS; then
    for f in "$CONF_DIR"/seed-*.sql "$CONF_DIR"/validate-*.sql "$CONF_DIR"/screen-template-*.json; do
      [[ -f "$f" ]] && EXTRA_FILES+=("$f")
    done
  fi

  # User-specified extras
  for pattern in "${EXTRA_PATTERNS[@]+"${EXTRA_PATTERNS[@]}"}"; do
    for f in ${CONF_DIR}/${pattern}; do
      [[ -f "$f" ]] && EXTRA_FILES+=("$f")
    done
  done
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
info ""
info "=== dts-pack ==="
info "  manifest  : $MANIFEST_PATH"
[[ -n "$CONFIG_FILE" ]] && info "  config    : $CONFIG_FILE"
info "  models    : $model_count SQL files"
[[ ${#EXTRA_FILES[@]} -gt 0 ]] && info "  extras    : ${#EXTRA_FILES[@]} files"
info "  output    : ${OUTPUT_DIR}/${ZIP_NAME}"
info ""

if $DRY_RUN; then
  info "[dry-run] Files that would be included:"
  info "  models.tsv"
  [[ -n "$CONFIG_FILE" ]] && info "  deploy.conf"
  for f in "${SQL_FILES[@]}"; do
    info "  $(basename "$f")"
  done
  for f in "${EXTRA_FILES[@]}"; do
    info "  extras/$(basename "$f")"
  done
  green "[$CALLER_NAME] Dry run complete — $model_count models would be packaged"
  exit 0
fi

# ---------------------------------------------------------------------------
# Create ZIP
# ---------------------------------------------------------------------------
mkdir -p "$OUTPUT_DIR"

TMPDIR_PACK="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_PACK"' EXIT

# Copy manifest
cp "$MANIFEST_PATH" "${TMPDIR_PACK}/models.tsv"

# Copy deploy.conf if config mode
if [[ -n "$CONFIG_FILE" ]]; then
  cp "$CONFIG_FILE" "${TMPDIR_PACK}/deploy.conf"
fi

# Copy SQL files (flattened to root)
for f in "${SQL_FILES[@]}"; do
  cp "$f" "${TMPDIR_PACK}/$(basename "$f")"
done

# Copy extras to extras/ subdirectory
if [[ ${#EXTRA_FILES[@]} -gt 0 ]]; then
  mkdir -p "${TMPDIR_PACK}/extras"
  for f in "${EXTRA_FILES[@]}"; do
    cp "$f" "${TMPDIR_PACK}/extras/$(basename "$f")"
  done
fi

# Create ZIP
ZIP_OUTPUT="${OUTPUT_DIR}/${ZIP_NAME}"
(cd "$TMPDIR_PACK" && zip -q -r "${ZIP_OUTPUT}" .)

# Report
ZIP_SIZE="$(du -h "$ZIP_OUTPUT" | cut -f1)"
info ""
green "[$CALLER_NAME] Package created: ${ZIP_OUTPUT} (${ZIP_SIZE})"
info "Contents:"
(cd "$TMPDIR_PACK" && find . -type f | sort | sed 's|^\./|  |')
info ""
info "Deploy with:"
info "  # Via batch-import API (upload ZIP through UI or curl)"
info "  # Via dts-deploy --package ${ZIP_OUTPUT}"
