#!/usr/bin/env bash
# =============================================================================
# dts-deploy — Orchestrator: create a Plan then import dbt models
#
# Usage:
#   dts-deploy --config <deploy.conf>                    (config-file mode)
#   dts-deploy --plan-name NAME --manifest <models.tsv>  (direct-params mode)
#   dts-deploy --package <zip-file>                      (package mode)
#
# Environment:
#   API_BASE               — Platform base URL (required)
#   TOKEN                  — Bearer token (required)
#   SOURCE_DATA_SOURCE_ID  — Default source data-source UUID (required)
#   ACTIVE_DEPT            — Department header (optional)
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/dts-common.sh"

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
  cat <<'EOF'
Usage:
  dts-deploy --config <deploy.conf>   [pass-through flags]
  dts-deploy --plan-name NAME --manifest <models.tsv> [OPTIONS] [pass-through flags]
  dts-deploy --package <zip-file> [OPTIONS] [pass-through flags]

Config-file mode:
  --config <path>     Path to a bash-sourceable deploy.conf

Direct-params mode:
  --plan-name <name>  Plan name (required unless --plan-id)
  --manifest <path>   TSV manifest path (required)
  --domain <domain>   Plan domain (optional)
  --scope <scope>     Plan scope (optional)
  --tags <tags>       Plan tags (optional)
  --content <text>    Plan content (optional)

Package mode (deploy from dts-pack ZIP):
  --package <zip>     ZIP file created by dts-pack

Plan targeting:
  --plan-id <uuid>    Import into an existing Plan (skip Plan creation)

Authentication:
  --user <username>   Login username (default: prompted or DTS_USERNAME env)
  --password <pass>   Login password (default: prompted or DTS_PASSWORD env)

Execution flags:
  --run               After import, trigger dbt run to build tables
  --run-selector TAG  dbt selector for run (default: uses PLAN_TAGS or 'all')

Pass-through flags (forwarded to dts-plan and dts-dbt-import):
  --dry-run           Validate only, no API calls
  --insecure          Skip TLS cert verification
  --skip-existing     Skip models that already exist
  --show-response     Print API response bodies

Environment variables:
  API_BASE               Platform base URL (required)
  TOKEN                  Bearer token (required)
  SOURCE_DATA_SOURCE_ID  Default source data-source UUID (required)
  ACTIVE_DEPT            Department header (optional)
EOF
  exit "${1:-0}"
}

# ---------------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------------
CONFIG_FILE=""
PACKAGE_FILE=""
PLAN_NAME="${PLAN_NAME:-}"
PLAN_DOMAIN="${PLAN_DOMAIN:-}"
PLAN_SCOPE="${PLAN_SCOPE:-}"
PLAN_TAGS="${PLAN_TAGS:-}"
PLAN_CONTENT="${PLAN_CONTENT:-}"
MANIFEST_PATH="${MANIFEST_PATH:-}"
PLAN_ID="${PLAN_ID:-}"

# Execution flags
RUN_AFTER_IMPORT=false
RUN_SELECTOR=""

# Pass-through flags
PT_DRY_RUN=false
PT_INSECURE=false
PT_SKIP_EXISTING=false
PT_SHOW_RESPONSE=false

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------
[[ $# -eq 0 ]] && usage 1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --config)         CONFIG_FILE="$2"; shift 2 ;;
    --package)        PACKAGE_FILE="$2"; shift 2 ;;
    --plan-name)      PLAN_NAME="$2"; shift 2 ;;
    --plan-id)        PLAN_ID="$2"; shift 2 ;;
    --manifest)       MANIFEST_PATH="$2"; shift 2 ;;
    --domain)         PLAN_DOMAIN="$2"; shift 2 ;;
    --scope)          PLAN_SCOPE="$2"; shift 2 ;;
    --tags)           PLAN_TAGS="$2"; shift 2 ;;
    --content)        PLAN_CONTENT="$2"; shift 2 ;;
    --run)            RUN_AFTER_IMPORT=true; shift ;;
    --run-selector)   RUN_AFTER_IMPORT=true; RUN_SELECTOR="$2"; shift 2 ;;
    --user)           export DTS_USERNAME="$2"; shift 2 ;;
    --password)       export DTS_PASSWORD="$2"; shift 2 ;;
    --dry-run)        PT_DRY_RUN=true; shift ;;
    --insecure)       PT_INSECURE=true; shift ;;
    --skip-existing)  PT_SKIP_EXISTING=true; shift ;;
    --show-response)  PT_SHOW_RESPONSE=true; shift ;;
    -h|--help|help)   usage 0 ;;
    *)                die "unknown option '$1'. Use 'dts-deploy --help' for usage." ;;
  esac
done

# ---------------------------------------------------------------------------
# Load config file (if provided)
# ---------------------------------------------------------------------------
if [[ -n "$CONFIG_FILE" ]]; then
  [[ -f "$CONFIG_FILE" ]] || die "config file not found: $CONFIG_FILE"
  info "Loading config: $CONFIG_FILE"

  CONF_DIR="$(cd "$(dirname "$CONFIG_FILE")" && pwd)"

  # Source the config — it may set PLAN_NAME, PLAN_DOMAIN, etc.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"

  # Resolve MANIFEST_PATH relative to the config file's directory
  if [[ -n "$MANIFEST_PATH" && "$MANIFEST_PATH" != /* ]]; then
    MANIFEST_PATH="${CONF_DIR}/${MANIFEST_PATH}"
  fi
fi

# ---------------------------------------------------------------------------
# Package mode: extract ZIP to temp directory, source deploy.conf if present
# ---------------------------------------------------------------------------
_PACKAGE_TMPDIR=""
if [[ -n "$PACKAGE_FILE" ]]; then
  [[ -f "$PACKAGE_FILE" ]] || die "package file not found: $PACKAGE_FILE"
  _PACKAGE_TMPDIR="$(mktemp -d)"
  trap 'rm -rf "$_PACKAGE_TMPDIR"' EXIT

  info "Extracting package: $PACKAGE_FILE"
  unzip -q "$PACKAGE_FILE" -d "$_PACKAGE_TMPDIR"

  # Source deploy.conf from package for Plan metadata (name, domain, etc.)
  # but clear MANIFEST_PATH first — the package has its own models.tsv at root
  _SAVED_MANIFEST="${MANIFEST_PATH:-}"
  if [[ -z "$CONFIG_FILE" && -f "${_PACKAGE_TMPDIR}/deploy.conf" ]]; then
    CONF_DIR="$_PACKAGE_TMPDIR"
    # shellcheck disable=SC1090
    source "${_PACKAGE_TMPDIR}/deploy.conf"
  fi

  # Package always uses its own models.tsv (overrides whatever deploy.conf set)
  if [[ -f "${_PACKAGE_TMPDIR}/models.tsv" ]]; then
    MANIFEST_PATH="${_PACKAGE_TMPDIR}/models.tsv"
  elif [[ -n "$_SAVED_MANIFEST" ]]; then
    MANIFEST_PATH="$_SAVED_MANIFEST"
  fi

  # Set SQL_BASE_DIR so dts-dbt-import finds SQL files in the extracted dir
  export SQL_BASE_DIR="$_PACKAGE_TMPDIR"
fi

# ---------------------------------------------------------------------------
# Resolve MANIFEST_PATH relative to cwd (for direct-params mode)
# ---------------------------------------------------------------------------
if [[ -n "$MANIFEST_PATH" && "$MANIFEST_PATH" != /* ]]; then
  MANIFEST_PATH="$(cd "$(dirname "$MANIFEST_PATH")" && pwd)/$(basename "$MANIFEST_PATH")"
fi

# ---------------------------------------------------------------------------
# Auto-login if TOKEN not set
# ---------------------------------------------------------------------------
if [[ -z "${TOKEN:-}" && -f "${SCRIPT_DIR}/dts-deploy-env.sh" ]]; then
  info "Authenticating..."
  source "${SCRIPT_DIR}/dts-deploy-env.sh"
fi

# ---------------------------------------------------------------------------
# Validate required variables
# ---------------------------------------------------------------------------
require_env API_BASE TOKEN SOURCE_DATA_SOURCE_ID
if [[ -z "$PLAN_ID" ]]; then
  [[ -n "$PLAN_NAME" ]]  || die "--plan-name, --plan-id, or PLAN_NAME in config is required"
fi
[[ -n "$MANIFEST_PATH" ]] || die "--manifest (or MANIFEST_PATH in config) is required"
[[ -f "$MANIFEST_PATH" ]] || die "manifest not found: $MANIFEST_PATH"

# ---------------------------------------------------------------------------
# Build pass-through flag arrays
# ---------------------------------------------------------------------------
PLAN_PT_FLAGS=()
IMPORT_PT_FLAGS=()

if $PT_DRY_RUN; then
  PLAN_PT_FLAGS+=(--dry-run)
  IMPORT_PT_FLAGS+=(--dry-run)
fi
if $PT_INSECURE; then
  PLAN_PT_FLAGS+=(--insecure)
  IMPORT_PT_FLAGS+=(--insecure)
fi
if $PT_SKIP_EXISTING; then
  IMPORT_PT_FLAGS+=(--skip-existing)
fi
if $PT_SHOW_RESPONSE; then
  IMPORT_PT_FLAGS+=(--show-response)
fi

# ---------------------------------------------------------------------------
# Print deploy summary
# ---------------------------------------------------------------------------
info "=== dts-deploy ==="
[[ -n "$PACKAGE_FILE" ]] && info "  package   : $PACKAGE_FILE"
[[ -n "$PLAN_ID" ]]      && info "  plan_id   : $PLAN_ID (existing)"
info "  plan_name : ${PLAN_NAME:-(from --plan-id)}"
info "  domain    : ${PLAN_DOMAIN:-(none)}"
info "  scope     : ${PLAN_SCOPE:-(none)}"
info "  tags      : ${PLAN_TAGS:-(none)}"
info "  content   : ${PLAN_CONTENT:-(none)}"
info "  manifest  : $MANIFEST_PATH"
info "  api_base  : $API_BASE"
info "  run_after : $RUN_AFTER_IMPORT"
info "  dry_run   : $PT_DRY_RUN"
info "  insecure  : $PT_INSECURE"
info ""

# ---------------------------------------------------------------------------
# Step 1: Create plan (or use existing --plan-id)
# ---------------------------------------------------------------------------
if [[ -n "$PLAN_ID" ]]; then
  info "Step 1/2: Using existing plan: $PLAN_ID"
else
  info "Step 1/2: Creating plan..."

  PLAN_CREATE_ARGS=(create --name "$PLAN_NAME")
  [[ -n "$PLAN_DOMAIN" ]]  && PLAN_CREATE_ARGS+=(--domain "$PLAN_DOMAIN")
  [[ -n "$PLAN_SCOPE" ]]   && PLAN_CREATE_ARGS+=(--scope "$PLAN_SCOPE")
  [[ -n "$PLAN_TAGS" ]]    && PLAN_CREATE_ARGS+=(--tags "$PLAN_TAGS")
  [[ -n "$PLAN_CONTENT" ]] && PLAN_CREATE_ARGS+=(--content "$PLAN_CONTENT")
  PLAN_CREATE_ARGS+=("${PLAN_PT_FLAGS[@]}")

  PLAN_OUTPUT="$("${SCRIPT_DIR}/dts-plan" "${PLAN_CREATE_ARGS[@]}")"

  # Parse plan_id from output (format: plan_id=UUID)
  PLAN_ID=""
  while IFS= read -r line; do
    if [[ "$line" == plan_id=* ]]; then
      PLAN_ID="${line#plan_id=}"
      break
    fi
  done <<< "$PLAN_OUTPUT"

  if [[ -z "$PLAN_ID" ]]; then
    die "failed to parse plan_id from dts-plan output:
$PLAN_OUTPUT"
  fi

  # In dry-run mode, dts-plan returns a non-UUID placeholder; normalize it
  # so dts-dbt-import's UUID validation does not reject it.
  if $PT_DRY_RUN && [[ "$PLAN_ID" == dry-run-* ]]; then
    PLAN_ID="00000000-0000-0000-0000-000000000000"
  fi

  info "Plan created: $PLAN_ID"
fi
info ""

# ---------------------------------------------------------------------------
# Step 2: Import dbt models
# ---------------------------------------------------------------------------
if $RUN_AFTER_IMPORT; then
  info "Step 2/3: Importing dbt models..."
else
  info "Step 2/2: Importing dbt models..."
fi

IMPORT_ARGS=(
  --plan-id "$PLAN_ID"
  --manifest "$MANIFEST_PATH"
  --api-base "$API_BASE"
  --token "$TOKEN"
  --source-data-source-id "$SOURCE_DATA_SOURCE_ID"
)
if [[ -n "${ACTIVE_DEPT:-}" ]]; then
  IMPORT_ARGS+=(--active-dept "$ACTIVE_DEPT")
fi
IMPORT_ARGS+=("${IMPORT_PT_FLAGS[@]}")

"${SCRIPT_DIR}/dts-dbt-import" "${IMPORT_ARGS[@]}"

# ---------------------------------------------------------------------------
# Step 2b: Sync YAML and macros from package to dbt project directory
# ---------------------------------------------------------------------------
if [[ -n "$_PACKAGE_TMPDIR" ]]; then
  _DBT_HOST_DIR="${SCRIPT_DIR}/../services/dts-dbt"
  if [[ -d "$_DBT_HOST_DIR" ]]; then
    _PKG_ROOT="$_PACKAGE_TMPDIR"
    # Find the actual content root (may be nested in a subdirectory)
    if [[ -f "${_PKG_ROOT}/models.tsv" ]]; then
      _PKG_ROOT="$_PACKAGE_TMPDIR"
    else
      _PKG_ROOT=$(find "$_PACKAGE_TMPDIR" -name "models.tsv" -print -quit 2>/dev/null)
      _PKG_ROOT="${_PKG_ROOT%/models.tsv}"
    fi
    # Copy YAML source definitions
    find "$_PKG_ROOT/models" -name "*.yml" -o -name "*.yaml" 2>/dev/null | while read -r yf; do
      _REL="${yf#$_PKG_ROOT/}"
      _DEST="${_DBT_HOST_DIR}/${_REL}"
      mkdir -p "$(dirname "$_DEST")"
      cp -f "$yf" "$_DEST"
      info "  synced: $_REL"
    done
    # Copy macros
    if [[ -d "$_PKG_ROOT/macros" ]]; then
      mkdir -p "$_DBT_HOST_DIR/macros"
      find "$_PKG_ROOT/macros" -type f 2>/dev/null | while read -r mf; do
        _FNAME="$(basename "$mf")"
        cp -f "$mf" "$_DBT_HOST_DIR/macros/$_FNAME"
        info "  synced: macros/$_FNAME"
      done
    fi
    # Copy seeds
    if [[ -d "$_PKG_ROOT/seeds" ]]; then
      mkdir -p "$_DBT_HOST_DIR/seeds" 2>/dev/null || true
      chmod 755 "$_DBT_HOST_DIR/seeds" 2>/dev/null || true
      find "$_PKG_ROOT/seeds" -type f 2>/dev/null | while read -r sf; do
        _FNAME="$(basename "$sf")"
        cp -f "$sf" "$_DBT_HOST_DIR/seeds/$_FNAME" 2>/dev/null || \
          sudo cp -f "$sf" "$_DBT_HOST_DIR/seeds/$_FNAME" 2>/dev/null || \
          warn "  failed to copy seeds/$_FNAME (permission denied)"
        info "  synced: seeds/$_FNAME"
      done
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Step 3: Trigger dbt run + sync (if --run)
# ---------------------------------------------------------------------------
if $RUN_AFTER_IMPORT && ! $PT_DRY_RUN; then
  info ""
  info "Step 3/3: Triggering dbt run to build tables..."

  # Resolve selector: --run-selector > PLAN_TAGS > "all"
  _SELECTOR="${RUN_SELECTOR:-}"
  if [[ -z "$_SELECTOR" && -n "${PLAN_TAGS:-}" ]]; then
    # Use first tag as selector
    _SELECTOR="tag:$(echo "$PLAN_TAGS" | cut -d',' -f1 | tr -d ' ')"
  fi
  if [[ -z "$_SELECTOR" ]]; then
    _SELECTOR="all"
  fi

  _CURL_FLAGS=(-s -S)
  $PT_INSECURE && _CURL_FLAGS+=(-k)

  info "  selector: $_SELECTOR"

  # Trigger dbt run
  _RUN_RESP=$(curl "${_CURL_FLAGS[@]}" -X POST "${API_BASE%/}/api/etl/dbt/run" \
    -H "Authorization: Bearer ${TOKEN}" \
    -H "Content-Type: application/json" \
    -H "X-Active-Dept: ${ACTIVE_DEPT:-}" \
    -d "{\"operation\":\"run\",\"models\":\"${_SELECTOR}\"}" 2>&1) || true

  if echo "$_RUN_RESP" | grep -q '"status"'; then
    info "  dbt run triggered: $(echo "$_RUN_RESP" | grep -o '"dagId":"[^"]*"' || echo 'queued')"
    $PT_SHOW_RESPONSE && info "  response: $_RUN_RESP"
  else
    warn "  dbt run trigger may have failed: $_RUN_RESP"
  fi

  # Trigger sync
  info "  Syncing models to catalog..."
  _SYNC_RESP=$(curl "${_CURL_FLAGS[@]}" -X POST "${API_BASE%/}/api/etl/dbt/models/sync" \
    -H "Authorization: Bearer ${TOKEN}" \
    -H "Content-Type: application/json" 2>&1) || true

  if echo "$_SYNC_RESP" | grep -q '"data"'; then
    info "  Sync completed"
    $PT_SHOW_RESPONSE && info "  response: $_SYNC_RESP"
  else
    warn "  Sync may have failed: $_SYNC_RESP"
  fi
fi

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
info ""
green "[$CALLER_NAME] Deploy completed successfully (plan_id=$PLAN_ID)"
