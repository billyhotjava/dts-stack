<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 数据入湖任务表 -->
    <changeSet id="20260125-1-create-ingestion-task" author="system">
        <createTable tableName="ingestion_task">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            
            <!-- 数据源配置 -->
            <column name="source_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="source_config" type="jsonb">
                <constraints nullable="false"/>
            </column>
            
            <!-- 目标配置 -->
            <column name="destination_type" type="varchar(50)" defaultValue="postgres"/>
            <column name="destination_config" type="jsonb"/>
            
            <!-- 同步配置 -->
            <column name="sync_mode" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="sync_schedule" type="varchar(100)"/>
            <column name="table_mapping" type="jsonb"/>
            
            <!-- Addax配置 -->
            <column name="addax_job_path" type="varchar(500)"/>
            <column name="addax_config" type="jsonb"/>
            
            <!-- Airflow集成 -->
            <column name="airflow_enabled" type="boolean" defaultValueBoolean="false"/>
            <column name="airflow_dag_id" type="varchar(200)"/>
            
            <!-- 状态与审计 -->
            <column name="status" type="varchar(50)" defaultValue="draft"/>
            <column name="last_executed_at" type="timestamp"/>
            <column name="last_execution_status" type="varchar(50)"/>
            
            <!-- 审计字段 -->
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        
        <createIndex indexName="idx_ingestion_task_status" tableName="ingestion_task">
            <column name="status"/>
        </createIndex>
        
        <createIndex indexName="idx_ingestion_task_created_by" tableName="ingestion_task">
            <column name="created_by"/>
        </createIndex>
        
        <createIndex indexName="idx_ingestion_task_airflow_dag_id" tableName="ingestion_task">
            <column name="airflow_dag_id"/>
        </createIndex>
    </changeSet>

    <!-- 任务执行历史表 -->
    <changeSet id="20260125-2-create-ingestion-execution" author="system">
        <createTable tableName="ingestion_execution">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_id" type="bigint">
                <constraints nullable="false" 
                    foreignKeyName="fk_ingestion_execution_task"
                    references="ingestion_task(id)"/>
            </column>
            <column name="execution_id" type="varchar(200)"/>
            <column name="status" type="varchar(50)"/>
            <column name="start_time" type="timestamp"/>
            <column name="end_time" type="timestamp"/>
            <column name="rows_read" type="bigint"/>
            <column name="rows_written" type="bigint"/>
            <column name="error_message" type="text"/>
            <column name="log_path" type="varchar(500)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        
        <createIndex indexName="idx_ingestion_execution_task_id" tableName="ingestion_execution">
            <column name="task_id"/>
        </createIndex>
        
        <createIndex indexName="idx_ingestion_execution_status" tableName="ingestion_execution">
            <column name="status"/>
        </createIndex>
        
        <createIndex indexName="idx_ingestion_execution_created_at" tableName="ingestion_execution">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
