<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260212-01-add-ingestion-execution-replace-audit-columns" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="ingestion_execution" columnName="replace_mode"/>
            </not>
        </preConditions>
        <addColumn tableName="ingestion_execution">
            <column name="replace_mode" type="varchar(50)"/>
            <column name="dropped_tables" type="text"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260212-02-add-ingestion-execution-replace-mode-index" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="ingestion_execution" columnName="replace_mode"/>
                <not>
                    <indexExists tableName="ingestion_execution" indexName="idx_ingestion_execution_replace_mode"/>
                </not>
            </and>
        </preConditions>
        <createIndex tableName="ingestion_execution" indexName="idx_ingestion_execution_replace_mode">
            <column name="replace_mode"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
