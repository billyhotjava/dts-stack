<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260101_02_governance_quality_task" author="platform">
        <createTable tableName="gov_quality_task">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(128)"/>
            <column name="dataset_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="rule_id" type="${uuidType}"/>
            <column name="owner_dept" type="varchar(128)"/>
            <column name="interval_minutes" type="int4">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="last_triggered_at" type="timestamp"/>

            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <createIndex tableName="gov_quality_task" indexName="idx_gov_quality_task_dataset">
            <column name="dataset_id"/>
        </createIndex>
        <createIndex tableName="gov_quality_task" indexName="idx_gov_quality_task_rule">
            <column name="rule_id"/>
        </createIndex>
        <createIndex tableName="gov_quality_task" indexName="idx_gov_quality_task_enabled">
            <column name="enabled"/>
        </createIndex>
        <createIndex tableName="gov_quality_task" indexName="idx_gov_quality_task_owner_dept">
            <column name="owner_dept"/>
        </createIndex>
        <createIndex tableName="gov_quality_task" indexName="idx_gov_quality_task_last_triggered">
            <column name="last_triggered_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

