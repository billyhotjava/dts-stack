<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260429-07-catalog-lineage-job-table" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="catalog_lineage_job"/>
            </not>
        </preConditions>
        <createTable tableName="catalog_lineage_job">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_key" type="varchar(256)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_catalog_lineage_job_key"/>
            </column>
            <column name="name" type="varchar(256)"/>
            <column name="job_type" type="varchar(64)"/>
            <column name="engine" type="varchar(64)"/>
            <column name="relation_type" type="varchar(32)"/>
            <column name="project_name" type="varchar(128)"/>
            <column name="source_id" type="${uuidType}"/>
            <column name="owner_dept" type="varchar(128)"/>
            <column name="external_id" type="varchar(256)"/>
            <column name="status" type="varchar(32)"/>
            <column name="last_execution_id" type="varchar(128)"/>
            <column name="last_execution_status" type="varchar(32)"/>
            <column name="last_observed_at" type="timestamp"/>
            <column name="last_verified_at" type="timestamp"/>
            <column name="detail_payload" type="text"/>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        <createIndex tableName="catalog_lineage_job" indexName="idx_catalog_lineage_job_type">
            <column name="job_type"/>
            <column name="engine"/>
        </createIndex>
        <createIndex tableName="catalog_lineage_job" indexName="idx_catalog_lineage_job_source">
            <column name="source_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260429-08-catalog-lineage-job-id-column" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="catalog_dataset_lineage" columnName="lineage_job_id"/>
            </not>
        </preConditions>
        <addColumn tableName="catalog_dataset_lineage">
            <column name="lineage_job_id" type="${uuidType}"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260429-09-catalog-lineage-job-id-index" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="catalog_dataset_lineage" indexName="idx_catalog_dataset_lineage_job"/>
            </not>
        </preConditions>
        <createIndex tableName="catalog_dataset_lineage" indexName="idx_catalog_dataset_lineage_job">
            <column name="lineage_job_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
