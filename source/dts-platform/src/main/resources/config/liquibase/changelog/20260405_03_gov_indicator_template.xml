<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260405-03-gov-indicator-template" author="system">
        <createTable tableName="gov_indicator_template">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="domain" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="indicator_blueprints" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="required_source_fields" type="jsonb"/>
            <column name="seed_tables" type="jsonb"/>
            <column name="recommended_snapshot" type="boolean" defaultValueBoolean="false"/>
            <column name="builtin" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="integer" defaultValueNumeric="0"/>
            <column name="created_by" type="varchar(64)"/>
            <column name="created_date" type="timestamp" defaultValueComputed="now()"/>
            <column name="last_modified_by" type="varchar(64)"/>
            <column name="last_modified_date" type="timestamp" defaultValueComputed="now()"/>
        </createTable>

        <createIndex tableName="gov_indicator_template" indexName="idx_git_domain">
            <column name="domain"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
