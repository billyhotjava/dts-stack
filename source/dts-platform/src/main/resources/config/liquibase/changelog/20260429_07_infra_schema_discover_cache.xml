<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260429_07_infra_schema_discover_cache" author="dts">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="infra_schema_discover_cache"/>
            </not>
        </preConditions>
        <createTable tableName="infra_schema_discover_cache">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="data_source_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="cache_key" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="schema_name" type="varchar(256)"/>
            <column name="table_pattern" type="varchar(256)"/>
            <column name="status" type="varchar(32)"/>
            <column name="table_count" type="int"/>
            <column name="column_count" type="int"/>
            <column name="drift_added_tables" type="int"/>
            <column name="drift_removed_tables" type="int"/>
            <column name="drift_changed_tables" type="int"/>
            <column name="drift_details_json" type="text"/>
            <column name="response_json" type="text"/>
            <column name="refreshed_at" type="timestamp"/>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="20260429_07_infra_schema_discover_cache_idx" author="dts">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="infra_schema_discover_cache" indexName="idx_schema_discover_cache_source_key"/>
            </not>
        </preConditions>
        <createIndex tableName="infra_schema_discover_cache" indexName="idx_schema_discover_cache_source_key">
            <column name="data_source_id"/>
            <column name="cache_key"/>
            <column name="refreshed_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
