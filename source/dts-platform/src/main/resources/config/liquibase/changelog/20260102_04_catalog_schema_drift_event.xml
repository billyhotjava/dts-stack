<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260102_04_catalog_schema_drift_event" author="platform">
        <createTable tableName="catalog_schema_drift_event">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="run_id" type="${uuidType}"/>
            <column name="integration" type="varchar(32)">
                <constraints nullable="false"/>
            </column>

            <column name="dataset_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="hive_database" type="varchar(256)"/>
            <column name="hive_table" type="varchar(256)"/>

            <column name="added_count" type="int"/>
            <column name="removed_count" type="int"/>
            <column name="changed_count" type="int"/>

            <column name="details_json" type="text"/>

            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <createIndex tableName="catalog_schema_drift_event" indexName="idx_schema_drift_dataset_time">
            <column name="dataset_id"/>
            <column name="created_date"/>
        </createIndex>

        <createIndex tableName="catalog_schema_drift_event" indexName="idx_schema_drift_run">
            <column name="run_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
