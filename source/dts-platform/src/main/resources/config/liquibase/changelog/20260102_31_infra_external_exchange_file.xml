<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260102_31_infra_external_exchange_file" author="platform">
        <createTable tableName="infra_external_exchange_file">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="entry_key" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="directory_artifact_id" type="${uuidType}"/>

            <column name="file_name" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="varchar(2048)"/>
            <column name="file_size" type="bigint"/>
            <column name="checksum" type="varchar(128)"/>
            <column name="batch_code" type="varchar(128)"/>
            <column name="source_system" type="varchar(128)"/>

            <column name="status" type="varchar(32)" defaultValue="RECEIVED">
                <constraints nullable="false"/>
            </column>
            <column name="received_at" type="timestamp"/>
            <column name="processed_at" type="timestamp"/>
            <column name="error_message" type="varchar(1024)"/>

            <column name="classification" type="varchar(32)" defaultValue="INTERNAL">
                <constraints nullable="false"/>
            </column>
            <column name="owner_dept" type="varchar(64)"/>
            <column name="external_ref" type="varchar(256)"/>
            <column name="props" type="text"/>

            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <createIndex tableName="infra_external_exchange_file" indexName="idx_exchange_file_entry_key">
            <column name="entry_key"/>
        </createIndex>
        <createIndex tableName="infra_external_exchange_file" indexName="idx_exchange_file_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="infra_external_exchange_file" indexName="idx_exchange_file_received_at">
            <column name="received_at"/>
        </createIndex>
        <createIndex tableName="infra_external_exchange_file" indexName="idx_exchange_file_owner_dept">
            <column name="owner_dept"/>
        </createIndex>
        <createIndex tableName="infra_external_exchange_file" indexName="idx_exchange_file_enabled">
            <column name="enabled"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

