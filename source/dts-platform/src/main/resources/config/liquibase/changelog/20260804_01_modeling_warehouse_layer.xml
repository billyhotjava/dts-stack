<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="20260804-01-modeling-warehouse-layer" author="codex" dbms="postgresql">
        <preConditions onFail="HALT" onError="HALT">
            <tableExists tableName="modeling_model_spec"/>
            <not>
                <tableExists tableName="modeling_warehouse_layer"/>
            </not>
        </preConditions>
        <comment>
            Global custom-only warehouse layer registry with logical deletion and permanent code
            uniqueness, plus ModelSpec warehouse layer selection backfilled from the canonical
            execution layer. Built-in codes remain code-owned; no foreign key is created because
            built-in codes are valid selections.
        </comment>

        <createTable tableName="modeling_warehouse_layer">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="system_layer_code" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(1000)"/>
            <column name="naming_prefix" type="varchar(64)"/>
            <column name="status" type="varchar(16)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="integer" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="${timestampType}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_date" type="${timestampType}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addCheckConstraint
            tableName="modeling_warehouse_layer"
            constraintName="ck_modeling_warehouse_layer_code_format"
            checkCondition="code ~ '^[A-Z][A-Z0-9_]{1,63}$'"/>
        <addCheckConstraint
            tableName="modeling_warehouse_layer"
            constraintName="ck_modeling_warehouse_layer_prefix_format"
            checkCondition="naming_prefix IS NULL OR naming_prefix ~ '^[a-z][a-z0-9_]{0,63}$'"/>
        <addCheckConstraint
            tableName="modeling_warehouse_layer"
            constraintName="ck_modeling_warehouse_layer_system_type"
            checkCondition="system_layer_code in ('ODS_RAW', 'ODS_STANDARDIZED', 'STG', 'DWD', 'DWS', 'ADS')"/>
        <addCheckConstraint
            tableName="modeling_warehouse_layer"
            constraintName="ck_modeling_warehouse_layer_status"
            checkCondition="status in ('ACTIVE', 'DELETED')"/>
        <addCheckConstraint
            tableName="modeling_warehouse_layer"
            constraintName="ck_modeling_warehouse_layer_version"
            checkCondition="version >= 1"/>

        <createIndex
            indexName="idx_modeling_warehouse_layer_status_system"
            tableName="modeling_warehouse_layer">
            <column name="status"/>
            <column name="system_layer_code"/>
        </createIndex>

        <addColumn tableName="modeling_model_spec">
            <column name="warehouse_layer_code" type="varchar(64)"/>
        </addColumn>

        <createIndex
            indexName="idx_modeling_model_spec_layer_status"
            tableName="modeling_model_spec">
            <column name="warehouse_layer_code"/>
            <column name="status"/>
        </createIndex>

        <sql>
            update modeling_model_spec set warehouse_layer_code = layer where warehouse_layer_code is null
        </sql>

        <preConditions onFail="HALT" onError="HALT">
            <sqlCheck expectedResult="0">
                select count(*) from modeling_model_spec where warehouse_layer_code is null
            </sqlCheck>
        </preConditions>

        <addNotNullConstraint
            tableName="modeling_model_spec"
            columnName="warehouse_layer_code"
            columnDataType="varchar(64)"/>

        <rollback>
            <sql>DROP TABLE modeling_warehouse_layer;</sql>
            <sql>ALTER TABLE modeling_model_spec DROP COLUMN warehouse_layer_code;</sql>
        </rollback>
    </changeSet>

    <changeSet id="20260804-02-modeling-warehouse-layer-forward-only" author="codex" dbms="postgresql">
        <preConditions onFail="HALT" onError="HALT">
            <tableExists tableName="modeling_warehouse_layer"/>
        </preConditions>
        <comment>
            Forward-only guard: logical deletion keeps rows so historical models stay resolvable.
            Physical deletion of business rows is intentionally unsupported.
        </comment>
        <tagDatabase tag="modeling_warehouse_layer_forward_only"/>
    </changeSet>
</databaseChangeLog>
