<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260102_38_governance_issue_dataset_dept" author="platform">
        <addColumn tableName="gov_issue_ticket">
            <column name="dataset_id" type="uuid"/>
            <column name="owner_dept" type="varchar(128)"/>
        </addColumn>

        <createIndex tableName="gov_issue_ticket" indexName="idx_gov_issue_ticket_dataset">
            <column name="dataset_id"/>
        </createIndex>

        <createIndex tableName="gov_issue_ticket" indexName="idx_gov_issue_ticket_owner_dept">
            <column name="owner_dept"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

