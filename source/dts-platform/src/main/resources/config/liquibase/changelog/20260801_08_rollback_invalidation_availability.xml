            <column name="receipt_id" type="uuid"><constraints nullable="false"/></column>
            <column name="asset_type" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="asset_key" type="varchar(512)"><constraints nullable="false"/></column>
            <column name="ods_mapping_id" type="uuid"><constraints nullable="false"/></column>
            <column name="dataset_id" type="uuid"/>
            <column name="previous_mapping_enabled" type="boolean"><constraints nullable="false"/></column>
            <column name="previous_availability_status" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="previous_availability_epoch" type="bigint"><constraints nullable="false"/></column>
            <column name="previous_availability_event_id" type="varchar(128)"/>
            <column name="previous_availability_payload_hash" type="varchar(64)"/>
            <column name="previous_availability_reason" type="varchar(512)"/>
            <column name="previous_availability_source_sequence" type="bigint"><constraints nullable="false"/></column>
            <column name="applied_at" type="timestamp"/>
            <column name="created_at" type="timestamp"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint
