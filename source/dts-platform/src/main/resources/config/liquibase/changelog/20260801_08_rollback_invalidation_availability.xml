        </createIndex>
        <addUniqueConstraint
            tableName="catalog_asset_availability_event"
            columnNames="event_id, asset_type, asset_key"
            constraintName="uk_catalog_availability_event_identity"/>
        <createIndex tableName="catalog_asset_availability_event" indexName="idx_catalog_availability_event_asset_time">
