        <createTable tableName="catalog_asset_availability_event">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="event_id" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="payload_hash" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="receipt_id" type="uuid"/>
            <column name="asset_type" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="asset_key" type="varchar(512)"><constraints nullable="false"/></column>
            <column name="status" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="availability_epoch" type="bigint"><constraints nullable="false"/></column>
            <column name="source_sequence" type="bigint"><constraints nullable="false"/></column>
            <column name="reason" type="varchar(512)"/>
            <column name="occurred_at" type="timestamp"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="catalog_asset_availability_event"
            baseColumnNames="receipt_id"
            referencedTableName="integration_rollback_invalidation_receipt"
            referencedColumnNames="id"
            constraintName="fk_catalog_availability_event_receipt"/>
        <createIndex tableName="catalog_asset_availability_event" indexName="idx_catalog_availability_event_receipt">
