            referencedTableName="integration_rollback_invalidation_receipt"
            referencedColumnNames="id"
            constraintName="fk_rollback_invalidation_completion_receipt"/>
        <addUniqueConstraint
            tableName="integration_rollback_invalidation_completion_event"
            columnNames="receipt_id, event_id"
            constraintName="uk_rollback_invalidation_completion_identity"/>
        <createIndex
            tableName="integration_rollback_invalidation_completion_event"
            indexName="idx_rollback_invalidation_completion_sequence">
            <column name="receipt_id"/>
            <column name="source_sequence"/>
