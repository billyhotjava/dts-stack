<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260212_01_catalog_dataset_snapshot_column" author="platform">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="catalog_dataset" columnName="snapshot_time"/>
            </not>
        </preConditions>
        <addColumn tableName="catalog_dataset">
            <column name="snapshot_time" type="timestamp"/>
        </addColumn>
        <sql dbms="postgresql">
            UPDATE catalog_dataset
            SET snapshot_time = COALESCE(last_modified_date, created_date, CURRENT_TIMESTAMP)
            WHERE snapshot_time IS NULL;
        </sql>
    </changeSet>

    <changeSet id="20260212_01_catalog_dataset_snapshot_index" author="platform">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="catalog_dataset" indexName="idx_catalog_dataset_source_snapshot_time"/>
            </not>
        </preConditions>
        <createIndex tableName="catalog_dataset" indexName="idx_catalog_dataset_source_snapshot_time">
            <column name="source_id"/>
            <column name="snapshot_time"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260212_01_catalog_dataset_source_schema_table_enabled" author="platform">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="catalog_dataset" indexName="idx_catalog_dataset_source_schema_table_enabled"/>
            </not>
        </preConditions>
        <createIndex tableName="catalog_dataset" indexName="idx_catalog_dataset_source_schema_table_enabled">
            <column name="source_id"/>
            <column name="hive_database"/>
            <column name="hive_table"/>
            <column name="enabled"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
