<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260102_01_infra_catalog_sync_run" author="platform">
        <createTable tableName="infra_catalog_sync_run">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="integration" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="varchar(128)"/>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="timestamptz"/>
            <column name="finished_at" type="timestamptz"/>
            <column name="catalog_dataset_count_before" type="bigint"/>
            <column name="catalog_dataset_count_after" type="bigint"/>
            <column name="tables_discovered" type="integer"/>
            <column name="datasets_created" type="integer"/>
            <column name="datasets_updated" type="integer"/>
            <column name="datasets_removed" type="integer"/>
            <column name="tables_created" type="integer"/>
            <column name="columns_imported" type="integer"/>
            <column name="details_json" type="text"/>
            <column name="error" type="text"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamptz"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamptz"/>
        </createTable>

        <createIndex tableName="infra_catalog_sync_run" indexName="idx_infra_catalog_sync_run_integration_time">
            <column name="integration"/>
            <column name="started_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

