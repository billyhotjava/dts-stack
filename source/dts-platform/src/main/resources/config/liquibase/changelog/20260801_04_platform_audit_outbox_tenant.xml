<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260801_04_platform_audit_outbox_tenant" author="platform">
        <preConditions onFail="HALT">
            <tableExists tableName="platform_audit_outbox"/>
            <not><columnExists tableName="platform_audit_outbox" columnName="tenant_id"/></not>
        </preConditions>
        <addColumn tableName="platform_audit_outbox">
            <column name="tenant_id" type="varchar(128)"/>
        </addColumn>
        <!-- Existing rows have no authoritative ownership evidence. Keep them dispatchable but never replayable. -->
        <update tableName="platform_audit_outbox">
            <column name="tenant_id" value="__legacy_unscoped__"/>
            <where>tenant_id IS NULL</where>
        </update>
        <addNotNullConstraint
            tableName="platform_audit_outbox"
            columnName="tenant_id"
            columnDataType="varchar(128)"/>
        <sql dbms="postgresql">
            ALTER TABLE platform_audit_outbox
                ADD CONSTRAINT ck_platform_audit_outbox_tenant
                CHECK (char_length(btrim(tenant_id)) BETWEEN 1 AND 128);
        </sql>
        <rollback>
            <sql dbms="postgresql" splitStatements="false"><![CDATA[
                DO $$
                BEGIN
                    LOCK TABLE platform_audit_outbox IN ACCESS EXCLUSIVE MODE;
                    IF EXISTS (
                        SELECT 1
                          FROM platform_audit_outbox
                         WHERE tenant_id <> '__legacy_unscoped__'
                    ) THEN
                        RAISE EXCEPTION 'ROLLBACK_BLOCKED_PLATFORM_AUDIT_TENANT_EVIDENCE_EXISTS';
                    END IF;
                END $$;
            ]]></sql>
            <sql dbms="postgresql">
                ALTER TABLE platform_audit_outbox DROP CONSTRAINT IF EXISTS ck_platform_audit_outbox_tenant;
            </sql>
            <dropColumn tableName="platform_audit_outbox" columnName="tenant_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
