<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260102_07_modeling_plan_version_review" author="platform">
        <createTable tableName="modeling_plan_version">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="plan_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="change_summary" type="varchar(1024)"/>
            <column name="snapshot_json" type="text"/>
            <column name="released_at" type="timestamptz"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamptz"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamptz"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="modeling_plan_version"
            baseColumnNames="plan_id"
            referencedTableName="modeling_plan"
            referencedColumnNames="id"
            constraintName="fk_modeling_plan_version_plan"/>

        <addUniqueConstraint
            tableName="modeling_plan_version"
            columnNames="plan_id,version"
            constraintName="uk_modeling_plan_version"/>

        <createIndex tableName="modeling_plan_version" indexName="idx_modeling_plan_version_plan">
            <column name="plan_id"/>
        </createIndex>
        <createIndex tableName="modeling_plan_version" indexName="idx_modeling_plan_version_status">
            <column name="status"/>
        </createIndex>

        <createTable tableName="modeling_plan_review">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="plan_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="varchar(32)"/>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="reviewer" type="varchar(64)"/>
            <column name="review_notes" type="text"/>
            <column name="reviewed_at" type="timestamptz"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamptz"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamptz"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="modeling_plan_review"
            baseColumnNames="plan_id"
            referencedTableName="modeling_plan"
            referencedColumnNames="id"
            constraintName="fk_modeling_plan_review_plan"/>

        <createIndex tableName="modeling_plan_review" indexName="idx_modeling_plan_review_plan">
            <column name="plan_id"/>
        </createIndex>
        <createIndex tableName="modeling_plan_review" indexName="idx_modeling_plan_review_status">
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

