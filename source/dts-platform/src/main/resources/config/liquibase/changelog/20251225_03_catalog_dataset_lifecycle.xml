<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20251225_03_catalog_dataset_lifecycle" author="platform">
        <addColumn tableName="catalog_dataset">
            <column name="lifecycle_status" type="varchar(32)"/>
            <column name="retention_days" type="int"/>
            <column name="expires_at" type="timestamp"/>
        </addColumn>

        <createIndex tableName="catalog_dataset" indexName="idx_catalog_dataset_lifecycle_status">
            <column name="lifecycle_status"/>
        </createIndex>
        <createIndex tableName="catalog_dataset" indexName="idx_catalog_dataset_expires_at">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
