<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260402-01-portal-session-browser-id" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="portal_sessions"/>
        </preConditions>

        <addColumn tableName="portal_sessions">
            <column name="browser_id" type="varchar(128)"/>
            <column name="last_renewed_at" type="timestamp with time zone"/>
        </addColumn>

        <update tableName="portal_sessions">
            <column name="last_renewed_at" valueComputed="last_seen_at"/>
            <where>last_renewed_at IS NULL</where>
        </update>

        <createIndex tableName="portal_sessions" indexName="idx_portal_sessions_browser_id">
            <column name="browser_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260402-02-portal-session-browser-indexes" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="portal_sessions"/>
        </preConditions>

        <sql splitStatements="false">
            DROP INDEX IF EXISTS uq_portal_sessions_active_username_partial;
            CREATE UNIQUE INDEX IF NOT EXISTS uq_portal_sessions_active_username_browser_partial
            ON portal_sessions (normalized_username, browser_id)
            WHERE revoked_at IS NULL AND browser_id IS NOT NULL;
            CREATE UNIQUE INDEX IF NOT EXISTS uq_portal_sessions_active_username_legacy_partial
            ON portal_sessions (normalized_username)
            WHERE revoked_at IS NULL AND browser_id IS NULL;
        </sql>
    </changeSet>
</databaseChangeLog>
