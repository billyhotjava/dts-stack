<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260718-01a-warehouse-plan-head-expand" author="codex">
        <preConditions onFail="HALT">
            <tableExists tableName="modeling_warehouse_plan"/>
        </preConditions>

        <addColumn tableName="modeling_warehouse_plan">
            <column name="code" type="varchar(128)"/>
            <column name="name" type="varchar(256)"/>
            <column name="objective" type="text"/>
            <column name="scope" type="text"/>
            <column name="owner_id" type="varchar(128)"/>
            <column name="owner_department_id" type="varchar(128)"/>
            <column name="onboarding_mode" type="varchar(32)"/>
            <column name="lifecycle_status" type="varchar(32)"/>
            <column name="legacy_source" type="varchar(64)"/>
            <column name="legacy_ref" type="varchar(256)"/>
            <column name="business_scope_confirmed" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="business_scope_version" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="sources_version" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="source_mappings_version" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="policy_version" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <sql dbms="postgresql"><![CDATA[
            UPDATE modeling_warehouse_plan
               SET code = COALESCE(code, 'legacy_' || replace(id::text, '-', '')),
                   name = COALESCE(name, 'Legacy plan ' || COALESCE(process_id, id::text)),
                   owner_id = COALESCE(owner_id, owner),
                   onboarding_mode = COALESCE(onboarding_mode, 'BUSINESS_FIRST'),
                   lifecycle_status = COALESCE(
                       lifecycle_status,
                       CASE
                           WHEN status = 'PUBLISHED' THEN 'PUBLISHED'
                           WHEN status = 'ARCHIVED' THEN 'ARCHIVED'
                           ELSE 'DRAFT'
                       END
                   ),
                   legacy_source = COALESCE(legacy_source, 'MODELING_VNEXT'),
                   legacy_ref = COALESCE(legacy_ref, id::text)
        ]]></sql>

        <addNotNullConstraint tableName="modeling_warehouse_plan" columnName="code" columnDataType="varchar(128)"/>
        <addNotNullConstraint tableName="modeling_warehouse_plan" columnName="name" columnDataType="varchar(256)"/>
        <addNotNullConstraint tableName="modeling_warehouse_plan" columnName="onboarding_mode" columnDataType="varchar(32)"/>
        <addNotNullConstraint tableName="modeling_warehouse_plan" columnName="lifecycle_status" columnDataType="varchar(32)"/>

        <dropUniqueConstraint tableName="modeling_warehouse_plan" constraintName="uk_modeling_warehouse_plan_process_layer"/>
        <dropNotNullConstraint tableName="modeling_warehouse_plan" columnName="process_id" columnDataType="varchar(128)"/>
        <dropNotNullConstraint tableName="modeling_warehouse_plan" columnName="layer" columnDataType="varchar(16)"/>
        <dropNotNullConstraint tableName="modeling_warehouse_plan" columnName="modeling_mode" columnDataType="varchar(32)"/>

        <addUniqueConstraint
            tableName="modeling_warehouse_plan"
            columnNames="tenant_id, code"
            constraintName="uk_modeling_warehouse_plan_tenant_code"/>
        <addUniqueConstraint
            tableName="modeling_warehouse_plan"
            columnNames="tenant_id, id"
            constraintName="uk_modeling_warehouse_plan_tenant_id"/>

        <rollback>
            <dropUniqueConstraint tableName="modeling_warehouse_plan" constraintName="uk_modeling_warehouse_plan_tenant_id"/>
            <dropUniqueConstraint tableName="modeling_warehouse_plan" constraintName="uk_modeling_warehouse_plan_tenant_code"/>
            <sql dbms="postgresql"><![CDATA[
                DO $$
                BEGIN
                    IF NOT EXISTS (
                        SELECT 1
                          FROM modeling_warehouse_plan
                         WHERE process_id IS NULL OR layer IS NULL OR modeling_mode IS NULL
                    ) AND NOT EXISTS (
                        SELECT 1
                          FROM modeling_warehouse_plan
                         GROUP BY tenant_id, process_id, layer
                        HAVING count(*) > 1
                    ) THEN
                        ALTER TABLE modeling_warehouse_plan ALTER COLUMN process_id SET NOT NULL;
                        ALTER TABLE modeling_warehouse_plan ALTER COLUMN layer SET NOT NULL;
                        ALTER TABLE modeling_warehouse_plan ALTER COLUMN modeling_mode SET NOT NULL;
                        ALTER TABLE modeling_warehouse_plan
                            ADD CONSTRAINT uk_modeling_warehouse_plan_process_layer
                            UNIQUE (tenant_id, process_id, layer);
                    END IF;
                END $$;
            ]]></sql>
            <dropColumn tableName="modeling_warehouse_plan" columnName="policy_version"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="source_mappings_version"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="sources_version"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="business_scope_version"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="business_scope_confirmed"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="legacy_ref"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="legacy_source"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="lifecycle_status"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="onboarding_mode"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="owner_department_id"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="owner_id"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="scope"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="objective"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="name"/>
            <dropColumn tableName="modeling_warehouse_plan" columnName="code"/>
        </rollback>
    </changeSet>

