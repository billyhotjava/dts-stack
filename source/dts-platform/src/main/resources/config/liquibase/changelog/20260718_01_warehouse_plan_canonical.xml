        <addUniqueConstraint tableName="modeling_warehouse_plan_process" columnNames="tenant_id, plan_id, process_id" constraintName="uk_warehouse_plan_process"/>
        <createIndex tableName="modeling_warehouse_plan_process" indexName="idx_warehouse_plan_process_plan"><column name="tenant_id"/><column name="plan_id"/></createIndex>

        <createTable tableName="modeling_warehouse_plan_metric_need">
            <column name="id" type="${uuidType}"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="plan_id" type="${uuidType}"><constraints nullable="false"/></column>
            <column name="metric_ref" type="varchar(256)"/>
            <column name="name" type="varchar(256)"><constraints nullable="false"/></column>
