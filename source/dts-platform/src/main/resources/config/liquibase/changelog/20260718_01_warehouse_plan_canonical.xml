        <addUniqueConstraint tableName="modeling_warehouse_plan_source" columnNames="tenant_id, plan_id, source_type, source_id" constraintName="uk_warehouse_plan_source_ref"/>
        <addForeignKeyConstraint baseTableName="modeling_warehouse_plan_source" baseColumnNames="tenant_id, plan_id" constraintName="fk_warehouse_plan_source_plan" referencedTableName="modeling_warehouse_plan" referencedColumnNames="tenant_id, id"/>
