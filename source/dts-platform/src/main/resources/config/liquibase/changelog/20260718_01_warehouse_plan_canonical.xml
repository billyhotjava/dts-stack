        <createIndex tableName="modeling_warehouse_plan_metric_need" indexName="idx_warehouse_plan_metric_plan"><column name="tenant_id"/><column name="plan_id"/></createIndex>

        <rollback>
            <dropTable tableName="modeling_warehouse_plan_metric_need" cascadeConstraints="true"/>
            <dropTable tableName="modeling_warehouse_plan_process" cascadeConstraints="true"/>
            <dropTable tableName="modeling_warehouse_plan_domain" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

    <changeSet id="20260718-01c-warehouse-plan-sources-policy" author="codex">
