    <changeSet id="20260501_02_semantic_model" author="platform">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="semantic_model"/></not>
        </preConditions>
        <createTable tableName="semantic_model">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="object_id" type="uuid"/>
