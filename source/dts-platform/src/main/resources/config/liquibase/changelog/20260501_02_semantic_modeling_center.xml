<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260501_02_semantic_subject_domain" author="platform">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="semantic_subject_domain"/></not>
        </preConditions>
        <createTable tableName="semantic_subject_domain">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="code" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="name" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="description" type="varchar(2048)"/>
            <column name="status" type="varchar(32)" defaultValue="DRAFT"/>
            <column name="owner_dept" type="varchar(64)"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        <addUniqueConstraint tableName="semantic_subject_domain" columnNames="code" constraintName="uk_semantic_subject_domain_code"/>
    </changeSet>

    <changeSet id="20260501_02_semantic_business_object" author="platform">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="semantic_business_object"/></not>
        </preConditions>
        <createTable tableName="semantic_business_object">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="domain_id" type="uuid"/>
            <column name="code" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="name" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="description" type="varchar(2048)"/>
            <column name="primary_key" type="varchar(128)"/>
            <column name="main_table" type="varchar(256)"/>
            <column name="status" type="varchar(32)" defaultValue="DRAFT"/>
            <column name="owner_dept" type="varchar(64)"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        <addUniqueConstraint tableName="semantic_business_object" columnNames="code" constraintName="uk_semantic_business_object_code"/>
        <addForeignKeyConstraint baseTableName="semantic_business_object" baseColumnNames="domain_id" referencedTableName="semantic_subject_domain" referencedColumnNames="id" constraintName="fk_semantic_object_domain"/>
        <createIndex tableName="semantic_business_object" indexName="idx_semantic_object_domain"><column name="domain_id"/></createIndex>
    </changeSet>

    <changeSet id="20260501_02_semantic_object_table_mapping" author="platform">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="semantic_object_table_mapping"/></not>
        </preConditions>
        <createTable tableName="semantic_object_table_mapping">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="object_id" type="uuid"><constraints nullable="false"/></column>
            <column name="table_name" type="varchar(256)"><constraints nullable="false"/></column>
            <column name="table_role" type="varchar(32)" defaultValue="JOINED"/>
            <column name="join_expression" type="varchar(2048)"/>
            <column name="sort_order" type="int" defaultValueNumeric="0"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="semantic_object_table_mapping" baseColumnNames="object_id" referencedTableName="semantic_business_object" referencedColumnNames="id" constraintName="fk_semantic_table_object"/>
        <createIndex tableName="semantic_object_table_mapping" indexName="idx_semantic_table_object"><column name="object_id"/></createIndex>
    </changeSet>

