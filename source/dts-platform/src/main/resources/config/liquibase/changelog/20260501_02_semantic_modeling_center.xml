            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="semantic_dimension" baseColumnNames="object_id" referencedTableName="semantic_business_object" referencedColumnNames="id" constraintName="fk_semantic_dimension_object"/>
        <createIndex tableName="semantic_dimension" indexName="idx_semantic_dimension_object"><column name="object_id"/></createIndex>
