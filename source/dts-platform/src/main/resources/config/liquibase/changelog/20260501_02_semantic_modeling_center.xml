        </createTable>
        <addForeignKeyConstraint baseTableName="semantic_model" baseColumnNames="object_id" referencedTableName="semantic_business_object" referencedColumnNames="id" constraintName="fk_semantic_model_object"/>
        <createIndex tableName="semantic_model" indexName="idx_semantic_model_object"><column name="object_id"/></createIndex>
        <createIndex tableName="semantic_model" indexName="idx_semantic_model_type"><column name="type"/></createIndex>
    </changeSet>

