        </addColumn>
        <createIndex tableName="semantic_subject_domain" indexName="idx_semantic_subject_governance_domain">
            <column name="governance_domain_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260501_02_semantic_model_dimension" author="platform">
        <preConditions onFail="MARK_RAN">
