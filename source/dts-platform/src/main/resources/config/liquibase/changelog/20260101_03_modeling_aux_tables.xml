<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260101_03_modeling_plan" author="platform">
        <createTable tableName="modeling_plan">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="domain" type="varchar(128)"/>
            <column name="scope" type="varchar(256)"/>
            <column name="status" type="varchar(32)"/>
            <column name="version" type="varchar(32)"/>
            <column name="version_notes" type="varchar(512)"/>
            <column name="owner" type="varchar(64)"/>
            <column name="owner_dept" type="varchar(128)"/>
            <column name="tags" type="varchar(1024)"/>
            <column name="content" type="text"/>

            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        <createIndex tableName="modeling_plan" indexName="idx_modeling_plan_owner_dept">
            <column name="owner_dept"/>
        </createIndex>
        <createIndex tableName="modeling_plan" indexName="idx_modeling_plan_domain">
            <column name="domain"/>
        </createIndex>
        <createIndex tableName="modeling_plan" indexName="idx_modeling_plan_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260101_03_modeling_glossary_term" author="platform">
        <createTable tableName="modeling_glossary_term">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(64)"/>
            <column name="name" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="aliases" type="varchar(512)"/>
            <column name="domain" type="varchar(128)"/>
            <column name="definition" type="text"/>
            <column name="status" type="varchar(32)"/>
            <column name="owner" type="varchar(64)"/>
            <column name="owner_dept" type="varchar(128)"/>
            <column name="tags" type="varchar(1024)"/>

            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        <createIndex tableName="modeling_glossary_term" indexName="idx_modeling_glossary_term_owner_dept">
            <column name="owner_dept"/>
        </createIndex>
        <createIndex tableName="modeling_glossary_term" indexName="idx_modeling_glossary_term_domain">
            <column name="domain"/>
        </createIndex>
        <createIndex tableName="modeling_glossary_term" indexName="idx_modeling_glossary_term_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260101_03_modeling_template" author="platform">
        <createTable tableName="modeling_template">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="layer" type="varchar(16)"/>
            <column name="status" type="varchar(32)"/>
            <column name="naming_rule" type="text"/>
            <column name="fields_template" type="text"/>
            <column name="review_checklist" type="text"/>

            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>
        <createIndex tableName="modeling_template" indexName="idx_modeling_template_layer">
            <column name="layer"/>
        </createIndex>
        <createIndex tableName="modeling_template" indexName="idx_modeling_template_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

