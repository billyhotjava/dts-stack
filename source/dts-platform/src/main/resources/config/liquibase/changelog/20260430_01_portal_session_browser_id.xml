<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260430-01-portal-session-browser-id" author="codex">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="portal_sessions"/>
                <not>
                    <columnExists tableName="portal_sessions" columnName="browser_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="portal_sessions">
            <column name="browser_id" type="varchar(128)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
