<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260404-03-gov-rule-template-fields" author="system">
        <addColumn tableName="gov_rule">
            <column name="template_id" type="uuid"/>
            <column name="template_params" type="jsonb"/>
            <column name="rendered_sql" type="text"/>
            <column name="action_on_fail" type="varchar(16)" defaultValue="ALERT"/>
            <column name="auto_trigger" type="boolean" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
