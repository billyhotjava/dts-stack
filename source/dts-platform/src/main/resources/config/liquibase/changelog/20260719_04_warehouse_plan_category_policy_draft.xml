<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260719-04-warehouse-plan-category-policy-draft" author="codex">
        <comment>
            Persist category validation evidence and allow planning policy drafts to reach model-design readiness
            before implementation-only policy fields are supplied.
        </comment>
        <preConditions onFail="HALT">
            <tableExists tableName="modeling_warehouse_plan_domain"/>
            <tableExists tableName="modeling_warehouse_plan_policy"/>
            <columnExists tableName="modeling_warehouse_plan_policy" columnName="layer_policy_code"/>
            <columnExists tableName="modeling_warehouse_plan_policy" columnName="history_policy"/>
            <columnExists tableName="modeling_warehouse_plan_policy" columnName="default_time_zone"/>
        </preConditions>

        <addColumn tableName="modeling_warehouse_plan_domain">
            <column name="last_validated_at" type="timestamp"/>
        </addColumn>
        <dropNotNullConstraint
            tableName="modeling_warehouse_plan_policy"
            columnName="layer_policy_code"
            columnDataType="varchar(64)"/>
        <dropNotNullConstraint
            tableName="modeling_warehouse_plan_policy"
            columnName="history_policy"
            columnDataType="varchar(64)"/>
        <dropNotNullConstraint
            tableName="modeling_warehouse_plan_policy"
            columnName="default_time_zone"
            columnDataType="varchar(64)"/>

        <rollback>
            <sql splitStatements="false"><![CDATA[
                DO $$
                BEGIN
                    IF EXISTS (
                        SELECT 1
                          FROM modeling_warehouse_plan_policy
                         WHERE layer_policy_code IS NULL
                            OR history_policy IS NULL
                            OR default_time_zone IS NULL
                    ) THEN
                        RAISE EXCEPTION 'ROLLBACK_BLOCKED_WAREHOUSE_POLICY_DRAFT_EXISTS';
                    END IF;
                END $$;
            ]]></sql>
            <addNotNullConstraint
                tableName="modeling_warehouse_plan_policy"
                columnName="default_time_zone"
                columnDataType="varchar(64)"/>
            <addNotNullConstraint
                tableName="modeling_warehouse_plan_policy"
                columnName="history_policy"
                columnDataType="varchar(64)"/>
            <addNotNullConstraint
                tableName="modeling_warehouse_plan_policy"
                columnName="layer_policy_code"
                columnDataType="varchar(64)"/>
            <dropColumn tableName="modeling_warehouse_plan_domain" columnName="last_validated_at"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
