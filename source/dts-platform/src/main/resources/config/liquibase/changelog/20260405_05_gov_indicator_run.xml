<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260405_05_gov_indicator_run" author="system">
        <createTable tableName="gov_indicator_run">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="indicator_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="run_at" type="timestamp" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="computed_value" type="numeric"/>
            <column name="previous_value" type="numeric"/>
            <column name="change_rate" type="numeric"/>
            <column name="rows_processed" type="integer"/>
            <column name="duration_ms" type="integer"/>
            <column name="threshold_hit" type="boolean" defaultValueBoolean="false"/>
            <column name="alert_level" type="varchar(8)"/>
            <column name="alert_reason" type="text"/>
            <column name="error_message" type="text"/>
            <column name="dbt_run_id" type="varchar(64)"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="gov_indicator_run"
            baseColumnNames="indicator_id"
            constraintName="fk_gir_indicator"
            referencedTableName="gov_indicator_definition"
            referencedColumnNames="id"/>

        <createIndex tableName="gov_indicator_run" indexName="idx_gir_indicator">
            <column name="indicator_id"/>
        </createIndex>

        <createIndex tableName="gov_indicator_run" indexName="idx_gir_run_at">
            <column name="run_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
