<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260518-04-01-modeling-plan-domain-id" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="modeling_plan" columnName="domain_id"/>
            </not>
        </preConditions>
        <addColumn tableName="modeling_plan">
            <column name="domain_id" type="uuid"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="modeling_plan"
            baseColumnNames="domain_id"
            constraintName="fk_modeling_plan_domain"
            referencedTableName="catalog_domain"
            referencedColumnNames="id"/>
        <createIndex tableName="modeling_plan" indexName="idx_modeling_plan_domain_id">
            <column name="domain_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
