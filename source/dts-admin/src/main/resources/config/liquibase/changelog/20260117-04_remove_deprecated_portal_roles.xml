<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260117-04-remove-deprecated-portal-roles" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="portal_menu_visibility"/>
        </preConditions>
        <comment>Remove deprecated dept/inst data dev/viewer roles from portal menu visibility.</comment>
        <delete tableName="portal_menu_visibility">
            <where>
                UPPER(role_code) IN (
                    'ROLE_DEPT_DATA_DEV',
                    'ROLE_DEPT_DATA_VIEWER',
                    'ROLE_INST_DATA_DEV',
                    'ROLE_INST_DATA_VIEWER'
                )
            </where>
        </delete>
    </changeSet>
</databaseChangeLog>
