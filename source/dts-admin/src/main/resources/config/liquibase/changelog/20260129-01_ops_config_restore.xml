    <!-- Restore ops config seed entries if they were cleaned up -->
    <changeSet id="20260129-ops-restore-01-openmetadata" author="dts-admin">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="system_config"/>
            <columnExists tableName="system_config" columnName="category"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM system_config WHERE cfg_key = 'feature.openmetadata.enabled'</sqlCheck>
        </preConditions>
        <insert tableName="system_config">
            <column name="cfg_key" value="feature.openmetadata.enabled"/>
            <column name="cfg_value" value="true"/>
            <column name="description" value="启用 OpenMetadata 元数据管理集成"/>
            <column name="category" value="FEATURE_TOGGLE"/>
            <column name="sensitive" valueBoolean="false"/>
            <column name="data_type" value="BOOLEAN"/>
            <column name="editable" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="10"/>
            <column name="display_name" value="OpenMetadata 集成"/>
            <column name="created_by" value="system"/>
            <column name="created_date" valueDate="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

