<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="20260222-02-remove-infra-datasource-audit" author="platform">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="audit_operation_mapping"/>
        </preConditions>
        <delete tableName="audit_operation_mapping">
            <where>url_pattern like '/api/infra/data-sources%'</where>
        </delete>
    </changeSet>
</databaseChangeLog>
