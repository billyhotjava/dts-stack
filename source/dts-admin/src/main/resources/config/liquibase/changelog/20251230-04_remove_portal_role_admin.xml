<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd"
>
    <changeSet id="20251230-04-remove-portal-role-admin" author="platform">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="portal_menu_visibility"/>
            </and>
        </preConditions>
        <comment>Remove legacy ROLE_ADMIN bindings from portal menu visibility (Keycloak realm has no ADMIN role).</comment>
        <sql dbms="postgresql" splitStatements="true">
            DELETE FROM portal_menu_visibility
            WHERE upper(coalesce(role_code, '')) IN ('ROLE_ADMIN', 'ADMIN');
        </sql>
    </changeSet>
</databaseChangeLog>
