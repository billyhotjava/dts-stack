<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <!-- Expand only. Existing details_json rows remain legacy-unresolved until explicitly assigned a tenant. -->
    <changeSet id="0054-01" author="codex">
        <addColumn tableName="analytics_database">
            <column name="tenant_id" type="varchar(128)"/>
            <column name="platform_data_source_id" type="uuid"/>
        </addColumn>
        <addUniqueConstraint
            tableName="analytics_database"
            columnNames="tenant_id,platform_data_source_id"
            constraintName="uk_analytics_database_tenant_platform_source"/>
        <rollback>
            <dropUniqueConstraint tableName="analytics_database" constraintName="uk_analytics_database_tenant_platform_source"/>
            <dropColumn tableName="analytics_database" columnName="platform_data_source_id"/>
            <dropColumn tableName="analytics_database" columnName="tenant_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
