<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.22.xsd">

    <changeSet id="0046-01-analytics-semantic-model" author="codex">
        <createTable tableName="analytics_semantic_model">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="database_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="table_id" type="bigint"/>
            <column name="model_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="schema_name" type="varchar(255)"/>
            <column name="table_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="varchar(255)"/>
            <column name="subject_area" type="varchar(255)"/>
            <column name="security_level" type="varchar(64)"/>
            <column name="grain" type="varchar(255)"/>
            <column name="row_security_predicate" type="text"/>
            <column name="spec_version" type="varchar(32)"/>
            <column name="exposed_to_modeler" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="meta_json" type="text"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="analytics_semantic_model" columnNames="model_name" constraintName="uk_semantic_model_name"/>
        <createIndex tableName="analytics_semantic_model" indexName="idx_semantic_model_subject_area">
            <column name="subject_area"/>
        </createIndex>
    </changeSet>

    <changeSet id="0046-02-analytics-semantic-join" author="codex">
        <createTable tableName="analytics_semantic_join">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="from_model" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="to_model" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="join_type" type="varchar(64)"/>
            <column name="relationship" type="varchar(32)"/>
            <column name="on_clause" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="fanout_warning" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="approval_required" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="meta_json" type="text"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="analytics_semantic_join" indexName="idx_semantic_join_from_model">
            <column name="from_model"/>
        </createIndex>
        <createIndex tableName="analytics_semantic_join" indexName="idx_semantic_join_to_model">
            <column name="to_model"/>
        </createIndex>
    </changeSet>

    <changeSet id="0046-03-analytics-virtual-dataset" author="codex">
        <createTable tableName="analytics_virtual_dataset">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="owner_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="workspace_id" type="bigint"/>
            <column name="base_model" type="varchar(255)"/>
            <column name="archived" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="state_json" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="analytics_virtual_dataset" indexName="idx_virtual_dataset_owner">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
