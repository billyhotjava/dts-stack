  total_rows,
  valid_rows,
  issue_rows,
  issue_count,
  coverage_rate,
  unmapped_subproject_count,
  unknown_delay_reason_count
FROM pm_ods_project_progress_batch
ORDER BY COALESCE(refreshed_at, uploaded_at) DESC, batch_id DESC
LIMIT 1
] 
