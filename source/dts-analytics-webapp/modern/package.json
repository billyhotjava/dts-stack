{
	"name": "dts-analytics-webapp-modern",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "VITE_CACHE_DIR=.vite-cache vite --host 0.0.0.0 --port 3002 --strictPort --open=false",
		"test": "node --import tsx --test",
		"typecheck": "VITE_CACHE_DIR=.vite-cache tsc --noEmit",
		"prebuild": "pnpm validate:screen-plugins && pnpm validate:screen-plugin-boundary",
		"build": "LEGACY_BROWSER_BUILD=1 VITE_CACHE_DIR=.vite-cache vite build",
		"build:modern": "LEGACY_BROWSER_BUILD=0 VITE_CACHE_DIR=.vite-cache vite build",
		"preview": "vite preview --host 0.0.0.0 --port 3002 --strictPort",
		"scaffold:screen-plugin": "node scripts/scaffold-screen-plugin.mjs",
		"validate:screen-plugins": "node scripts/validate-screen-plugin-manifests.mjs",
		"validate:screen-plugin-boundary": "node scripts/validate-screen-plugin-boundary.mjs"
	},
	"dependencies": {
		"@ant-design/icons": "^6.1.1",
		"@jiaminghi/data-view-react": "^1.2.5",
		"@ungap/structured-clone": "^1.3.0",
		"@tailwindcss/vite": "^4.1.3",
		"antd": "^5.22.1",
		"echarts": "^6.0.0",
		"echarts-for-react": "^3.0.6",
		"echarts-wordcloud": "^2.1.0",
		"papaparse": "5.4.1",
		"react": "^18.3.1",
		"react-dnd": "^16.0.1",
		"react-dnd-html5-backend": "^16.0.1",
		"react-dom": "^18.3.1",
		"react-grid-layout": "^1.5.0",
		"react-router": "^7.0.2",
		"tailwindcss": "^4.1.3",
		"xlsx": "0.18.5"
	},
	"devDependencies": {
		"@types/node": "^25.3.5",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/react-grid-layout": "^1.3.5",
		"@vitejs/plugin-react": "^4.3.3",
		"tsx": "^4.21.0",
		"typescript": "^5.6.3",
		"vite": "^6.2.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.28.0",
	"browserslist": {
		"production": [
			"Chrome >= 95"
		],
		"development": [
			"last 1 Chrome version"
		]
	}
}
