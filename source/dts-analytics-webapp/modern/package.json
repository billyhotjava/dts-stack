{
	"name": "dts-analytics-webapp-modern",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "VITE_CACHE_DIR=.vite-cache vite --host 0.0.0.0 --port 3002 --strictPort --open=false",
		"typecheck": "VITE_CACHE_DIR=.vite-cache tsc --noEmit",
		"build": "VITE_CACHE_DIR=.vite-cache vite build",
		"preview": "vite preview --host 0.0.0.0 --port 3002 --strictPort"
	},
	"dependencies": {
		"@ungap/structured-clone": "^1.3.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.0.2"
	},
	"devDependencies": {
		"@types/react": "^19.0.12",
		"@types/react-dom": "^19.0.4",
		"@vitejs/plugin-react": "^4.3.3",
		"typescript": "^5.6.3",
		"vite": "^6.2.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.8.0",
	"browserslist": {
		"production": [
			"Chrome >= 98"
		],
		"development": [
			"last 1 Chrome version"
		]
	}
}
