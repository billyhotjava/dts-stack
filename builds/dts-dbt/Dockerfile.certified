# check=skip=InvalidDefaultArgInFrom
ARG DBT_RUNTIME_CANDIDATE_IMAGE
FROM ${DBT_RUNTIME_CANDIDATE_IMAGE}

ARG DBT_RUNTIME_CANDIDATE_IMAGE
ARG DBT_RUNTIME_CERTIFICATION_PROFILE_ID=H83-CERT-RT01-LINUX-AMD64-EVIDENCE-bcd2fc84b05b9508990538c6642be7ac7b35073ec034e6b1980b22f556345a68
ARG DBT_RUNTIME_EVIDENCE_MANIFEST_SHA256=bcd2fc84b05b9508990538c6642be7ac7b35073ec034e6b1980b22f556345a68
ARG DBT_RUNTIME_CANDIDATE_PLATFORM_MANIFEST_DIGEST=sha256:fe1d15f1b4215e693dadfc1d99be2ae07c7e50e8df144504005feb41cc7686b7
ARG DBT_RUNTIME_CANDIDATE_CONFIGURATION_DIGEST=sha256:da312997c55425d9a63622221245cee61c0e219ce83234587d2122959e1b640f

COPY verify-certified-runtime.sh /usr/local/bin/verify-certified-dbt-runtime

# The candidate verifier must pass before replacing its NOT_CERTIFIED metadata.
RUN set -eu; \
    case "${DBT_RUNTIME_CANDIDATE_IMAGE}" in \
      *@sha256:fe1d15f1b4215e693dadfc1d99be2ae07c7e50e8df144504005feb41cc7686b7) ;; \
      *) printf '%s\n' '{"status":"FAILED","code":"DBT_RUNTIME_CANDIDATE_REF_MISMATCH"}' >&2; exit 65 ;; \
    esac; \
    /usr/local/bin/verify-dbt-runtime --verify-install >/dev/null; \
    [ "${DBT_RUNTIME_CERTIFICATION_PROFILE_ID}" = "H83-CERT-RT01-LINUX-AMD64-EVIDENCE-bcd2fc84b05b9508990538c6642be7ac7b35073ec034e6b1980b22f556345a68" ]; \
    [ "${DBT_RUNTIME_EVIDENCE_MANIFEST_SHA256}" = "bcd2fc84b05b9508990538c6642be7ac7b35073ec034e6b1980b22f556345a68" ]; \
    [ "${DBT_RUNTIME_CANDIDATE_PLATFORM_MANIFEST_DIGEST}" = "sha256:fe1d15f1b4215e693dadfc1d99be2ae07c7e50e8df144504005feb41cc7686b7" ]; \
    [ "${DBT_RUNTIME_CANDIDATE_CONFIGURATION_DIGEST}" = "sha256:da312997c55425d9a63622221245cee61c0e219ce83234587d2122959e1b640f" ]; \
    printf '%s\n' \
      "IMAGE_CERTIFICATION_STATUS=CERTIFIED" \
      "IMAGE_CERTIFICATION_PROFILE_ID=${DBT_RUNTIME_CERTIFICATION_PROFILE_ID}" \
      "IMAGE_EVIDENCE_MANIFEST_SHA256=${DBT_RUNTIME_EVIDENCE_MANIFEST_SHA256}" \
      "IMAGE_CANDIDATE_PLATFORM_MANIFEST_DIGEST=${DBT_RUNTIME_CANDIDATE_PLATFORM_MANIFEST_DIGEST}" \
      "IMAGE_CANDIDATE_CONFIGURATION_DIGEST=${DBT_RUNTIME_CANDIDATE_CONFIGURATION_DIGEST}" \
      "IMAGE_RUNTIME_PLATFORM=linux/amd64" \
      "IMAGE_RUNTIME_ARCH=amd64" \
      "IMAGE_BASE_INDEX_DIGEST=sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93" \
      "IMAGE_BASE_PLATFORM_MANIFEST_DIGEST=sha256:00af38ae2ed311628970782e8a2d7f014d8909dbc63cb97bc0a158187f4db045" \
      "IMAGE_REQUIREMENTS_LOCK_SHA256=01d7c02b6bf4fefdfc188cbf9ef8aed4fb243c227c060103f195c4ca45af5f02" \
      "IMAGE_CANDIDATE_PROFILE_ID=H83-RT01-LINUX-AMD64-DBT11022-PG1100-LOCK-01d7c02b6bf4fefdfc188cbf9ef8aed4fb243c227c060103f195c4ca45af5f02" \
      "IMAGE_DBT_CORE_VERSION=1.10.22" \
      "IMAGE_DBT_POSTGRES_VERSION=1.10.0" \
      > /opt/dts-runtime/runtime-metadata; \
    chmod 0444 /opt/dts-runtime/runtime-metadata; \
    chmod 0555 /usr/local/bin/verify-certified-dbt-runtime; \
    mv /usr/local/bin/verify-certified-dbt-runtime /usr/local/bin/verify-dbt-runtime

ENV DBT_RUNTIME_CERTIFICATION_STATUS=CERTIFIED \
    DBT_RUNTIME_CERTIFICATION_PROFILE_ID=H83-CERT-RT01-LINUX-AMD64-EVIDENCE-bcd2fc84b05b9508990538c6642be7ac7b35073ec034e6b1980b22f556345a68 \
    DBT_RUNTIME_EVIDENCE_MANIFEST_SHA256=bcd2fc84b05b9508990538c6642be7ac7b35073ec034e6b1980b22f556345a68

LABEL com.yuzhi.dts.dbt.runtime.certification-status="CERTIFIED" \
      com.yuzhi.dts.dbt.runtime.certification-profile-id="H83-CERT-RT01-LINUX-AMD64-EVIDENCE-bcd2fc84b05b9508990538c6642be7ac7b35073ec034e6b1980b22f556345a68" \
      com.yuzhi.dts.dbt.runtime.evidence-manifest-sha256="bcd2fc84b05b9508990538c6642be7ac7b35073ec034e6b1980b22f556345a68" \
      com.yuzhi.dts.dbt.runtime.candidate-platform-manifest-digest="sha256:fe1d15f1b4215e693dadfc1d99be2ae07c7e50e8df144504005feb41cc7686b7" \
      com.yuzhi.dts.dbt.runtime.candidate-configuration-digest="sha256:da312997c55425d9a63622221245cee61c0e219ce83234587d2122959e1b640f"

RUN /usr/local/bin/verify-dbt-runtime --verify-install
