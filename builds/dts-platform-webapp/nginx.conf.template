server {
    listen 80;
    server_name _;

    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from fc00::/7;
    set_real_ip_from ::1;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Frontend build output
    root /usr/share/nginx/html;
    index index.html;

    # Keep the SPA shell fresh after container upgrades. The JS/CSS bundles are
    # content-hashed, so those can be cached aggressively below.
    location = /index.html {
        add_header Cache-Control "no-store";
        try_files /index.html =404;
    }

    location = /runtime-config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Screen assets are validated by backend (images 10MB, fonts 20MB);
    # keep the proxy limit above that so Nginx does not return a raw 413 first.
    client_max_body_size 25m;

    # Proxy API to backend (keeps the /api prefix)
    # Use a variable proxy_pass so Nginx re-resolves Docker service DNS after backend containers are recreated.
    location /api/ {
        set $platform_upstream ${UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Explicitly forward Authorization and cookies to backend
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        # Strip internal service header to prevent external spoofing
        proxy_set_header X-DTS-Service "";
        proxy_pass $platform_upstream;
    }

    # Proxy admin APIs (mounted under /admin/api) to dts-admin (/api)
    # Used by PKI challenge/login, realm role listing, org listing fallbacks, etc.
    location /admin/api/ {
        set $admin_upstream ${ADMIN_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;

        rewrite ^/admin/api/(.*)$ /api/$1 break;
        proxy_pass $admin_upstream;
    }

    # Proxy BI analytics APIs to dts-analytics backend service.
    # API path stays /analytics/api/ (backend service name, not a frontend route).
    location /analytics/api/ {
        set $analytics_upstream ${ANALYTICS_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        rewrite ^/analytics/api/(.*)$ /api/$1 break;
        proxy_pass $analytics_upstream;
    }

    # Proxy BI API calls (/bi/api/*) to dts-analytics backend.
    # Must appear before the /bi/ SPA fallback so API requests are proxied,
    # not served as index.html.
    location /bi/api/ {
        set $analytics_upstream ${ANALYTICS_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        rewrite ^/bi/api/(.*)$ /api/$1 break;
        proxy_pass $analytics_upstream;
    }

    # BI pages are embedded in platform-webapp — SPA fallback for /bi/*
    location /bi/ {
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /index.html;
    }
    location = /bi {
        add_header Cache-Control "no-store";
        try_files $uri /index.html;
    }

    # SPA fallback
    location / {
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /index.html;
    }
}
